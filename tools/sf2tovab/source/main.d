/**
 * SoundFont 2 to PlayStation VAB sound bank converter.
 *
 * Builds a VAB (VH + VB, or a single VAB file) with the instruments that a
 * program map (written by mid2seq) asks for, taking samples from a
 * SoundFont. Samples are resampled to fit SPU RAM and encoded to ADPCM.
 *
 * Pitch: the SPU plays samples at 44100 Hz when the pitch register is 0x1000,
 * so a tone sounds at its "center" key at that speed. A sample is resampled
 * to a rate chosen so that its original pitch lands exactly on a whole
 * semitone offset from the root key; this way no fine tune ("shift") field is
 * needed.
 */
module main;

import std.algorithm: max, min, sort, canFind;
import std.array: array;
import std.conv: to;
import std.exception: enforce;
import std.file: read, write;
import std.getopt: getopt, config;
import std.math: ceil, floor, log2, pow, round, abs;
import std.path: baseName, setExtension, stripExtension;
import std.stdio: stderr, writefln, writeln, writef, File;
import std.string: format, split, strip;

import adpcm;
import resample;
import sf2;

struct MapEntry
{
    int program;
    bool drums;
    int bank;          // melodic: bank select, drums: kit
    int gm;            // melodic only
    int[] keys;        // drums: the keys that are needed
    int keyLo = 0;     // melodic: range of keys the song uses
    int keyHi = 127;
}

MapEntry[] readMap(string path)
{
    MapEntry[] entries;
    size_t lineNo;
    foreach (raw; File(path).byLine)
    {
        lineNo++;
        string line = raw.idup;
        foreach (i, c; line)
            if (c == '#') { line = line[0..i]; break; }
        auto parts = line.strip.split;
        if (parts.length == 0)
            continue;
        enforce(parts.length >= 3, format("%s(%d): bad map line", path, lineNo));
        MapEntry e;
        e.program = parts[0].to!int;
        enforce(e.program >= 0 && e.program < 128, format("%s(%d): program out of range", path, lineNo));
        if (parts[1] == "melodic")
        {
            enforce(parts.length == 4 || parts.length == 6,
                format("%s(%d): expected: <program> melodic <bank> <gm program> [<key lo> <key hi>]", path, lineNo));
            e.bank = parts[2].to!int;
            e.gm = parts[3].to!int;
            if (parts.length == 6)
            {
                e.keyLo = max(0, min(127, parts[4].to!int));
                e.keyHi = max(0, min(127, parts[5].to!int));
            }
        }
        else if (parts[1] == "drums")
        {
            e.drums = true;
            e.bank = parts[2].to!int;
            foreach (k; parts[3 .. $])
                e.keys ~= k.to!int;
        }
        else
            throw new Exception(format("%s(%d): unknown program kind '%s'", path, lineNo, parts[1]));
        entries ~= e;
    }
    return entries;
}

struct Options
{
    string soundFont, mapFile, output;
    bool vab, stereo, verbose, list;
    int maxRate = 22050;
    int budget = 400000;
    int velocity = 100;
    int layers = 1;
    double maxSeconds = 6.0;
    int bend = 2;
}

struct Tone
{
    int lo, hi;
    int vag;           // 1-based
    int vol, pan, center;
    int pbMin, pbMax;
    ushort adsr1, adsr2;
}

struct ProgramOut
{
    int number;
    string description;
    Tone[] tones;
    size_t bytes;      // ADPCM bytes of the samples that this program uses
}

struct ToneSpec
{
    Zone z;
    int lo, hi;
    int layer;
}

struct Bank
{
    ubyte[][] vags;    // ADPCM data, index 0 is VAG 1
    ProgramOut[] programs;
    size_t totalBytes; // size of the VB body
}

// Envelope generators --------------------------------------------------------

double tcToSeconds(int tc)
{
    return pow(2.0, tc / 1200.0);
}

/// SPU shift value of an exponential decrease with the given time constant (seconds)
int expShift(double tau, int maxShift)
{
    double samples = max(tau * 44100.0, 1.0);
    int s = cast(int)round(log2(samples) - 1.0);
    return max(0, min(maxShift, s));
}

/// Converts SoundFont volume envelope parameters to SPU ADSR1/ADSR2 register values
void envelopeToAdsr(const Zone z, out ushort adsr1, out ushort adsr2)
{
    // Attack: linear. A linear rise with step +7 takes 32767 / 7 * 2^(shift - 11) samples
    double attack = max(tcToSeconds(z.attackTc), 0.0005);
    int attackShift = cast(int)round(11.0 + log2(attack * 44100.0 * 7.0 / 32767.0));
    attackShift = max(0, min(31, attackShift));

    // SoundFont decay and release times are for a fall of 100 dB, which is an
    // exponential with a time constant of time / ln(10^5)
    enum double ln1e5 = 11.512925464970229;
    int decayShift = expShift(tcToSeconds(z.decayTc) / ln1e5, 15);
    int releaseShift = expShift(tcToSeconds(z.releaseTc) / ln1e5, 31);

    double sustain = pow(10.0, -z.sustainCb / 200.0);   // linear amplitude
    if (z.sustainCb < 200)
    {
        // Sustaining sound: decay to the sustain level and hold it
        int level = cast(int)round(sustain * 16.0) - 1;
        level = max(0, min(15, level));
        adsr1 = cast(ushort)((attackShift << 10) | (decayShift << 4) | level);
        // sustain: linear increase at the slowest rate = hold, release: exponential
        adsr2 = cast(ushort)((0x1F << 8) | (1 << 5) | releaseShift);
    }
    else
    {
        // Decaying sound (piano, plucked, percussion): keep falling at the decay rate
        adsr1 = cast(ushort)((attackShift << 10) | (decayShift << 4) | 0);
        adsr2 = cast(ushort)((1 << 15) | (1 << 14) | (decayShift << 8) | (1 << 5) | releaseShift);
    }
}

struct ConvertedSample
{
    ubyte[] adpcm;
    int center;
    double rate;       // equivalent sample rate after resampling
    double loopError;  // relative length error of the loop, 0 = exact
}

/**
 * Resamples and encodes a zone's sample. The zone's key is used as the root
 * key for single-key zones that do not follow the keyboard.
 */
void zonePitch(const Zone z, int rate, int lo, int hi, out int root, out int tune, ref bool scaleWarned)
{
    root = z.rootKey;
    tune = z.tuneCents;
    if (z.scaleTuning != 100)
    {
        if (lo == hi)
        {
            // the pitch does not follow the keyboard normally: bake the offset into the tuning
            tune += (lo - root) * z.scaleTuning;
            root = lo;
        }
        else if (!scaleWarned)
        {
            scaleWarned = true;
            stderr.writeln("Warning: a zone with a non-standard scale tuning spans several keys, it will follow the keyboard normally");
        }
    }
}

ConvertedSample convertSample(SoundFont sf, const Zone z, int root, int tune, int maxRate, double maxSeconds)
{
    auto sh = sf.shdr[z.sample];
    double sr = sh.rate > 0 ? sh.rate : 44100.0;
    double limit = min(cast(double)maxRate, sr);

    int n = cast(int)ceil(12.0 * log2(44100.0 / limit) - tune / 100.0);
    int center = root + n;
    if (center > 127) { n = 127 - root; center = 127; }
    if (center < 0) { n = -root; center = 0; }
    double rate = 44100.0 * pow(2.0, -n / 12.0 - tune / 1200.0);
    double r = rate / sr;               // output samples per source sample

    const(short)[] x = sf.smpl[z.start..z.end];
    long total = x.length;
    long pre = z.loops ? cast(long)z.loopStart - z.start : total;
    long loopLen = z.loops ? cast(long)z.loopEnd - z.loopStart : 0;

    double get(long i)
    {
        if (i < 0)
            return 0.0;
        if (z.loops)
        {
            if (i >= pre)
                i = pre + (i - pre) % loopLen;
            return x[cast(size_t)i];
        }
        return i < total ? x[cast(size_t)i] : 0.0;
    }

    ConvertedSample cs;
    cs.center = center;
    cs.rate = rate;

    if (!z.loops)
    {
        long count = max(1L, cast(long)round(total * r));
        bool cut;
        long cap = cast(long)(maxSeconds * 44100.0);
        if (count > cap)
        {
            count = cap;
            cut = true;
        }
        int[] y = resampleRange(&get, 0.0, 1.0 / r, cast(size_t)count);
        if (cut)
        {
            // fade out the end so that the cut does not click
            size_t fade = min(y.length / 4, cast(size_t)2205);
            foreach (i; 0..fade)
                y[$ - fade + i] = cast(int)(y[$ - fade + i] * (1.0 - cast(double)(i + 1) / fade));
        }
        y.length = (y.length + blockSamples - 1) / blockSamples * blockSamples;
        cs.adpcm = encodeAdpcm(y, -1);
        return cs;
    }

    // Looped sample: the loop is unrolled several times, if needed, so that its
    // length in the output is a whole number of ADPCM blocks
    double lp = loopLen * r;
    int bestM = 1;
    long bestK = 2;
    double bestRho = 1e9;
    foreach (m; 1..65)
    {
        double lm = m * lp;
        if (lm < 42.0)
            continue;
        if (m > 1 && lm > 8192.0)
            break;
        long k = max(2L, cast(long)round(lm / blockSamples));
        double rho = abs(k * blockSamples - lm) / lm;
        if (rho < bestRho)
        {
            bestRho = rho;
            bestM = m;
            bestK = k;
            if (rho <= 2e-4)
                break;
        }
    }
    if (bestRho > 1e8)  // loop is tiny and m was limited by the loop above
    {
        bestM = cast(int)ceil(42.0 / lp);
        bestK = max(2L, cast(long)round(bestM * lp / blockSamples));
        bestRho = abs(bestK * blockSamples - bestM * lp) / (bestM * lp);
    }
    long loopCount = bestK * blockSamples;
    // A small length error is absorbed by stretching the loop (a tiny detune),
    // otherwise the loop point has a phase jump of less than half a block
    bool stretch = bestRho <= 1e-3;
    double loopStep = stretch ? (cast(double)bestM * loopLen) / loopCount : 1.0 / r;
    cs.loopError = stretch ? 0.0 : bestRho;

    long preCount = pre > 0 ? cast(long)round(pre * r) : 0;
    long lead = (blockSamples - preCount % blockSamples) % blockSamples;
    int[] y = new int[cast(size_t)lead];
    if (preCount > 0)
        y ~= resampleRange(&get, 0.0, 1.0 / r, cast(size_t)preCount);
    int loopBlock = cast(int)(y.length / blockSamples);
    y ~= resampleRange(&get, cast(double)pre, loopStep, cast(size_t)loopCount);
    cs.adpcm = encodeAdpcm(y, loopBlock);
    return cs;
}

int velocityDistance(const Zone z, int v)
{
    if (v >= z.velLo && v <= z.velHi)
        return 0;
    return min(abs(v - z.velLo), abs(v - z.velHi));
}

/// Picks the zones that play for keys lo..hi and splits them into per-key-range tones
ToneSpec[] selectTones(Zone[] zones, int lo, int hi, int velocity, int layers, bool stereo)
{
    Zone[] usable;
    foreach (z; zones)
        if (stereo || !(z.sampleType & 2)) // without stereo, drop the right channel
            usable ~= z;

    bool[][] picked = new bool[][](usable.length, 128);
    foreach (k; lo..hi + 1)
    {
        size_t[] cands;
        foreach (i, z; usable)
            if (z.keyLo <= k && k <= z.keyHi)
                cands ~= i;
        cands.sort!((a, b) {
            int da = velocityDistance(usable[a], velocity), db = velocityDistance(usable[b], velocity);
            return da != db ? da < db : usable[a].order < usable[b].order;
        });
        foreach (i; cands[0 .. min(cands.length, cast(size_t)layers)])
            picked[i][k] = true;
    }

    ToneSpec[] tones;
    foreach (i, z; usable)
    {
        int k = lo;
        while (k <= hi)
        {
            if (!picked[i][k]) { k++; continue; }
            int a = k;
            while (k <= hi && picked[i][k]) k++;
            tones ~= ToneSpec(z, a, k - 1, 0);
        }
    }
    tones.sort!((a, b) => a.lo != b.lo ? a.lo < b.lo : a.z.order < b.z.order);
    return tones;
}

/// A program has at most 16 tones: drop layers, then merge neighbours
ToneSpec[] limitTones(ToneSpec[] tones, int maxTones, ref int merged, ref int dropped)
{
    // assign layers
    int[] layerEnd;
    foreach (ref t; tones)
    {
        int l = 0;
        while (l < cast(int)layerEnd.length && layerEnd[l] >= t.lo)
            l++;
        if (l == cast(int)layerEnd.length)
            layerEnd ~= -1;
        layerEnd[l] = t.hi;
        t.layer = l;
    }
    while (tones.length > maxTones && layerEnd.length > 1)
    {
        int top = cast(int)layerEnd.length - 1;
        ToneSpec[] keep;
        foreach (t; tones)
            if (t.layer != top)
                keep ~= t;
            else
                dropped++;
        tones = keep;
        layerEnd.length = top;
    }
    while (tones.length > maxTones)
    {
        // merge the two neighbours that give the narrowest tone
        int bestI = -1, bestSpan = int.max;
        foreach (i; 0..tones.length - 1)
        {
            int span = tones[i + 1].hi - tones[i].lo;
            if (span < bestSpan) { bestSpan = span; bestI = cast(int)i; }
        }
        if (bestI < 0)
            break;
        auto a = tones[bestI], b = tones[bestI + 1];
        ToneSpec m = (a.hi - a.lo >= b.hi - b.lo) ? a : b;
        m.lo = a.lo;
        m.hi = b.hi;
        tones = tones[0..bestI] ~ [m] ~ tones[bestI + 2..$];
        merged++;
    }
    return tones;
}

Bank buildBank(SoundFont sf, MapEntry[] map, Options opt, int maxRate, double maxSeconds, bool report)
{
    Bank bank;
    int[string] vagCache;
    bool scaleWarned;

    foreach (entry; map)
    {
        ProgramOut po;
        po.number = entry.program;

        int presetIndex;
        string what;
        if (entry.drums)
        {
            presetIndex = sf.findPreset(128, entry.bank);
            if (presetIndex < 0)
                presetIndex = sf.findPreset(128, 0);
            what = format("drum kit %d", entry.bank);
        }
        else
        {
            presetIndex = sf.findPreset(entry.bank, entry.gm);
            if (presetIndex < 0)
                presetIndex = sf.findPreset(0, entry.gm);
            what = format("GM %d%s", entry.gm, entry.bank ? format(" bank %d", entry.bank) : "");
        }
        if (presetIndex < 0)
        {
            if (report)
                stderr.writefln("Warning: the SoundFont has no preset for %s (program %d), the program is left empty", what, entry.program);
            po.description = what ~ " (missing)";
            bank.programs ~= po;
            continue;
        }
        po.description = format("%s -> '%s'", what, sf.presets[presetIndex].name);

        auto zones = sf.resolve(presetIndex);
        ToneSpec[] specs;
        if (entry.drums)
        {
            foreach (k; entry.keys)
            {
                auto t = selectTones(zones, k, k, opt.velocity, 1, opt.stereo);
                if (t.length == 0)
                {
                    if (report)
                        stderr.writefln("Warning: '%s' has no sample for drum key %d", sf.presets[presetIndex].name, k);
                    continue;
                }
                specs ~= t[0];
            }
        }
        else
            specs = selectTones(zones, entry.keyLo, entry.keyHi, opt.velocity, opt.layers, opt.stereo);

        int merged, dropped;
        specs = limitTones(specs, 16, merged, dropped);
        if (report && (merged || dropped))
            stderr.writefln("Note: program %d '%s': %d tones merged, %d layered tones dropped to fit 16 tones",
                entry.program, sf.presets[presetIndex].name, merged, dropped);
        if (specs.length == 0 && report)
            stderr.writefln("Warning: '%s' has no usable samples for the requested keys", sf.presets[presetIndex].name);

        bool[int] used;
        foreach (spec; specs)
        {
            int root, tune;
            zonePitch(spec.z, maxRate, spec.lo, spec.hi, root, tune, scaleWarned);
            // identical samples (same data, loop and pitch conversion) share one VAG
            auto sh = sf.shdr[spec.z.sample];
            int probeN = cast(int)ceil(12.0 * log2(44100.0 / min(cast(double)maxRate, sh.rate > 0 ? sh.rate : 44100.0)) - tune / 100.0);
            string key = format("%d/%d/%d/%d/%d/%d/%d/%d/%d", spec.z.sample, spec.z.start, spec.z.end,
                spec.z.loops ? spec.z.loopStart : 0, spec.z.loops ? spec.z.loopEnd : 0, tune, root, probeN, spec.z.loops);
            ConvertedSample cs;
            int vagIndex;
            if (auto p = key in vagCache)
            {
                vagIndex = *p;
                // the center depends only on the cached parameters, recompute it cheaply
                cs.center = cachedCenter(root, tune, probeN);
            }
            else
            {
                cs = convertSample(sf, spec.z, root, tune, maxRate, maxSeconds);
                bank.vags ~= cs.adpcm;
                vagIndex = cast(int)bank.vags.length;
                vagCache[key] = vagIndex;
                if (report && opt.verbose)
                    writefln("    sample '%s': %d bytes, %.0f Hz%s", sh.name, cs.adpcm.length, cs.rate,
                        spec.z.loops ? (cs.loopError > 0 ? format(", looped (loop jump %.2f%%)", cs.loopError * 100) : ", looped") : "");
                if (report && cs.loopError > 0.02)
                    stderr.writefln("Warning: the loop of sample '%s' cannot be aligned exactly, it may click", sh.name);
            }
            if (vagIndex !in used)
            {
                used[vagIndex] = true;
                po.bytes += bank.vags[vagIndex - 1].length;
            }

            Tone t;
            t.lo = spec.lo;
            t.hi = spec.hi;
            t.vag = vagIndex;
            t.center = cs.center;
            double gain = pow(10.0, -spec.z.attenCb / 200.0);
            t.vol = max(1, min(127, cast(int)round(127.0 * gain)));
            int pan = spec.z.pan;
            if (!opt.stereo && (spec.z.sampleType & 4))
                pan = 0; // the left channel of a stereo pair plays in the center
            t.pan = max(0, min(127, 64 + cast(int)round(pan * 63.0 / 500.0)));
            t.pbMin = opt.bend;
            t.pbMax = opt.bend;
            envelopeToAdsr(spec.z, t.adsr1, t.adsr2);
            po.tones ~= t;
        }
        bank.programs ~= po;
    }

    bank.totalBytes = 16;
    foreach (v; bank.vags)
        bank.totalBytes += v.length;
    return bank;
}

int cachedCenter(int root, int tune, int n)
{
    int c = root + n;
    return max(0, min(127, c));
}

void u16le(ref ubyte[] b, uint v) { b ~= cast(ubyte)v; b ~= cast(ubyte)(v >> 8); }
void u32le(ref ubyte[] b, uint v) { u16le(b, v & 0xFFFF); u16le(b, v >> 16); }

ubyte[] buildVh(Bank bank)
{
    ProgramOut*[128] byNumber;
    foreach (ref p; bank.programs)
        byNumber[p.number] = &p;

    ubyte[] progTab, toneBlocks;
    uint programCount, toneCount;
    foreach (n; 0 .. 128)
    {
        auto p = byNumber[n];
        size_t count = p is null ? 0 : p.tones.length;
        progTab ~= cast(ubyte)count;
        progTab ~= cast(ubyte)127;          // program volume
        progTab ~= [0, 0, 64, 0, 0, 0];     // priority, mode, pan, reserved, attr
        progTab ~= new ubyte[8];
        if (count == 0)
            continue;
        programCount++;
        toneCount += cast(uint)count;
        ubyte[] block;
        foreach (t; p.tones)
        {
            block ~= [0, 0, cast(ubyte)t.vol, cast(ubyte)t.pan, cast(ubyte)t.center, 0, cast(ubyte)t.lo, cast(ubyte)t.hi];
            block ~= [0, 0, 0, 0, cast(ubyte)t.pbMin, cast(ubyte)t.pbMax, 0, 0];
            u16le(block, t.adsr1);
            u16le(block, t.adsr2);
            u16le(block, n);
            u16le(block, t.vag);
            block ~= new ubyte[8];
        }
        block ~= new ubyte[0x200 - block.length];
        toneBlocks ~= block;
    }

    ubyte[] sizes = new ubyte[512];
    sizes[0] = 2;                           // the silent 16-byte block at the start of the body
    foreach (i, v; bank.vags)
    {
        uint s = cast(uint)(v.length / 8);
        sizes[(i + 1) * 2] = cast(ubyte)s;
        sizes[(i + 1) * 2 + 1] = cast(ubyte)(s >> 8);
    }

    ubyte[] h;
    h ~= cast(ubyte[])"pBAV";
    u32le(h, 7);
    u32le(h, 0);
    u32le(h, 0);                            // total size, filled in by the caller
    u16le(h, 0xEEEE);
    u16le(h, programCount);
    u16le(h, toneCount);
    u16le(h, cast(uint)bank.vags.length);
    h ~= [127, 64, 0, 0];
    u32le(h, 0xFFFFFFFF);
    h ~= progTab;
    h ~= toneBlocks;
    h ~= sizes;
    return h;
}

ubyte[] buildVb(Bank bank)
{
    ubyte[] vb = new ubyte[16];
    foreach (v; bank.vags)
        vb ~= v;
    return vb;
}

int main(string[] args)
{
    Options opt;
    bool help;
    try
    {
        getopt(args, config.caseSensitive,
            "output|o", &opt.output,
            "vab", &opt.vab,
            "rate", &opt.maxRate,
            "budget", &opt.budget,
            "velocity", &opt.velocity,
            "layers", &opt.layers,
            "max-seconds", &opt.maxSeconds,
            "bend", &opt.bend,
            "stereo", &opt.stereo,
            "verbose|v", &opt.verbose,
            "list", &opt.list,
            "help|h", &help);
    }
    catch (Exception e)
    {
        stderr.writeln("Error: ", e.msg);
        return 1;
    }

    if (help || (opt.list ? args.length != 2 : args.length != 3))
    {
        writeln("Build a PlayStation VAB sound bank from a SoundFont 2 file.");
        writeln("Usage: sf2tovab [options] soundfont.sf2 song.map");
        writeln("       sf2tovab --list soundfont.sf2");
        writeln("  -o, --output <name>      output base name (default: the map name)");
        writeln("      --vab                write a single .vab file instead of .vh + .vb");
        writeln("      --rate <hz>          highest sample rate to keep (default 22050)");
        writeln("      --budget <bytes>     SPU RAM available for samples (default 400000);");
        writeln("                           the rate and sample length are reduced to fit");
        writeln("      --velocity <1..127>  velocity used to choose velocity layers (default 100)");
        writeln("      --layers <n>         layered samples per key (default 1)");
        writeln("      --max-seconds <s>    trim samples that do not loop to this length (default 6)");
        writeln("      --bend <n>           pitch bend range in semitones (default 2)");
        writeln("      --stereo             keep both channels of stereo samples (default: left only)");
        writeln("  -v, --verbose            print every sample");
        writeln("      --list               list the presets of the SoundFont");
        writeln("  -h, --help               show this help");
        return help ? 0 : 1;
    }
    if (opt.maxRate < 2000 || opt.maxRate > 44100 || opt.layers < 1 || opt.layers > 4
        || opt.velocity < 1 || opt.velocity > 127 || opt.bend < 0 || opt.bend > 127)
    {
        stderr.writeln("Error: an option value is out of range");
        return 1;
    }

    opt.soundFont = args[1];
    try
    {
        auto sf = new SoundFont(cast(const(ubyte)[])read(opt.soundFont));
        if (opt.list)
        {
            foreach (i; 0 .. sf.presets.length - 1)
                writefln("%3d:%-3d  %s", sf.presets[i].bank, sf.presets[i].preset, sf.presets[i].name);
            return 0;
        }
        opt.mapFile = args[2];
        if (opt.output.length == 0)
            opt.output = stripExtension(opt.mapFile);
        return run(sf, opt);
    }
    catch (Exception e)
    {
        stderr.writeln("Error: ", e.msg);
        return 1;
    }
}

int run(SoundFont sf, Options opt)
{
    auto map = readMap(opt.mapFile);
    enforce(map.length > 0, "the program map is empty");

    // Reduce the sample rate and length until everything fits SPU RAM
    Bank bank;
    int rate = opt.maxRate;
    double seconds = opt.maxSeconds;
    bool fitted;
    foreach (step; 0 .. 12)
    {
        bank = buildBank(sf, map, opt, rate, seconds, step == 0);
        if (cast(long)bank.totalBytes <= opt.budget)
        {
            fitted = true;
            break;
        }
        writefln("  %d bytes at %d Hz does not fit %d bytes, reducing", bank.totalBytes, rate, opt.budget);
        rate = cast(int)(rate * 0.8);
        seconds = max(0.5, seconds * 0.8);
        if (rate < 3000)
            break;
    }
    enforce(fitted, format("the samples need %d bytes even at %d Hz, which is more than the %d byte budget; "
        ~ "use fewer instruments, a smaller SoundFont or a larger --budget", bank.totalBytes, rate, opt.budget));
    enforce(bank.vags.length <= 255, format("the bank needs %d samples, the maximum is 255", bank.vags.length));

    auto vh = buildVh(bank);
    auto vb = buildVb(bank);
    uint total = cast(uint)(vh.length + vb.length);
    vh[12] = cast(ubyte)total; vh[13] = cast(ubyte)(total >> 8);
    vh[14] = cast(ubyte)(total >> 16); vh[15] = cast(ubyte)(total >> 24);

    string outName;
    if (opt.vab)
    {
        outName = opt.output ~ ".vab";
        write(outName, vh ~ vb);
    }
    else
    {
        write(opt.output ~ ".vh", vh);
        write(opt.output ~ ".vb", vb);
        outName = opt.output ~ ".vh/.vb";
    }

    size_t tones;
    foreach (p; bank.programs)
        tones += p.tones.length;
    writefln("%s + %s -> %s  (%d programs, %d tones, %d samples, %d bytes of samples, max %d Hz)",
        baseName(opt.soundFont), baseName(opt.mapFile), outName, bank.programs.length, tones,
        bank.vags.length, bank.totalBytes, rate);
    foreach (p; bank.programs)
        writefln("  program %3d: %s, %d tones, %d bytes", p.number, p.description, p.tones.length, p.bytes);
    return 0;
}
