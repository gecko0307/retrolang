/**
 * SoundFont 2 reader.
 *
 * Parses the RIFF structure and resolves a preset to a flat list of zones
 * (instrument zones with generators combined according to the SF2 rules).
 */
module sf2;

import std.exception: enforce;
import std.string: format, fromStringz;
import std.algorithm: max, min;

// Generator numbers
enum: int
{
    genStartAddrsOffset = 0,
    genEndAddrsOffset = 1,
    genStartloopAddrsOffset = 2,
    genEndloopAddrsOffset = 3,
    genStartAddrsCoarseOffset = 4,
    genEndAddrsCoarseOffset = 12,
    genPan = 17,
    genDelayVolEnv = 33,
    genAttackVolEnv = 34,
    genHoldVolEnv = 35,
    genDecayVolEnv = 36,
    genSustainVolEnv = 37,
    genReleaseVolEnv = 38,
    genInstrument = 41,
    genKeyRange = 43,
    genVelRange = 44,
    genStartloopAddrsCoarseOffset = 45,
    genInitialAttenuation = 48,
    genEndloopAddrsCoarseOffset = 50,
    genCoarseTune = 51,
    genFineTune = 52,
    genSampleID = 53,
    genSampleModes = 54,
    genScaleTuning = 56,
    genExclusiveClass = 57,
    genOverridingRootKey = 58,
    genCount = 64
}

struct PresetHdr
{
    string name;
    int preset;
    int bank;
    uint bagIndex;
}

struct GenRec
{
    ushort oper;
    short amount;
    ubyte lo, hi;
}

struct BagRec
{
    uint genIndex;
}

struct InstHdr
{
    string name;
    uint bagIndex;
}

struct SampleHdr
{
    string name;
    uint start, end, startLoop, endLoop, rate;
    int pitch;
    int correction;
    int link;
    int type;
}

/// A sample zone with all generators resolved
struct Zone
{
    int keyLo = 0, keyHi = 127;
    int velLo = 0, velHi = 127;
    int sample;
    int rootKey;
    int tuneCents;        // coarse + fine tune + sample pitch correction
    int attenCb;          // initial attenuation, centibels
    int pan;              // -500 .. 500
    int attackTc, holdTc, decayTc, sustainCb, releaseTc;
    int scaleTuning = 100;
    bool loops;
    uint start, end, loopStart, loopEnd;   // absolute sample indices
    int sampleType;
    int order;
}

private uint u16(const(ubyte)[] d, size_t p) { return d[p] | (d[p + 1] << 8); }
private uint u32(const(ubyte)[] d, size_t p) { return u16(d, p) | (u16(d, p + 2) << 16); }

private string cstr(const(ubyte)[] d, size_t p, size_t maxLen)
{
    string s;
    foreach (i; 0..maxLen)
    {
        if (d[p + i] == 0)
            break;
        s ~= cast(char)d[p + i];
    }
    return s;
}

private struct GenSet
{
    int[genCount] v;
    bool[genCount] has;
    int keyLo = 0, keyHi = 127, velLo = 0, velHi = 127;
    bool hasKey, hasVel;
    int instrument = -1;
    int sampleId = -1;

    void apply(const(GenRec)[] recs)
    {
        foreach (g; recs)
        {
            if (g.oper == genKeyRange) { keyLo = g.lo; keyHi = g.hi; hasKey = true; }
            else if (g.oper == genVelRange) { velLo = g.lo; velHi = g.hi; hasVel = true; }
            else if (g.oper == genInstrument) instrument = cast(ushort)g.amount;
            else if (g.oper == genSampleID) sampleId = cast(ushort)g.amount;
            else if (g.oper < genCount) { v[g.oper] = g.amount; has[g.oper] = true; }
        }
    }
}

class SoundFont
{
    short[] smpl;
    PresetHdr[] presets;     // includes the terminal record
    BagRec[] pbag;
    GenRec[] pgen;
    InstHdr[] insts;         // includes the terminal record
    BagRec[] ibag;
    GenRec[] igen;
    SampleHdr[] shdr;        // includes the terminal record
    int versionMajor;

    this(const(ubyte)[] d)
    {
        enforce(d.length >= 12 && d[0..4] == cast(const(ubyte)[])"RIFF" && d[8..12] == cast(const(ubyte)[])"sfbk",
            "not a SoundFont file (no RIFF sfbk header)");
        size_t pos = 12;
        const(ubyte)[] pdta;
        while (pos + 8 <= d.length)
        {
            string id = cast(string)d[pos..pos + 4].idup;
            uint len = u32(d, pos + 4);
            size_t body = pos + 8;
            enforce(body + len <= d.length + 1, "truncated SoundFont file");
            size_t bodyEnd = min(body + len, d.length);
            if (id == "LIST" && body + 4 <= d.length)
            {
                string type = cast(string)d[body..body + 4].idup;
                if (type == "INFO")
                    parseInfo(d[body + 4..bodyEnd]);
                else if (type == "sdta")
                    parseSdta(d[body + 4..bodyEnd]);
                else if (type == "pdta")
                    pdta = d[body + 4..bodyEnd];
            }
            pos = body + len + (len & 1);
        }
        enforce(versionMajor < 3, "SF3 (compressed) SoundFonts are not supported, convert to SF2 first");
        enforce(smpl.length > 0, "the SoundFont has no sample data (smpl chunk)");
        enforce(pdta.length > 0, "the SoundFont has no preset data (pdta chunk)");
        parsePdta(pdta);
    }

    private void parseInfo(const(ubyte)[] d)
    {
        size_t p = 0;
        while (p + 8 <= d.length)
        {
            string id = cast(string)d[p..p + 4].idup;
            uint len = u32(d, p + 4);
            if (id == "ifil" && len >= 4 && p + 12 <= d.length)
                versionMajor = u16(d, p + 8);
            p += 8 + len + (len & 1);
        }
    }

    private void parseSdta(const(ubyte)[] d)
    {
        size_t p = 0;
        while (p + 8 <= d.length)
        {
            string id = cast(string)d[p..p + 4].idup;
            uint len = u32(d, p + 4);
            if (id == "smpl")
            {
                size_t end = min(p + 8 + len, d.length);
                size_t n = (end - (p + 8)) / 2;
                smpl = new short[n];
                foreach (i; 0..n)
                    smpl[i] = cast(short)u16(d, p + 8 + i * 2);
            }
            p += 8 + len + (len & 1);
        }
    }

    private void parsePdta(const(ubyte)[] d)
    {
        size_t p = 0;
        while (p + 8 <= d.length)
        {
            string id = cast(string)d[p..p + 4].idup;
            uint len = u32(d, p + 4);
            enforce(p + 8 + len <= d.length, "truncated pdta chunk");
            auto c = d[p + 8..p + 8 + len];
            switch (id)
            {
                case "phdr":
                    foreach (i; 0..len / 38)
                    {
                        auto r = c[i * 38..(i + 1) * 38];
                        presets ~= PresetHdr(cstr(r, 0, 20), u16(r, 20), u16(r, 22), u16(r, 24));
                    }
                    break;
                case "pbag":
                    foreach (i; 0..len / 4)
                        pbag ~= BagRec(u16(c, i * 4));
                    break;
                case "pgen":
                    pgen = readGens(c);
                    break;
                case "inst":
                    foreach (i; 0..len / 22)
                    {
                        auto r = c[i * 22..(i + 1) * 22];
                        insts ~= InstHdr(cstr(r, 0, 20), u16(r, 20));
                    }
                    break;
                case "ibag":
                    foreach (i; 0..len / 4)
                        ibag ~= BagRec(u16(c, i * 4));
                    break;
                case "igen":
                    igen = readGens(c);
                    break;
                case "shdr":
                    foreach (i; 0..len / 46)
                    {
                        auto r = c[i * 46..(i + 1) * 46];
                        SampleHdr s;
                        s.name = cstr(r, 0, 20);
                        s.start = u32(r, 20);
                        s.end = u32(r, 24);
                        s.startLoop = u32(r, 28);
                        s.endLoop = u32(r, 32);
                        s.rate = u32(r, 36);
                        s.pitch = r[40];
                        s.correction = cast(byte)r[41];
                        s.link = u16(r, 42);
                        s.type = u16(r, 44);
                        shdr ~= s;
                    }
                    break;
                default:
                    break;
            }
            p += 8 + len + (len & 1);
        }
        enforce(presets.length > 1 && insts.length > 1 && shdr.length > 1, "the SoundFont has no presets");
    }

    private static GenRec[] readGens(const(ubyte)[] c)
    {
        GenRec[] r;
        foreach (i; 0..c.length / 4)
            r ~= GenRec(cast(ushort)u16(c, i * 4), cast(short)u16(c, i * 4 + 2), c[i * 4 + 2], c[i * 4 + 3]);
        return r;
    }

    /// Index of a preset, -1 if there is none
    int findPreset(int bank, int preset)
    {
        foreach (i; 0..presets.length - 1)
            if (presets[i].bank == bank && presets[i].preset == preset)
                return cast(int)i;
        return -1;
    }

    private const(GenRec)[] bagGens(const(BagRec)[] bags, const(GenRec)[] gens, size_t bag)
    {
        size_t a = bags[bag].genIndex;
        size_t b = bags[bag + 1].genIndex;
        enforce(a <= b && b <= gens.length, "corrupt generator list");
        return gens[a..b];
    }

    /// Resolves a preset to its sample zones
    Zone[] resolve(int presetIndex)
    {
        Zone[] zones;
        int order = 0;
        size_t pb0 = presets[presetIndex].bagIndex;
        size_t pb1 = presets[presetIndex + 1].bagIndex;
        enforce(pb1 <= pbag.length - 1, "corrupt preset bag list");

        GenSet pGlobal;
        foreach (pb; pb0..pb1)
        {
            GenSet pz;
            auto pg = bagGens(pbag, pgen, pb);
            bool hasInst;
            foreach (g; pg)
                if (g.oper == genInstrument)
                    hasInst = true;
            if (!hasInst)
            {
                if (pb == pb0)
                    pGlobal.apply(pg); // global preset zone
                continue;
            }
            pz = pGlobal;
            pz.instrument = -1;
            pz.apply(pg);
            enforce(pz.instrument >= 0 && pz.instrument < cast(int)insts.length - 1, "bad instrument index");

            size_t ib0 = insts[pz.instrument].bagIndex;
            size_t ib1 = insts[pz.instrument + 1].bagIndex;
            enforce(ib1 <= ibag.length - 1, "corrupt instrument bag list");
            GenSet iGlobal;
            foreach (ib; ib0..ib1)
            {
                auto ig = bagGens(ibag, igen, ib);
                bool hasSample;
                foreach (g; ig)
                    if (g.oper == genSampleID)
                        hasSample = true;
                if (!hasSample)
                {
                    if (ib == ib0)
                        iGlobal.apply(ig);
                    continue;
                }
                GenSet iz = iGlobal;
                iz.sampleId = -1;
                iz.apply(ig);
                if (iz.sampleId < 0 || iz.sampleId >= cast(int)shdr.length - 1)
                    continue;

                Zone z;
                z.order = order++;
                // key and velocity ranges: intersection of the instrument and preset ranges
                z.keyLo = max(iz.keyLo, pz.keyLo);
                z.keyHi = min(iz.keyHi, pz.keyHi);
                z.velLo = max(iz.velLo, pz.velLo);
                z.velHi = min(iz.velHi, pz.velHi);
                if (z.keyLo > z.keyHi || z.velLo > z.velHi)
                    continue;

                auto sh = shdr[iz.sampleId];
                if (sh.type & 0x8000)
                    continue; // ROM sample
                enforce(!(sh.type & 0x10), "compressed samples are not supported (SF3)");

                // Value of a generator: default, replaced by the instrument, offset by the preset
                int val(int g, int def, bool additive = true)
                {
                    int x = iz.has[g] ? iz.v[g] : def;
                    if (additive && pz.has[g])
                        x += pz.v[g];
                    return x;
                }

                z.sample = iz.sampleId;
                z.sampleType = sh.type;
                z.rootKey = (iz.has[genOverridingRootKey] && iz.v[genOverridingRootKey] >= 0 && iz.v[genOverridingRootKey] <= 127)
                    ? iz.v[genOverridingRootKey]
                    : (sh.pitch <= 127 ? sh.pitch : 60);
                z.tuneCents = val(genCoarseTune, 0) * 100 + val(genFineTune, 0) + sh.correction;
                z.attenCb = max(0, val(genInitialAttenuation, 0));
                z.pan = max(-500, min(500, val(genPan, 0)));
                z.attackTc = val(genAttackVolEnv, -12000);
                z.holdTc = val(genHoldVolEnv, -12000);
                z.decayTc = val(genDecayVolEnv, -12000);
                z.sustainCb = max(0, val(genSustainVolEnv, 0));
                z.releaseTc = val(genReleaseVolEnv, -12000);
                z.scaleTuning = val(genScaleTuning, 100);

                int modes = iz.has[genSampleModes] ? (iz.v[genSampleModes] & 3) : 0;
                z.start = sh.start + iz.v[genStartAddrsOffset] + 32768 * iz.v[genStartAddrsCoarseOffset];
                z.end = sh.end + iz.v[genEndAddrsOffset] + 32768 * iz.v[genEndAddrsCoarseOffset];
                z.loopStart = sh.startLoop + iz.v[genStartloopAddrsOffset] + 32768 * iz.v[genStartloopAddrsCoarseOffset];
                z.loopEnd = sh.endLoop + iz.v[genEndloopAddrsOffset] + 32768 * iz.v[genEndloopAddrsCoarseOffset];
                if (z.end > smpl.length) z.end = cast(uint)smpl.length;
                if (z.start >= z.end)
                    continue;
                z.loops = (modes == 1 || modes == 3)
                    && z.loopEnd > z.loopStart + 8 && z.loopStart >= z.start && z.loopEnd <= z.end;
                zones ~= z;
            }
        }
        return zones;
    }
}
