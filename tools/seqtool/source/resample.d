/**
 * Band-limited sample rate conversion (windowed sinc).
 */
module resample;

import std.math: sin, cos, PI, ceil, floor;
import std.algorithm: min;

double sinc(double x)
{
    if (x > -1e-9 && x < 1e-9)
        return 1.0;
    double px = PI * x;
    return sin(px) / px;
}

/**
 * Computes count output samples. Output sample j is the signal at source
 * position pos0 + j * step, where step is the number of source samples per
 * output sample. The signal is given by get(i), which must handle any index.
 * When step > 1 the signal is low-passed first to avoid aliasing.
 */
int[] resampleRange(scope double delegate(long) get, double pos0, double step, size_t count)
{
    enum zeroCrossings = 12;
    double fc = step > 1.0 ? 1.0 / step : 1.0;   // cutoff relative to the source Nyquist
    long half = cast(long)ceil(zeroCrossings / fc);

    int[] result = new int[count];
    foreach (j; 0..count)
    {
        double pos = pos0 + j * step;
        long center = cast(long)floor(pos);
        double sum = 0.0;
        double weights = 0.0;
        foreach (long i; center - half + 1 .. center + half + 1)
        {
            double t = pos - i;
            double w = 0.42 + 0.5 * cos(PI * t / half) + 0.08 * cos(2.0 * PI * t / half); // Blackman
            double h = fc * sinc(fc * t) * w;
            sum += h * get(i);
            weights += h;
        }
        double v = weights != 0.0 ? sum / weights : 0.0;
        long r = cast(long)(v < 0 ? v - 0.5 : v + 0.5);
        result[j] = cast(int)(r < -32768 ? -32768 : r > 32767 ? 32767 : r);
    }
    return result;
}
