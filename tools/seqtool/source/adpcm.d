module adpcm;

import std.algorithm: max;

enum int blockSamples = 28;
immutable int[2][5] filters = [[0, 0], [60, 0], [115, -52], [98, -55], [122, -60]];

int clamp16(int value)
{
    return value < -32768 ? -32768 : value > 32767 ? 32767 : value;
}

int floorDiv(int value, int divisor)
{
    int q = value / divisor;
    if ((value % divisor != 0) && ((value < 0) != (divisor < 0)))
        --q;
    return q;
}

struct EncodedBlock
{
    int shift;
    int filter;
    ubyte[blockSamples] nibbles;
    int h1;
    int h2;
    long error;
}

EncodedBlock encodeBlock(const(int)[] block, int initialH1, int initialH2)
{
    bool haveBest;
    EncodedBlock best;
    foreach (size_t filterIndex, filter; filters)
    {
        int p1 = initialH1;
        int p2 = initialH2;
        int maximum = 0;
        foreach (sample; block)
        {
            int difference = sample - ((p1 * filter[0] + p2 * filter[1] + 32) >> 6);
            int magnitude = difference < 0 ? -difference : difference;
            maximum = max(maximum, magnitude);
            p2 = p1;
            p1 = sample;
        }

        int shift = 12;
        while (shift > 0 && maximum > 7 * (1 << (12 - shift)))
            --shift;

        int[2] shifts = [shift, shift > 0 ? shift - 1 : shift];
        size_t shiftCount = shift > 0 ? 2 : 1;
        foreach (candidateShift; shifts[0 .. shiftCount])
        {
            int step = 1 << (12 - candidateShift);
            int half = step >> 1;
            p1 = initialH1;
            p2 = initialH2;
            long error;
            EncodedBlock candidate;
            candidate.shift = candidateShift;
            candidate.filter = cast(int)filterIndex;

            foreach (size_t i, sample; block)
            {
                int prediction = (p1 * filter[0] + p2 * filter[1] + 32) >> 6;
                int nibble = floorDiv(sample - prediction + half, step);
                nibble = nibble < -8 ? -8 : nibble > 7 ? 7 : nibble;
                int reconstructed = clamp16(nibble * step + prediction);
                long residual = sample - reconstructed;
                error += residual * residual;
                candidate.nibbles[i] = cast(ubyte)(nibble & 0xF);
                p2 = p1;
                p1 = reconstructed;
            }
            candidate.h1 = p1;
            candidate.h2 = p2;
            candidate.error = error;
            if (!haveBest || error < best.error)
            {
                best = candidate;
                haveBest = true;
            }
        }
    }
    return best;
}

/**
 * Encodes samples to SPU-ADPCM blocks. The length must be a multiple of 28.
 * loopBlock is the index of the block where the loop starts, or -1 for a
 * sample that plays once.
 */
ubyte[] encodeAdpcm(const(int)[] samples, int loopBlock)
{
    assert(samples.length % blockSamples == 0 && samples.length > 0);
    size_t blockCount = samples.length / blockSamples;
    bool looping = loopBlock >= 0;

    ubyte[] output;
    output.reserve(blockCount * 16);
    int h1, h2;
    foreach (size_t blockIndex; 0 .. blockCount)
    {
        auto block = samples[blockIndex * blockSamples .. (blockIndex + 1) * blockSamples];
        auto encoded = encodeBlock(block, h1, h2);
        h1 = encoded.h1;
        h2 = encoded.h2;
        ubyte flag;
        if (!looping)
        {
            if (blockIndex == blockCount - 1)
                flag = 1;
        }
        else
        {
            if (blockIndex == cast(size_t)loopBlock)
                flag = 6;
            if (blockIndex == blockCount - 1)
                flag = 3;
        }
        output ~= cast(ubyte)(encoded.shift | (encoded.filter << 4));
        output ~= flag;
        foreach (i; 0 .. blockSamples / 2)
            output ~= cast(ubyte)(encoded.nibbles[i * 2] | (encoded.nibbles[i * 2 + 1] << 4));
    }
    return output;
}
