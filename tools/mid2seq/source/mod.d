module mod;

import std.algorithm : max, min, sort;
import std.exception : enforce;
import std.file : write;
import std.math : abs, ceil, log2, round, sin;
import std.path : stripExtension;
import std.stdio : stderr, writefln;
import std.string : format;
import binary : be16, vlq;
import options : Options, defaultPpqn;

/** Converts a supported ProTracker module to a SEQ and matching VAB. */
struct ModSample
{
    string name;
    uint length, loopStart, loopLength;
    int finetune, volume;
    ubyte[] pcm;
}

struct ModFile
{
    string title;
    ModSample[31] samples;
    ubyte[] orders;
    ubyte[] patterns;
    uint patternCount;
}

struct ModEvent
{
    ulong tick;
    uint index;
    int priority;
    ubyte[] bytes;
    bool meta;
}

immutable int[] modPeriods =
[
    856, 808, 762, 720, 678, 640, 604, 570, 538, 508, 480, 453,
    428, 404, 381, 360, 339, 320, 302, 285, 269, 254, 240, 226,
    214, 202, 190, 180, 170, 160, 151, 143, 135, 127, 120, 113
];

bool isModFile(const(ubyte)[] d)
{
    if (d.length < 1084)
        return false;
    auto signature = d[1080 .. 1084];
    return signature == cast(const(ubyte)[])"M.K."
        || signature == cast(const(ubyte)[])"M!K!"
        || signature == cast(const(ubyte)[])"FLT4"
        || signature == cast(const(ubyte)[])"4CHN";
}

string modText(const(ubyte)[] data)
{
    size_t end = data.length;
    while (end && (data[end - 1] == 0 || data[end - 1] == ' '))
        end--;
    return cast(string)data[0 .. end].dup;
}

ModFile parseMod(const(ubyte)[] d)
{
    enforce(isModFile(d), "not a supported 4-channel ProTracker MOD file");
    ModFile mod;
    mod.title = modText(d[0 .. 20]);

    foreach (i; 0 .. 31)
    {
        size_t p = 20 + i * 30;
        auto s = &mod.samples[i];
        s.name = modText(d[p .. p + 22]);
        s.length = be16(d, p + 22) * 2;
        ubyte tune = d[p + 24] & 0x0F;
        s.finetune = tune < 8 ? tune : cast(int)tune - 16;
        s.volume = min(64, cast(int)d[p + 25]);
        s.loopStart = be16(d, p + 26) * 2;
        s.loopLength = be16(d, p + 28) * 2;
    }

    uint songLength = d[950];
    enforce(songLength > 0 && songLength <= 128, "bad MOD song length");
    uint maxPattern;
    foreach (order; d[952 .. 952 + songLength])
    {
        mod.orders ~= order;
        maxPattern = max(maxPattern, cast(uint)order);
    }
    mod.patternCount = maxPattern + 1;
    size_t patternBytes = cast(size_t)mod.patternCount * 64 * 4 * 4;
    size_t samplePos = 1084 + patternBytes;
    enforce(samplePos <= d.length, "MOD pattern data is truncated");
    mod.patterns = d[1084 .. samplePos].dup;

    foreach (ref s; mod.samples)
    {
        enforce(samplePos + s.length <= d.length, "MOD sample data is truncated");
        s.pcm = d[samplePos .. samplePos + s.length].dup;
        samplePos += s.length;
        if (s.loopStart + s.loopLength > s.length || s.loopLength <= 4)
        {
            s.loopStart = 0;
            s.loopLength = 0;
        }
    }
    return mod;
}

void u16le(ref ubyte[] b, uint v)
{
    b ~= cast(ubyte)v;
    b ~= cast(ubyte)(v >> 8);
}

void u32le(ref ubyte[] b, uint v)
{
    u16le(b, v);
    u16le(b, v >> 16);
}

immutable int[2][5] modAdpcmFilters = [[0, 0], [60, 0], [115, -52], [98, -55], [122, -60]];

int modFloorDiv(int value, int divisor)
{
    int q = value / divisor;
    if ((value % divisor != 0) && ((value < 0) != (divisor < 0)))
        --q;
    return q;
}

int modClamp16(int value)
{
    return value < -32768 ? -32768 : value > 32767 ? 32767 : value;
}

struct ModAdpcmBlock
{
    int shift, filter, h1, h2;
    ubyte[28] nibbles;
    long error;
}

ModAdpcmBlock encodeModBlock(const(int)[] block, int initialH1, int initialH2)
{
    bool haveBest;
    ModAdpcmBlock best;
    foreach (size_t filterIndex, filter; modAdpcmFilters)
    {
        int p1 = initialH1, p2 = initialH2, maximum;
        foreach (sample; block)
        {
            int difference = sample - ((p1 * filter[0] + p2 * filter[1] + 32) >> 6);
            maximum = max(maximum, difference < 0 ? -difference : difference);
            p2 = p1;
            p1 = sample;
        }

        int shift = 12;
        while (shift > 0 && maximum > 7 * (1 << (12 - shift)))
            shift--;
        int[2] shifts = [shift, shift > 0 ? shift - 1 : shift];
        foreach (candidateShift; shifts[0 .. shift > 0 ? 2 : 1])
        {
            int step = 1 << (12 - candidateShift);
            p1 = initialH1;
            p2 = initialH2;
            ModAdpcmBlock candidate;
            candidate.shift = candidateShift;
            candidate.filter = cast(int)filterIndex;
            foreach (size_t i, sample; block)
            {
                int prediction = (p1 * filter[0] + p2 * filter[1] + 32) >> 6;
                int nibble = modFloorDiv(sample - prediction + (step >> 1), step);
                nibble = max(-8, min(7, nibble));
                int reconstructed = modClamp16(nibble * step + prediction);
                long residual = sample - reconstructed;
                candidate.error += residual * residual;
                candidate.nibbles[i] = cast(ubyte)(nibble & 0x0F);
                p2 = p1;
                p1 = reconstructed;
            }
            candidate.h1 = p1;
            candidate.h2 = p2;
            if (!haveBest || candidate.error < best.error)
            {
                best = candidate;
                haveBest = true;
            }
        }
    }
    return best;
}

ubyte[] encodeModSample(const(ubyte)[] pcm, uint loopStart, bool looping)
{
    int[] samples;
    foreach (b; pcm)
        samples ~= cast(int)cast(byte)b * 256;
    if (samples.length == 0)
        samples ~= 0;

    int loopBlock = -1;
    if (looping && loopStart < samples.length)
    {
        size_t lead = (28 - loopStart % 28) % 28;
        samples = new int[lead] ~ samples;
        loopBlock = cast(int)((lead + loopStart) / 28);
    }
    while (samples.length % 28)
        samples ~= 0;

    ubyte[] output;
    int h1, h2;
    size_t blockCount = samples.length / 28;
    foreach (blockIndex; 0 .. blockCount)
    {
        auto encoded = encodeModBlock(samples[blockIndex * 28 .. (blockIndex + 1) * 28], h1, h2);
        h1 = encoded.h1;
        h2 = encoded.h2;
        ubyte flags;
        if (loopBlock >= 0)
        {
            if (blockIndex == loopBlock)
                flags = 6;
            if (blockIndex == blockCount - 1)
                flags = 3;
        }
        else if (blockIndex == blockCount - 1)
            flags = 1;
        output ~= cast(ubyte)(encoded.shift | (encoded.filter << 4));
        output ~= flags;
        foreach (i; 0 .. 14)
            output ~= cast(ubyte)(encoded.nibbles[i * 2] | (encoded.nibbles[i * 2 + 1] << 4));
    }
    return output;
}

ubyte[] buildModVh(ModFile mod, ubyte[][] vags, int[] vagForSample)
{
    ubyte[] programs, toneBlocks, sizes = new ubyte[512];
    uint programCount, toneCount;
    sizes[0] = 2;
    foreach (i, vag; vags)
    {
        uint size = cast(uint)(vag.length / 8);
        sizes[(i + 1) * 2] = cast(ubyte)size;
        sizes[(i + 1) * 2 + 1] = cast(ubyte)(size >> 8);
    }

    foreach (i; 0 .. 128)
    {
        int sampleNo = i < 31 ? cast(int)i : -1;
        bool haveTone = sampleNo >= 0 && vagForSample[sampleNo] >= 0;
        programs ~= cast(ubyte)(haveTone ? 1 : 0);
        programs ~= cast(ubyte)127;
        programs ~= [0, 0, 64, 0, 0, 0];
        programs ~= new ubyte[8];
        if (!haveTone)
            continue;
        programCount++;
        toneCount++;

        auto sample = mod.samples[sampleNo];
        double root = 48.0 + 12.0 * log2(44100.0 * 428.0 * 2.0 / 7093789.2) - sample.finetune / 8.0;
        int center = max(0, min(127, cast(int)ceil(root)));
        int fineTune = max(0, min(128, cast(int)round((center - root) * 128.0)));
        ubyte[] tone;
        tone ~= [0, 0, 127, 64, cast(ubyte)center, cast(ubyte)fineTune, 0, 127];
        tone ~= [0, 0, 0, 0, 15, 15, 0, 0];
        u16le(tone, 0x00FF);
        u16le(tone, 0x0028);
        u16le(tone, i);
        u16le(tone, cast(uint)(vagForSample[sampleNo] + 1));
        tone ~= new ubyte[8];
        toneBlocks ~= tone;
        toneBlocks ~= new ubyte[0x200 - tone.length];
    }

    ubyte[] header;
    header ~= cast(ubyte[])"pBAV";
    u32le(header, 7);
    u32le(header, 0);
    u32le(header, 0);
    u16le(header, 0xEEEE);
    u16le(header, programCount);
    u16le(header, toneCount);
    u16le(header, cast(uint)vags.length);
    header ~= [127, 64, 0, 0];
    u32le(header, 0xFFFFFFFF);
    header ~= programs;
    header ~= toneBlocks;
    header ~= sizes;
    return header;
}

int modNote(ushort period)
{
    if (period == 0)
        return -1;
    int best = 0;
    int error = int.max;
    foreach (i, candidate; modPeriods)
    {
        int difference = abs(cast(int)period - candidate);
        if (difference < error)
        {
            best = cast(int)i;
            error = difference;
        }
    }
    return 36 + best;
}

int modPeriodBend(int basePeriod, int period)
{
    if (basePeriod <= 0 || period <= 0)
        return 8192;
    double semitones = 12.0 * log2(cast(double)basePeriod / period);
    return max(0, min(16383, cast(int)round(8192.0 + semitones * 8192.0 / 15.0)));
}

int convertMod(Options opt, const(ubyte)[] data)
{
    auto mod = parseMod(data);
    uint ppqn = opt.ppqn ? opt.ppqn : defaultPpqn;
    enforce(ppqn > 0 && ppqn < 0x8000, "the resolution must be 1..32767");

    ubyte[][] vags;
    int[31] vagForSample;
    vagForSample[] = -1;
    foreach (i, ref sample; mod.samples)
    {
        if (sample.pcm.length == 0)
            continue;
        uint length = sample.loopLength ? sample.loopStart + sample.loopLength : sample.length;
        length = min(length, cast(uint)sample.pcm.length);
        auto vag = encodeModSample(sample.pcm[0 .. length], sample.loopStart, sample.loopLength != 0);
        vagForSample[i] = cast(int)vags.length;
        vags ~= vag;
    }

    ModEvent[] events;
    uint eventIndex;
    void emit(ulong tick, ubyte[] bytes, bool meta = false, int priority = 0)
    {
        events ~= ModEvent(tick, eventIndex++, priority, bytes, meta);
    }
    void emitTempo(ulong tick, int bpm)
    {
        uint us = cast(uint)(60000000 / bpm);
        emit(tick, [cast(ubyte)0xFF, 0x51, cast(ubyte)(us >> 16), cast(ubyte)(us >> 8), cast(ubyte)us], true);
    }

    int[4] activeNote = [-1, -1, -1, -1];
    int[4] currentSample;
    int[4] channelVolume = [64, 64, 64, 64];
    int[4] baseNote = [-1, -1, -1, -1];
    int[4] basePeriod;
    int[4] currentPeriod;
    int[4] targetPeriod;
    int[4] tonePortaSpeed;
    int[4] pitchSlideMemory;
    int[4] vibratoSpeed, vibratoDepth, vibratoPhase;
    int[4] retriggerMemory;
    bool[4] previousArpeggio;
    bool[4] previousVibrato;
    int[4] volumeSlideMemory;
    int[string] unsupportedEffects;
    foreach (ch; 0 .. 4)
    {
        emit(0, [cast(ubyte)(0xB0 | ch), 10, cast(ubyte)(ch == 0 || ch == 3 ? 0 : 127)]);
        emit(0, [cast(ubyte)(0xB0 | ch), 7, 127]);
    }
    int bpm = 125;
    int speed = 6;
    emitTempo(0, bpm);

    ulong tick;
    uint order, row;
    bool[int] seenPosition;
    ulong[int] firstTick;
    uint[4] patternLoopStart;
    int[4] patternLoopCount;
    bool hasLoop;
    ulong loopStartTick, loopEndTick;
    uint rowCount;
    while (order < mod.orders.length)
    {
        enforce(++rowCount <= 1000000, "MOD pattern flow exceeds one million rows");
        int positionKey = cast(int)(order * 64 + row);
        if (positionKey in seenPosition)
        {
            hasLoop = true;
            loopStartTick = firstTick[positionKey];
            loopEndTick = tick;
            break;
        }
        seenPosition[positionKey] = true;
        firstTick[positionKey] = tick;

        foreach (ch; 0 .. 4)
        {
            if (previousArpeggio[ch])
                emit(tick, [cast(ubyte)(0xE0 | ch), 0, 64], false, -1);
            previousArpeggio[ch] = false;
            if (previousVibrato[ch] && baseNote[ch] >= 0)
            {
                int bend = modPeriodBend(basePeriod[ch], currentPeriod[ch]);
                emit(tick, [cast(ubyte)(0xE0 | ch), cast(ubyte)(bend & 0x7F),
                    cast(ubyte)(bend >> 7)], false, -1);
            }
            previousVibrato[ch] = false;
        }
        int[4] arpX = [-1, -1, -1, -1];
        int[4] arpY = [-1, -1, -1, -1];
        int[4] volumeSlideUp, volumeSlideDown;
        int[4] pendingNote = [-1, -1, -1, -1];
        int[4] pendingSample = [-1, -1, -1, -1];
        int[4] pendingPeriod;
        int[4] pendingNoteTick = [-1, -1, -1, -1];
        int[4] noteDelay = [-1, -1, -1, -1];
        int[4] noteCut = [-1, -1, -1, -1];
        int[4] vibratoThisRow;
        int[4] pitchSlideDirection;
        bool[4] tonePortamento;
        bool[4] retrigger;
        int patternLoopRow = -1;
        uint rowDelay;
        uint pattern = mod.orders[order];
        int jumpOrder = -1;
        int breakRow = -1;
        size_t rowOffset = (cast(size_t)pattern * 64 + row) * 16;
        foreach (ch; 0 .. 4)
        {
            size_t p = rowOffset + ch * 4;
            ubyte b0 = mod.patterns[p], b1 = mod.patterns[p + 1];
            ubyte b2 = mod.patterns[p + 2], param = mod.patterns[p + 3];
            ushort period = cast(ushort)(((b0 & 0x0F) << 8) | b1);
            int instrument = (b0 & 0xF0) | (b2 >> 4);
            int effect = b2 & 0x0F;
            if (instrument)
            {
                currentSample[ch] = instrument;
                channelVolume[ch] = mod.samples[instrument - 1].volume;
                emit(tick, [cast(ubyte)(0xB0 | ch), 7,
                    cast(ubyte)(channelVolume[ch] * 127 / 64)]);
            }

            if (period)
            {
                pendingNote[ch] = modNote(period);
                pendingSample[ch] = currentSample[ch] - 1;
                pendingPeriod[ch] = period;
            }

            switch (effect)
            {
                case 0x0:
                    if (param)
                    {
                        arpX[ch] = param >> 4;
                        arpY[ch] = param & 0x0F;
                    }
                    break;
                case 0x1:
                case 0x2:
                    if (param)
                        pitchSlideMemory[ch] = param;
                    pitchSlideDirection[ch] = effect == 1 ? -1 : 1;
                    break;
                case 0x3:
                    if (param)
                        tonePortaSpeed[ch] = param;
                    tonePortamento[ch] = true;
                    break;
                case 0x4:
                    if (param >> 4)
                        vibratoSpeed[ch] = param >> 4;
                    if (param & 0x0F)
                        vibratoDepth[ch] = param & 0x0F;
                    vibratoThisRow[ch] = 1;
                    break;
                case 0x7:
                    unsupportedEffects["tremolo (7xy)"]++;
                    break;
                case 0x9:
                    unsupportedEffects["sample offset (9xy)"]++;
                    break;
                case 0x8:
                    emit(tick, [cast(ubyte)(0xB0 | ch), 10, cast(ubyte)(param >> 1)]);
                    break;
                case 0xB:
                    jumpOrder = param;
                    break;
                case 0xC:
                    channelVolume[ch] = min(64, cast(int)param);
                    emit(tick, [cast(ubyte)(0xB0 | ch), 7, cast(ubyte)(channelVolume[ch] * 127 / 64)]);
                    break;
                case 0x5:
                    if (param)
                        volumeSlideMemory[ch] = param;
                    volumeSlideUp[ch] = volumeSlideMemory[ch] >> 4;
                    volumeSlideDown[ch] = volumeSlideMemory[ch] & 0x0F;
                    tonePortamento[ch] = true;
                    break;
                case 0x6:
                    if (param)
                        volumeSlideMemory[ch] = param;
                    volumeSlideUp[ch] = volumeSlideMemory[ch] >> 4;
                    volumeSlideDown[ch] = volumeSlideMemory[ch] & 0x0F;
                    vibratoThisRow[ch] = 1;
                    break;
                case 0xA:
                    if (param)
                        volumeSlideMemory[ch] = param;
                    volumeSlideUp[ch] = volumeSlideMemory[ch] >> 4;
                    volumeSlideDown[ch] = volumeSlideMemory[ch] & 0x0F;
                    break;
                case 0xD:
                    breakRow = (param >> 4) * 10 + (param & 0x0F);
                    break;
                case 0xF:
                    if (param > 0 && param <= 32)
                        speed = param;
                    else if (param > 32)
                    {
                        bpm = param;
                        emitTempo(tick, bpm);
                    }
                    break;
                case 0xE:
                    switch (param >> 4)
                    {
                        case 0x1:
                        case 0x2:
                            if (pendingNote[ch] < 0 && currentPeriod[ch] > 0)
                            {
                                int amount = param & 0x0F;
                                currentPeriod[ch] += (param >> 4) == 1 ? -amount : amount;
                                currentPeriod[ch] = max(1, currentPeriod[ch]);
                                emit(tick, [cast(ubyte)(0xE0 | ch),
                                    cast(ubyte)(modPeriodBend(basePeriod[ch], currentPeriod[ch]) & 0x7F),
                                    cast(ubyte)(modPeriodBend(basePeriod[ch], currentPeriod[ch]) >> 7)]);
                            }
                            break;
                        case 0x6:
                            if ((param & 0x0F) == 0)
                                patternLoopStart[ch] = row;
                            else
                            {
                                if (patternLoopCount[ch] == 0)
                                    patternLoopCount[ch] = param & 0x0F;
                                else
                                    patternLoopCount[ch]--;
                                if (patternLoopCount[ch] > 0)
                                    patternLoopRow = patternLoopRow < 0
                                        ? cast(int)patternLoopStart[ch]
                                        : min(patternLoopRow, cast(int)patternLoopStart[ch]);
                            }
                            break;
                        case 0x8:
                            emit(tick, [cast(ubyte)(0xB0 | ch), 10, cast(ubyte)(min(15, cast(int)param & 0x0F) * 127 / 15)]);
                            break;
                        case 0x9:
                            if (param & 0x0F)
                                retriggerMemory[ch] = param & 0x0F;
                            retrigger[ch] = true;
                            break;
                        case 0xA:
                            volumeSlideDown[ch] = param & 0x0F;
                            break;
                        case 0xB:
                            volumeSlideUp[ch] = param & 0x0F;
                            break;
                        case 0xC:
                            noteCut[ch] = param & 0x0F;
                            break;
                        case 0xD:
                            noteDelay[ch] = param & 0x0F;
                            break;
                        case 0xE:
                            rowDelay = max(rowDelay, cast(uint)param & 0x0F);
                            break;
                        case 0x0:
                        case 0x3:
                        case 0x4:
                        case 0x5:
                        case 0x7:
                        case 0xF:
                            unsupportedEffects[format("extended effect E%Xx", param >> 4)]++;
                            break;
                        default:
                            unsupportedEffects[format("extended effect E%Xx", param >> 4)]++;
                            break;
                    }
                    break;
                default:
                    if (effect != 0)
                        unsupportedEffects[format("effect %Xxy", effect)]++;
                    break;
            }

            if (tonePortamento[ch] && pendingNote[ch] >= 0 && activeNote[ch] >= 0)
            {
                targetPeriod[ch] = period;
                pendingNote[ch] = -1;
                pendingSample[ch] = -1;
            }
            if (noteDelay[ch] > 0)
                pendingNoteTick[ch] = noteDelay[ch];
            else if (pendingNote[ch] >= 0)
                pendingNoteTick[ch] = 0;
        }

        uint rowTicks = max(1u, (ppqn * speed + 12) / 24);
        foreach (subTick; 0 .. speed)
        {
            ulong eventTick = tick + min(rowTicks - 1, (ppqn * subTick + 12) / 24);
            foreach (ch; 0 .. 4)
            {
                if (pendingNote[ch] >= 0 && pendingNoteTick[ch] == subTick)
                {
                    if (activeNote[ch] >= 0)
                        emit(eventTick, [cast(ubyte)(0x90 | ch), cast(ubyte)activeNote[ch], 0], false, -1);
                    int sampleNo = pendingSample[ch];
                    if (sampleNo >= 0 && sampleNo < 31 && vagForSample[sampleNo] >= 0)
                    {
                        emit(eventTick, [cast(ubyte)(0xE0 | ch), 0, 64], false, -1);
                        emit(eventTick, [cast(ubyte)(0xC0 | ch), cast(ubyte)sampleNo]);
                        emit(eventTick, [cast(ubyte)(0x90 | ch), cast(ubyte)pendingNote[ch], 127]);
                        activeNote[ch] = pendingNote[ch];
                        baseNote[ch] = pendingNote[ch];
                        basePeriod[ch] = pendingPeriod[ch];
                        currentPeriod[ch] = basePeriod[ch];
                    }
                    else
                        activeNote[ch] = -1;
                    pendingNote[ch] = -1;
                }

                if (subTick > 0 && (volumeSlideUp[ch] || volumeSlideDown[ch]))
                {
                    channelVolume[ch] = max(0, min(64, channelVolume[ch]
                        + (volumeSlideUp[ch] ? volumeSlideUp[ch] : -volumeSlideDown[ch])));
                    emit(eventTick, [cast(ubyte)(0xB0 | ch), 7, cast(ubyte)(channelVolume[ch] * 127 / 64)]);
                }

                if (noteCut[ch] == subTick && activeNote[ch] >= 0)
                {
                    emit(eventTick, [cast(ubyte)(0x90 | ch), cast(ubyte)activeNote[ch], 0]);
                    activeNote[ch] = -1;
                }

                if (retrigger[ch] && subTick > 0 && retriggerMemory[ch] > 0
                    && subTick % retriggerMemory[ch] == 0 && activeNote[ch] >= 0)
                {
                    emit(eventTick, [cast(ubyte)(0x90 | ch), cast(ubyte)activeNote[ch], 0], false, -1);
                    emit(eventTick, [cast(ubyte)(0x90 | ch), cast(ubyte)activeNote[ch], 127]);
                }

                if (subTick > 0 && activeNote[ch] >= 0 && (pitchSlideDirection[ch] != 0 || tonePortamento[ch]))
                {
                    if (tonePortamento[ch] && targetPeriod[ch] > 0)
                    {
                        int step = tonePortaSpeed[ch];
                        if (currentPeriod[ch] < targetPeriod[ch])
                            currentPeriod[ch] = min(targetPeriod[ch], currentPeriod[ch] + step);
                        else if (currentPeriod[ch] > targetPeriod[ch])
                            currentPeriod[ch] = max(targetPeriod[ch], currentPeriod[ch] - step);
                    }
                    else if (pitchSlideDirection[ch] != 0)
                    {
                        currentPeriod[ch] += pitchSlideDirection[ch] * pitchSlideMemory[ch];
                        currentPeriod[ch] = max(1, min(4095, currentPeriod[ch]));
                    }
                    int bend = modPeriodBend(basePeriod[ch], currentPeriod[ch]);
                    emit(eventTick, [cast(ubyte)(0xE0 | ch), cast(ubyte)(bend & 0x7F), cast(ubyte)(bend >> 7)]);
                }

                if (activeNote[ch] >= 0 && vibratoThisRow[ch] && vibratoDepth[ch] > 0)
                {
                    previousVibrato[ch] = true;
                    vibratoPhase[ch] = (vibratoPhase[ch] + vibratoSpeed[ch]) & 63;
                    double wave = sin(vibratoPhase[ch] * 6.283185307179586 / 64.0);
                    int vibratoPeriod = max(1, currentPeriod[ch] + cast(int)round(wave * vibratoDepth[ch] * 4.0));
                    int bend = modPeriodBend(basePeriod[ch], vibratoPeriod);
                    emit(eventTick, [cast(ubyte)(0xE0 | ch), cast(ubyte)(bend & 0x7F), cast(ubyte)(bend >> 7)]);
                }
                else if (activeNote[ch] >= 0 && arpX[ch] >= 0 && baseNote[ch] >= 0)
                {
                    int offset = subTick % 3 == 1 ? arpX[ch] : subTick % 3 == 2 ? arpY[ch] : 0;
                    int bend = 8192 + offset * 8192 / 15;
                    emit(eventTick, [cast(ubyte)(0xE0 | ch), cast(ubyte)(bend & 0x7F), cast(ubyte)(bend >> 7)]);
                    previousArpeggio[ch] = true;
                }
            }
        }

        if (jumpOrder >= 0 || breakRow >= 0)
        {
            order = jumpOrder >= 0 ? cast(uint)jumpOrder : order + 1;
            row = breakRow >= 0 ? cast(uint)min(breakRow, 63) : 0;
        }
        else if (patternLoopRow >= 0)
        {
            row = cast(uint)patternLoopRow;
            seenPosition = null;
            firstTick = null;
        }
        else if (++row >= 64)
        {
            row = 0;
            order++;
        }
        tick += rowTicks * (rowDelay + 1);
    }

    if (hasLoop)
    {
        for (int ch; ch < 4; ch++)
            if (activeNote[ch] >= 0)
                emit(tick, [cast(ubyte)(0x90 | ch), cast(ubyte)activeNote[ch], 0], false, -1);
        emit(loopStartTick, [0xB0, 99, 20], false, -2);
        emit(loopStartTick, [0xB0, 6, 127], false, -2);
        emit(loopEndTick, [0xB0, 99, 30], false, 2);
    }
    else
    {
        if (opt.loop)
        {
            emit(0, [0xB0, 99, 20], false, -2);
            emit(0, [0xB0, 6, 127], false, -2);
            emit(tick, [0xB0, 99, 30], false, 2);
            hasLoop = true;
        }
        for (int ch; ch < 4; ch++)
            if (activeNote[ch] >= 0)
                emit(tick, [cast(ubyte)(0x90 | ch), cast(ubyte)activeNote[ch], 0], false, -1);
    }

    events.sort!((a, b) => a.tick != b.tick ? a.tick < b.tick
        : a.priority != b.priority ? a.priority < b.priority : a.index < b.index);
    ubyte[] body;
    ulong last;
    int runningStatus = -1;
    uint headTempo = 500000;
    foreach (e; events)
    {
        vlq(body, e.tick - last);
        last = e.tick;
        if (e.meta)
        {
            body ~= e.bytes;
            runningStatus = -1;
            if (e.tick == 0 && e.bytes.length == 5)
                headTempo = (e.bytes[2] << 16) | (e.bytes[3] << 8) | e.bytes[4];
        }
        else if (runningStatus == e.bytes[0])
            body ~= e.bytes[1 .. $];
        else
        {
            body ~= e.bytes;
            runningStatus = e.bytes[0];
        }
    }
    vlq(body, tick - last);
    body ~= [0xFF, 0x2F, 0x00];
    ubyte[] seq;
    seq ~= cast(ubyte[])"pQES";
    seq ~= [0, 0, 0, 1, cast(ubyte)(ppqn >> 8), cast(ubyte)ppqn];
    seq ~= [cast(ubyte)(headTempo >> 16), cast(ubyte)(headTempo >> 8), cast(ubyte)headTempo, 4, 2];
    seq ~= body;
    write(opt.output, seq);

    auto vb = new ubyte[16];
    foreach (vag; vags)
        vb ~= vag;
    auto vh = buildModVh(mod, vags, vagForSample[]);
    uint totalSize = cast(uint)(vh.length + vb.length);
    vh[12] = cast(ubyte)totalSize;
    vh[13] = cast(ubyte)(totalSize >> 8);
    vh[14] = cast(ubyte)(totalSize >> 16);
    vh[15] = cast(ubyte)(totalSize >> 24);

    string bankOut = opt.bankOut.length ? opt.bankOut : stripExtension(opt.output);
    if (opt.singleVab)
        write(bankOut ~ ".vab", vh ~ vb);
    else
    {
        write(bankOut ~ ".vh", vh);
        write(bankOut ~ ".vb", vb);
    }
    writefln("%s -> %s + %s  (%d samples, %d ticks/beat, %d bytes%s)",
        opt.input, opt.output, opt.singleVab ? bankOut ~ ".vab" : bankOut ~ ".vh/.vb",
        vags.length, ppqn, seq.length, hasLoop ? ", looped" : "");
    foreach (effect, count; unsupportedEffects)
        stderr.writefln("Warning: ignored %s in %d MOD rows", effect, count);
    return 0;
}
