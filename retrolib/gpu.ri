/**
 * GPU driver (shared definitions).
 */

#define DMA_CH2_MADR        0x1f8010a0
#define DMA_CH2_BCR         0x1f8010a4
#define DMA_CH2_CHCR        0x1f8010a8

#define DMA_CH2_ENABLE      0x00000800
#define DMA_BUSY            0x01000000
#define DMA_CH2_LIST_START  0x01000401 // RAM -> GPU, linked list, start
#define DMA_CH2_BLOCK_START 0x01000201 // RAM -> GPU, block (request) mode, start
#define GPU_LIST_END        0x00ffffff

#define GPU_PORT_GP0        0x1f801810
#define GPU_PORT_GP1        0x1f801814

#define GP0_MEM2VRAM        0xa0000000

#define GP0_CLIP_POS        0xe3000000
#define GP0_CLIP_SIZE       0xe4000000
#define GP0_DRAW_OFFS       0xe5000000
#define GP0_MASK            0xe6000000

#define GP0_FAST_RECT       0x02000000
#define GP0_TRI1            0x20000000
#define GP0_TRI2            0x30000000
#define GP0_TRI3            0x24000000
#define GP0_LINE1           0x40000000
#define GP0_LINE2           0x50000000
#define GP0_SPRITE1         0x60000000
#define GP0_SPRITE2         0xe1000000

#define GP0_SPRITE_TEX_MOD  0x64000000
#define GP0_SPRITE_TEX_RAW  0x65000000

#define COLOR_BLACK         0x00000000
#define COLOR_WHITE         0x00ffffff
#define COLOR_NEUTRAL       0x00808080

#define GP1_RESET           0x00000000
#define GP1_RESET_FIFO      0x01000000
#define GP1_DISP_ENABLE     0x03000000
#define GP1_DISP_DISABLE    0x03000001
#define GP1_DISP_OFFS       0x05000000
#define GP1_HRANGE          0x06000000
#define GP1_VRANGE          0x07000000
#define GP1_DISP_MODE       0x08000000

#define VMODE_NTSC  0
#define VMODE_PAL   1

#define HSTART 608

#define VCENTER_NTSC 136
#define VCENTER_PAL  163

#define HRES_256 0
#define HRES_320 1
#define HRES_512 2
#define HRES_640 3
#define HRES_368 64

#define VRES_240 0
#define VRES_480 4

#define COLORDEPTH_15BIT 0
#define COLORDEPTH_24BIT 1

/*
 * Two command buffers at fixed RAM addresses.
 */
#define GPU_BUF0 0x80180000
#define GPU_BUF1 0x80188000
#define GPU_BUF_BYTES 32768
#define GPU_BUF_WORDS 8192
macro GPURegionCommandBuffer0 = (GPU_BUF0, GPU_BUF_BYTES);
macro GPURegionCommandBuffer1 = (GPU_BUF1, GPU_BUF_BYTES);

/*
 * Two ordering tables.
 */
#define GPU_OT0  0x80190000
#define GPU_OT1  0x80192000
#define OT_SIZE_BYTES 8192
#define OT_SIZE_WORDS 2048
macro GPURegionOT0 = (GPU_OT0, OT_SIZE_BYTES);
macro GPURegionOT1 = (GPU_OT1, OT_SIZE_BYTES);

// Convenient macros for sending commands
macro GP0_PACK_COORDS(x, y) = (y << 16) | (x & 0xffff);
macro GP0_PACK_UV(u, v) = (v << 8) | (u & 0xff);
macro GP0_PACK_UV_DATA(u, v, hi) = (hi << 16) | (v << 8) | (u & 0xff);

///
macro gpuWaitIdle()
{
    while ((*gp1 & (1 << 28)) == 0) {}
}

///
macro gpuWaitCmd()
{
    while ((*gp1 & (1 << 26)) == 0) {}
}

/// Waits until the DMA channel is idle.
macro gpuWaitDma()
{
    while ((*dma2Chcr & DMA_BUSY) != 0) {}
}
