module main;

/*
 * XA stream encoder and interleaver.
 * Combines 2336-byte sector XA files into one playable file.
 * 
 * Usage:
 *   psxavenc -t xa -f 37800 -b 4 -c 2 channel0.mp3 channel0.xa
 *   psxavenc -t xa -f 37800 -b 4 -c 2 channel1.mp3 channel1.xa
 *   xatool -o MUSIC.XA --file 1 channel0.xa channel1.xa
 * 
 * Each input becomes one XA channel (input 1 -> channel 0, input 2 -> channel 1, ...).
 * File and channel numbers in the subheaders are overwritten, so the values
 * psxavenc wrote don't matter. Slots without a stream get empty padding sectors
 * (audio, Form 2, tagged with channel 31, which nothing should filter on).
 * The last real sector of each stream gets the EOF/EOR flags.
 * 
 * Interleave span (sectors per cycle):
 *   8  = 37800 Hz stereo 4-bit (default)
 *   16 = 18900 Hz stereo, or 37800 Hz mono
 *   32 = 18900 Hz mono
 *
 * XA Tool can transcode PCM WAV/MP3/FLAC/OGG files to XA format.
 * Simply use audio files as inputs instead of *.xa:
 *
 *   xatool -o MUSIC.XA --file 1 channel0.mp3 channel1.mp3
 */

import std.stdio;
import std.conv;
import std.file: read;
import std.path: extension;
import std.getopt: getopt;
import std.format: format;
import std.exception: enforce;
import std.string: toLower, toUpper;

import audioformats;
import wav;
import xa;

WavData decodeAudio(string path)
{
    AudioStream input;
    input.openFromFile(path);
    
    if (input.isError)
        throw new Exception("Failed to open \"" ~ path ~ "\"");
    
    float sampleRate = input.getSamplerate();
    int channels = input.getNumChannels();
    long lengthFrames = input.getLengthInFrames();
    double duration = -1.0;
    if (lengthFrames != audiostreamUnknownLength)
        duration = lengthFrames / cast(double)sampleRate;
    int chunkFrames = 4096;
    
    writefln("Input format: %s", input.getFormat().to!string.toUpper);
    writefln("Input sample rate: %s Hz", sampleRate);
    writefln("Input channels: %s", channels);
    if (duration < 0.0)
        writefln("Input duration: <undefined> (tracker format)");
    else
        writefln("Input duration: %s s", duration);
    
    WavData result;
    result.sampleRate = cast(uint)input.getSamplerate();
    result.channels = cast(ushort)channels;
    result.bitsPerSample = 16;

    float[] buffer = new float[chunkFrames * channels];

    while(true)
    {
        int frames = input.readSamplesFloat(buffer);
        if (input.isError)
            throw new Exception("Audio decoding failed");
        if (frames == 0)
            break;
        int count = frames * channels;
        short[] converted = new short[count];
        foreach (i; 0..count)
        {
            float s = buffer[i];
            if (s <= -1.0f)
                converted[i] = short.min;
            else if (s >= 1.0f)
                converted[i] = short.max;
            else
                converted[i] = cast(short)(s * 32768.0f);
        }
        result.samples ~= converted;
    }

    return result;
}

// TODO: XA encoding parameters
Stream loadStream(string path, XaFormat targetFormat)
{
    switch(path.extension.toLower)
    {
        case ".xa":
            return readSectors(path);

        case ".wav", ".mp3", ".flac", ".ogg", ".opus", ".qoa", ".mod", ".xm":
            return wavToXa(decodeAudio(path), path, targetFormat);

        default:
            throw new Exception("Unsupported input format");
    }
}

void printUsage()
{
    writeln("Encode/interleave multichannel XA streams.");
    writeln("Usage: xatool [options] input1 [input2...]");
    writeln("  -o, --output <file> output path");
    writeln("  -r, --rate <Hz>     resample input PCM to this rate (37800 or 18900)");
    writeln("  -s, --stereo        stereo output (true/false)");
    writeln("      --file          stream file number (0-255)");
    writeln("      --span          interleave span (sectors per cycle)");
    writeln("  -h, --help          show this help");
}

int main(string[] args)
{
    string output;
    int fileNo = 1;
    int span = 8;
    uint sampleRate = 37800;
    bool stereo = true;
    bool help = false;

    try
    {
        getopt(args,
            "o|output", &output,
            "file", &fileNo,
            "span", &span,
            "r|rate", &sampleRate,
            "s|stereo", &stereo,
            "h|help", &help
        );
    }
    catch (Exception e)
    {
        stderr.writeln(e.msg);
        return 1;
    }
    
    if (help)
    {
        printUsage();
        return 0;
    }

    if (output.length == 0)
    {
        printUsage();
        return 1;
    }

    // getopt removes parsed options; remaining arguments are inputs.
    if (args.length < 2)
    {
        stderr.writeln("Error: at least one input file is required");
        return 1;
    }

    if (fileNo < 0 || fileNo > 255)
    {
        stderr.writeln("Error: --file must be in range 0..255");
        return 1;
    }

    if (span <= 0)
    {
        stderr.writeln("Error: --span must be positive");
        return 1;
    }

    auto n = args.length - 1;

    if (n > span)
    {
        stderr.writeln(format(
            "Error: %s streams do not fit an interleave span of %s",
            n, span));
        return 1;
    }

    if (n > FILLER_CHANNEL)
    {
        stderr.writeln(format(
            "Error: at most %s streams are supported",
            FILLER_CHANNEL));
        return 1;
    }

    Stream[] streams;
    streams.reserve(n);

    auto targetFormat = XaFormat(sampleRate, stereo);
    try
    {
        foreach (i, path; args[1..$])
        {
            writefln("XA channel %s (%s Hz, %s): from %s",
                i,
                targetFormat.sampleRate,
                targetFormat.stereo? "stereo" : "mono",
                path);
            streams ~= loadStream(path, targetFormat);
        }
    }
    catch (Exception e)
    {
        stderr.writeln(e.msg);
        return 1;
    }

    // All streams must use the same XA coding mode.
    ubyte coding = streams[0].sector(0)[3];

    foreach (ref stream; streams)
    {
        ubyte otherCoding = stream.sector(0)[3];
        if (otherCoding != coding)
        {
            stderr.writeln(format(
                "%s: coding byte 0x%02X differs from 0x%02X (mixed rates/modes)",
                stream.path, otherCoding, coding));
            return 1;
        }
    }

    // Rewrite the duplicated XA subheaders.
    foreach (ch, ref stream; streams)
    {
        auto last = stream.length - 1;
        foreach (i; 0..stream.length)
        {
            auto sec = stream.sector(i);
            foreach (off; [0, 4])
            {
                sec[off] = cast(ubyte)fileNo;
                sec[off + 1] = cast(ubyte)ch;
                if (i == last)
                    sec[off + 2] |= 0x81; // EOF | EOR
            }
        }
    }

    // Padding sector: audio, Form 2, real-time, channel 31.
    ubyte[SECTOR] pad;

    foreach (off; [0, 4])
    {
        pad[off] = cast(ubyte) fileNo;
        pad[off + 1] = FILLER_CHANNEL;
        pad[off + 2] = 0x64;
        pad[off + 3] = coding;
    }

    size_t cycles = 0;

    foreach (ref stream; streams)
    {
        if (stream.length > cycles)
            cycles = stream.length;
    }
    
    ulong total = cast(ulong)cycles * cast(ulong)span;

    try
    {
        auto outFile = File(output, "wb");
        foreach (c; 0..cycles)
        {
            foreach (slot; 0..cast(size_t)span)
            {
                if (slot < n && c < streams[slot].length)
                    outFile.rawWrite(streams[slot].sector(c));
                else
                    outFile.rawWrite(pad[]);
            }
        }

        outFile.close();
    }
    catch (Exception e)
    {
        stderr.writeln(e.msg);
        return 1;
    }

    writefln("Wrote \"%s\": %s sectors (%s bytes), %s stream(s), file %s, channels 0-%s",
        output, total, total * SECTOR, n, fileNo, n - 1);

    writefln("Loop length: %s frames @60fps, %s frames @50fps (sectors*fps/150)",
        total * 60 / 150,
        total * 50 / 150);

    return 0;
}
