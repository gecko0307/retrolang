/**
 * GPU driver.
 */

#define GP0_MEM2VRAM  0xa0000000

#define GP0_CLIP_POS  0xe3000000
#define GP0_CLIP_SIZE 0xe4000000
#define GP0_DRAW_OFFS 0xe5000000
#define GP0_MASK      0xe6000000

#define GP0_FAST_RECT 0x02000000
#define GP0_TRI1      0x20000000
#define GP0_TRI2      0x30000000
#define GP0_LINE1     0x40000000
#define GP0_LINE2     0x50000000
#define GP0_SPRITE1   0x60000000
#define GP0_SPRITE2   0xe1000000

#define GP0_SPRITE_TEX1 0x64000000
#define GP0_SPRITE_TEX2 0x65000000

#define COLOR_NEUTRAL 0x808080

#define GP1_RESET      0x00000000
#define GP1_RESET_FIFO 0x01000000
#define GP1_DISP_ON    0x03000000
#define GP1_DISP_OFF   0x03000001
#define GP1_DISP_OFFS  0x05000000
#define GP1_HRANGE     0x06000000
#define GP1_VRANGE     0x07000000
#define GP1_DISP_MODE  0x08000000

#define VMODE_NTSC  0
#define VMODE_PAL   1

#define HSTART 608

#define VCENTER_NTSC 136
#define VCENTER_PAL 163

#define HRES_256 0
#define HRES_320 1
#define HRES_512 2
#define HRES_640 3
#define HRES_368 64

#define VRES_240 0
#define VRES_480 4

#define COLORDEPTH_15BIT 0
#define COLORDEPTH_24BIT 1

#define DMA_CH2_ENABLE   0x00000800
#define DMA_BUSY         0x01000000
#define DMA2_LIST_START  0x01000401 // RAM -> GPU, linked list, start
#define DMA2_BLOCK_START 0x01000201 // RAM -> GPU, block (request) mode, start
#define GPU_LIST_END     0x00ffffff

/*
 * Two command buffers at fixed RAM addresses.
 * Make sure this area does not collide with your data.
 */
#define GPU_BUF_WORDS 4096
#define GPU_BUF0 0x80180000
#define GPU_BUF1 0x80184000

int* gpuCurrentBuffer = GPU_BUF0; // buffer being filled
int  gpuBufferPos = 0;            // next free word in gpuCurrentBuffer
int* gpuLast = 0;                 // header of the last packet in gpuCurrentBuffer

struct GpuRect
{
    int x;
    int y;
    int width;
    int height;
};

struct GpuLine1
{
    int x1;
    int y1;
    int x2;
    int y2;
};

struct GpuLine2
{
    int x1;
    int y1;
    int color1;
    int x2;
    int y2;
    int color2;
};

struct GpuTriangle1
{
    int x1;
    int y1;
    int x2;
    int y2;
    int x3;
    int y3;
    int color;
};

struct GpuTriangle2
{
    int x1;
    int y1;
    int color1;

    int x2;
    int y2;
    int color2;

    int x3;
    int y3;
    int color3;
};

#define GpuSprite1 GpuRect

struct GpuSprite2
{
    struct GpuTexture* texture;
    int x;
    int y;
    int u;
    int v;
    int width;
    int height;
    int color;
};

struct GpuSettings
{
    int videoMode;
    struct GpuRect display;
    struct GpuRect clip;
    int interleaving; // 0 - off, 1 - on
    int colorDepth;
};

struct TimHeader
{
    uint magic;
    uint flags;
};

struct TimData
{
    uint size;
    uint pos;
    uint wh;
};

struct GpuTexture
{
    /// Pixel format
    uint pmode;
    
    /// X offset within the texture page
    ushort px;
    
    /// Y offset
    ushort py;
    
    /// Width
    ushort width;
    
    /// Height
    ushort height;
    
    /// CLUT ID
    ushort clutId;
    
    /// Texture page
    ushort tpage;
    
    /// CLUT info
    struct TimData* clut;
    
    /// Image info
    struct TimData* image;
};

// GPU I/O ports
int* gp0 = 0x1f801810;
int* gp1 = 0x1f801814;

// Video mode parameters
struct GpuSettings* __gpuSettings;
int screenX = 0;
int screenY = 0;
int cyclesPerPixel = 0;

// DMA registers
int* dmaDpcr  = 0x1f8010f0; // DMA control (channel enables / priorities)
int* dma2Madr = 0x1f8010a0; // channel 2: base address
int* dma2Bcr  = 0x1f8010a4; // channel 2: block control
int* dma2Chcr = 0x1f8010a8; // channel 2: channel control

/**
 * VSync.
 * Note: this takes over root counter 1. Do not use it for anything else.
 *
 * Root counter 1 is set to count Hblanks (scanlines) and to reset itself to 0 at
 * every Vblank (sync mode 1). The counter therefore climbs through the frame and
 * falls back to 0 exactly when Vblank starts; polling for that drop is a VSync.
 *
 * Why not poll I_STAT (0x1f801070) bit 0? The BIOS Vblank handler (it drives the
 * pad and memory card) acknowledges that bit within microseconds, so a polling
 * loop would miss it most of the time.
 */
int* timer1Count = 0x1f801110;
int* timer1Mode  = 0x1f801114;

// bit 0   : synchronization enabled
// bits 1-2: sync mode 1 = reset counter to 0 at Vblank
// bit 8   : clock source = Hblank
#define T1_VBLANK_RESET 0x0103

/**
 * Initialize the GPU.
 * The pointer to the GpuSettings struct must be valid till the end of the program.
 */
void gpuInit(struct GpuSettings* settings)
{
    __gpuSettings = settings;
    
    // Reset GPU
    *gp1 = GP1_RESET;
    
    // Enable DMA channel 2 and select CPU->GP0 transfer direction.
    *dmaDpcr = *dmaDpcr | DMA_CH2_ENABLE;
    *gp1 = 0x04000002;
    gpuCurrentBuffer = GPU_BUF0;
    gpuBufferPos = 0;
    gpuLast = 0;
    
    // Set drawing mode bits
    //*gp0 = 0xe1000200;
    *gp0 = 0xe1000600;
    
    // Texture window settings
    *gp0 = 0xe2000000;
    
    // Clip area
    *gp0 = GP0_CLIP_POS |
        (__gpuSettings->clip.y << 10 | __gpuSettings->clip.x);
    *gp0 = GP0_CLIP_SIZE |
        (__gpuSettings->clip.height - 1 + __gpuSettings->clip.y) << 10 | 
        (__gpuSettings->clip.width - 1  + __gpuSettings->clip.x);
    
    // Drawing offset
    *gp0 = GP0_DRAW_OFFS;
    
    // Mask settings
    *gp0 = GP0_MASK;
    
    // Display offset
    *gp1 = GP1_DISP_OFFS |
        (__gpuSettings->display.y << 10) |
        (__gpuSettings->display.x & 0xffff);

    int x1, x2, y1, y2;

    // Horizontal signal start/end
    cyclesPerPixel = 0;
    if      (__gpuSettings->display.width == 256) cyclesPerPixel = 10;
    else if (__gpuSettings->display.width == 320) cyclesPerPixel = 8;
    else if (__gpuSettings->display.width == 512) cyclesPerPixel = 5;
    else if (__gpuSettings->display.width == 640) cyclesPerPixel = 4;
    if      (__gpuSettings->display.width == 368)
    {
        // Special case
        x1 = 539;
        x2 = 3227;
    }
    else
    {
        x1 = HSTART + screenX * cyclesPerPixel;
        x2 = HSTART + ((screenX + __gpuSettings->display.width) * cyclesPerPixel);
    }
    *gp1 = GP1_HRANGE | ((x2 & 0xfff) << 12) | (x1 & 0xfff);
    bios_a(0x3f, "x1 = %d, x2 = %d\n", x1, x2);
    
    // Vertical signal start/end
    int centerY = VCENTER_NTSC;
    if (__gpuSettings->videoMode == VMODE_PAL)
        centerY = VCENTER_PAL;
    y1 = centerY - __gpuSettings->display.height / 2 + screenY;
    y2 = y1 + __gpuSettings->display.height;
    *gp1 = GP1_VRANGE | ((y2 & 0x3FF) << 10) | (y1 & 0x3FF);
    bios_a(0x3f, "y1 = %d, y2 = %d\n", y1, y2);
    
    // Video mode
    x1 = 0;
    y1 = 0;
         if (__gpuSettings->display.width == 256)  x1 = HRES_256;
    else if (__gpuSettings->display.width == 320)  x1 = HRES_320;
    else if (__gpuSettings->display.width == 512)  x1 = HRES_512;
    else if (__gpuSettings->display.width == 640)  x1 = HRES_640;
    else if (__gpuSettings->display.width == 368)  x1 = HRES_368;
         if (__gpuSettings->display.height == 240) y1 = VRES_240;
    else if (__gpuSettings->display.height == 480) y1 = VRES_480;
    uchar interleaving = (__gpuSettings->interleaving & 0x01) << 5;
    uchar bitDepth = (__gpuSettings->colorDepth & 0x01) << 4;
    *gp1 = GP1_DISP_MODE | x1 | y1 | interleaving | bitDepth | (__gpuSettings->videoMode << 3);
    
    // Enable display
    *gp1 = GP1_DISP_ON;
    
    // Init VSync
    *timer1Mode = T1_VBLANK_RESET;
}

///
void gpuWaitIdle()
{
    while ((*gp1 & (1 << 28)) == 0) {}
}

///
void gpuWaitCmd()
{
    while ((*gp1 & (1 << 26)) == 0) {}
}

/// Waits until the DMA channel is idle.
void gpuWaitDma()
{
    while ((*dma2Chcr & DMA_BUSY) != 0) {}
}

/// Returns right after the start of the next Vblank.
void gpuVSync()
{
    uint prev = *timer1Count & 0xffff;
    uint cur;

    while (1)
    {
        cur = *timer1Count & 0xffff;
        if (cur < prev)
            break;
        prev = cur;
    }
}

/// Waits for n Vblanks (n = 2 gives 30 fps on NTSC / 25 fps on PAL).
void gpuVSyncN(int n)
{
    int i;
    for (i = 0; i < n; i++)
        gpuVSync();
}

/**
 * Reserves a packet of n command words in the current buffer and returns a
 * pointer to the first of them. If the buffer is full, what has been queued so
 * far is sent and the buffer is reused.
 */
int* gpuAlloc(int n)
{
    if (gpuBufferPos + n + 1 >= GPU_BUF_WORDS)
        gpuFlush();

    int* hdr = gpuCurrentBuffer + gpuBufferPos;
    gpuBufferPos += n + 1;
    // size in the top byte, the next packet follows directly after this one
    *hdr = (n << 24) | ((uint)(gpuCurrentBuffer + gpuBufferPos) & GPU_LIST_END);
    gpuLast = hdr;
    return hdr + 1;
}

/// Terminates the list in the current buffer and starts the DMA transfer.
void gpuKick()
{
    if (gpuBufferPos == 0)
        return;

    // the previous transfer must be finished before the channel is reprogrammed
    gpuWaitDma();

    *gpuLast = *gpuLast | GPU_LIST_END;
    *dma2Madr = (uint)gpuCurrentBuffer & 0xffffff;
    *dma2Bcr = 0;
    *dma2Chcr = DMA2_LIST_START;
}

/**
 * Sends the queued commands, waits until the GPU has executed all of them and
 * restarts the current buffer. Call this before touching GP0 directly.
 */
void gpuFlush()
{
    gpuKick();
    gpuWaitDma();
    gpuWaitIdle();
    gpuBufferPos = 0;
}

/**
 * Ends the frame: starts the DMA and swaps command buffers.
 * The GPU keeps drawing while the CPU builds the next frame.
 */
void gpuEndFrame()
{
    gpuKick();
    if (gpuCurrentBuffer == GPU_BUF0)
        gpuCurrentBuffer = GPU_BUF1;
    else
        gpuCurrentBuffer = GPU_BUF0;
    gpuBufferPos = 0;
}

/// Creates a texture from a TIM file.
void gpuTextureInit(struct TimHeader* tim, struct GpuTexture* tex)
{
    char* p = (char*)tim;
    p += sizeof(struct TimHeader);
    
    struct TimData* clut = 0;
    struct TimData* image = 0;
    uchar* imageData = 0;
    uchar* clutData = 0;
    
    // get the color mode
    tex->pmode = (tim->flags & 0x03);
    
    if ((tim->flags & 0x08) == 0)
    {
        // No CLUT present
        image = (struct TimData*)p;
        imageData = p + sizeof(struct TimData);
        tex->clutId = 0;
    }
    else
    {
        clut = (struct TimData*)p;
        clutData = p + sizeof(struct TimData);
        p += clut->size;
        image = (struct TimData*)p;
        imageData = p + sizeof(struct TimData);
        
        tex->clutId = ((clut->pos >> 10) | (clut->pos & 0xffff) >> 4);
    }
    
    tex->px = (image->pos & 0xffff);
    tex->py = (image->pos >> 16);
    
    tex->tpage = ((tex->py & 0x100) >> 4) | ((tex->px & 0x3ff) >> 6) | ((tex->py & 0x200) << 2);
    tex->tpage = ((tex->pmode << 7) | tex->tpage);
    
    tex->px %= 64; // x/y offset within tpage
    if (tex->py > 255)
        tex->py -= 256;
    
    // width/height of pixel data
    tex->width = (image->wh & 0xffff) << (2 - tex->pmode);
    tex->height = (image->wh >> 16);
    
    tex->clut = clut;
    tex->image = image;
}

/// Copies texture data (pixel data or CLUT) to VRAM
void gpuMemToVram(struct TimData* timData, uint sizeInBytes)
{
    uint i;
    uint* pp = (uint*)timData;
    uint sizeInWords = (sizeInBytes >> 2) - 3;

    gpuWaitIdle();

    //*gp1 = GP1_RESET_FIFO; // reset the command queue
    
    *gp0 = GP0_MEM2VRAM;
    *gp0 = pp[1]; // x, y
    *gp0 = pp[2]; // width, height

    for (i = 0; i < sizeInWords; i++)
        *gp0 = pp[3 + i];

    //*gp1 = GP1_RESET_FIFO; // reset the command queue
}

/// Copies texture data (pixel data or CLUT) to VRAM using DMA
void gpuQueueMemToVram(struct TimData* timData, uint sizeInBytes)
{
    uint i;
    uint* pp = (uint*)timData;
    uint words = (sizeInBytes >> 2) - 3; // skip size/pos/wh
    uint* data = pp + 3;

    gpuFlush();

    *gp0 = GP0_MEM2VRAM;
    *gp0 = pp[1]; // x, y
    *gp0 = pp[2]; // width, height

    // Bulk of the data: DMA in blocks of 16 words
    uint blocks = words >> 4;
    uint rest = words & 15;
    if (blocks > 0)
    {
        *dma2Madr = (uint)data & 0xffffff;
        *dma2Bcr = (blocks << 16) | 16;
        *dma2Chcr = DMA2_BLOCK_START;
        gpuWaitDma();
        data += blocks << 4;
    }

    // Remaining words by hand
    for (i = 0; i < rest; i++)
        *gp0 = data[i];
}

/// Uploads a texture to VRAM
void gpuTextureUpload(struct GpuTexture* tex)
{
    gpuMemToVram(tex->image, tex->image->size);
    if (tex->clut != null)
        gpuMemToVram(tex->clut, tex->clut->size);
}

// ---------------------------------------------------------------------------
// Direct drawing
// ---------------------------------------------------------------------------

/// Clears the screen with the given color.
void gpuClear(int color)
{
    gpuWaitIdle();
    *gp0 = GP0_FAST_RECT | color;
    *gp0 = (__gpuSettings->display.y << 16) | __gpuSettings->display.x;
    *gp0 = (__gpuSettings->display.height << 16) | __gpuSettings->display.width;
}

/**
 * Fast rectangle filling command.
 * GP0(02h) rounds down the x-coordinate to the nearest multiple of 16.
 * The with is rounded up to a multiple of 16 pixels.
 */
void gpuFillRectFast(struct GpuRect* rect, int color)
{
    gpuWaitIdle();
    *gp0 = GP0_FAST_RECT | color;
    *gp0 = (rect->y << 16) | rect->x;
    *gp0 = (rect->height << 16) | rect->width;
}

/// Draws a solid-colored line.
void gpuDrawLine1(struct GpuLine1* line, int color)
{
    gpuWaitIdle();
    *gp0 = GP0_LINE1 | color;
    *gp0 = (line->y1 << 16) | line->x1;
    *gp0 = (line->y2 << 16) | line->x2;
}

/// Draws a Gouraud-shaded line.
void gpuDrawLine2(struct GpuLine2* line)
{
    gpuWaitIdle();
    *gp0 = GP0_LINE2 | line->color1;
    *gp0 = (line->y1 << 16) | line->x1;
    *gp0 = line->color2;
    *gp0 = (line->y2 << 16) | line->x2;
}

/// Draws a solid-colored sprite.
void gpuDrawSprite1(struct GpuSprite1* sprite, int color)
{
    gpuWaitIdle();
    *gp0 = GP0_SPRITE1 | color;
    *gp0 = (sprite->y << 16) | sprite->x;
    *gp0 = (sprite->height << 16) | sprite->width;
}

/// Draws a textured sprite.
void gpuDrawSprite2(struct GpuSprite2* sprite)
{
    uint u = sprite->texture->px + sprite->u;
    uint v = sprite->texture->py + sprite->v;
    gpuWaitIdle();
    *gp0 = GP0_SPRITE2 | sprite->texture->tpage;
    *gp0 = GP0_SPRITE_TEX2 | sprite->color;
    *gp0 = (sprite->y << 16) | sprite->x;
    *gp0 = ((uint)sprite->texture->clutId << 16) | (v << 8) | u;
    *gp0 = ((uint)sprite->height << 16) | sprite->width;
}

/// Draws a solid-colored triangle.
void gpuDrawTriangle1(struct GpuTriangle1* tri, int color)
{
    gpuWaitIdle();
    *gp0 = GP0_TRI1 | color;
    *gp0 = (tri->y1 << 16) | tri->x1;
    *gp0 = (tri->y2 << 16) | tri->x2;
    *gp0 = (tri->y3 << 16) | tri->x3;
}

/// Draws a Gouraud-shaded triangle.
void gpuDrawTriangle2(struct GpuTriangle2* tri)
{
    gpuWaitIdle();
    *gp0 = GP0_TRI2 | tri->color1;
    *gp0 = (tri->y1 << 16) | tri->x1;
    *gp0 = tri->color2;
    *gp0 = (tri->y2 << 16) | tri->x2;
    *gp0 = tri->color3;
    *gp0 = (tri->y3 << 16) | tri->x3;
}

// ---------------------------------------------------------------------------
// Queued drawing
// ---------------------------------------------------------------------------

/// Clears the screen with the given color.
void gpuQueueClear(int color)
{
    int* p = gpuAlloc(3);
    p[0] = GP0_FAST_RECT | color;
    p[1] = (__gpuSettings->display.y << 16) | (__gpuSettings->display.x & 0xffff);
    p[2] = (__gpuSettings->display.height << 16) | __gpuSettings->display.width;
}

/**
 * Fast rectangle filling command.
 * GP0(02h) rounds down the x-coordinate to the nearest multiple of 16.
 * The width is rounded up to a multiple of 16 pixels.
 */
void gpuQueueFillRectFast(struct GpuRect* rect, int color)
{
    int* p = gpuAlloc(3);
    p[0] = GP0_FAST_RECT | color;
    p[1] = (rect->y << 16) | (rect->x & 0xffff);
    p[2] = (rect->height << 16) | rect->width;
}

/// Draws a solid-colored line.
void gpuQueueDrawLine1(struct GpuLine1* line, int color)
{
    int* p = gpuAlloc(3);
    p[0] = GP0_LINE1 | color;
    p[1] = (line->y1 << 16) | (line->x1 & 0xffff);
    p[2] = (line->y2 << 16) | (line->x2 & 0xffff);
}

/// Draws a Gouraud-shaded line.
void gpuQueueDrawLine2(struct GpuLine2* line)
{
    int* p = gpuAlloc(4);
    p[0] = GP0_LINE2 | line->color1;
    p[1] = (line->y1 << 16) | (line->x1 & 0xffff);
    p[2] = line->color2;
    p[3] = (line->y2 << 16) | (line->x2 & 0xffff);
}

/// Draws a solid-colored sprite.
void gpuQueueDrawSprite1(struct GpuSprite1* sprite, int color)
{
    int* p = gpuAlloc(3);
    p[0] = GP0_SPRITE1 | color;
    p[1] = (sprite->y << 16) | (sprite->x & 0xffff);
    p[2] = (sprite->height << 16) | sprite->width;
}

/// Draws a textured sprite.
void gpuQueueDrawSprite2(struct GpuSprite2* sprite)
{
    uint u = sprite->texture->px + sprite->u;
    uint v = sprite->texture->py + sprite->v;
    int* p = gpuAlloc(5);
    p[0] = GP0_SPRITE2 | sprite->texture->tpage;
    p[1] = GP0_SPRITE_TEX2 | sprite->color;
    p[2] = (sprite->y << 16) | (sprite->x & 0xffff);
    p[3] = ((uint)sprite->texture->clutId << 16) | (v << 8) | u;
    p[4] = ((uint)sprite->height << 16) | sprite->width;
}

/// Draws a solid-colored triangle.
void gpuQueueDrawTriangle1(struct GpuTriangle1* tri, int color)
{
    int* p = gpuAlloc(4);
    p[0] = GP0_TRI1 | color;
    p[1] = (tri->y1 << 16) | (tri->x1 & 0xffff);
    p[2] = (tri->y2 << 16) | (tri->x2 & 0xffff);
    p[3] = (tri->y3 << 16) | (tri->x3 & 0xffff);
}

/// Draws a Gouraud-shaded triangle.
void gpuQueueDrawTriangle2(struct GpuTriangle2* tri)
{
    int* p = gpuAlloc(6);
    p[0] = GP0_TRI2 | tri->color1;
    p[1] = (tri->y1 << 16) | (tri->x1 & 0xffff);
    p[2] = tri->color2;
    p[3] = (tri->y2 << 16) | (tri->x2 & 0xffff);
    p[4] = tri->color3;
    p[5] = (tri->y3 << 16) | (tri->x3 & 0xffff);
}
