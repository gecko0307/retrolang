/**
 * PCM WAV to PlayStation VAG file converter.
 */
module main;

import std.algorithm: max, min;
import std.conv: to;
import std.file: read, write;
import std.getopt: getopt;
import std.path: baseName;
import std.stdio: stderr, writefln, writeln;
import std.utf: byDchar;

enum int blockSamples = 28;
immutable int[2][5] filters = [[0, 0], [60, 0], [115, -52], [98, -55], [122, -60]];

bool equalsBytes(const(ubyte)[] data, size_t offset, string text)
{
    if (offset + text.length > data.length)
        return false;
    foreach (i, character; text)
        if (data[offset + i] != character)
            return false;
    return true;
}

bool isPcmSubtype(const(ubyte)[] data, size_t offset)
{
    immutable ubyte[16] pcmGuid = [
        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x00,
        0x80, 0x00, 0x00, 0xAA, 0x00, 0x38, 0x9B, 0x71
    ];
    if (offset + pcmGuid.length > data.length)
        return false;
    return data[offset .. offset + pcmGuid.length] == pcmGuid[];
}

struct WavData
{
    int[][] channels;
    uint rate;
}

int clamp16(int value)
{
    return value < -32768 ? -32768 : value > 32767 ? 32767 : value;
}

int floorDiv(int value, int divisor)
{
    int quotient = value / divisor;
    return value < 0 && value % divisor != 0 ? quotient - 1 : quotient;
}

uint readU32LE(const(ubyte)[] data, size_t offset)
{
    return cast(uint)data[offset] |
        (cast(uint)data[offset + 1] << 8) |
        (cast(uint)data[offset + 2] << 16) |
        (cast(uint)data[offset + 3] << 24);
}

uint readU32BE(const(ubyte)[] data, size_t offset)
{
    return (cast(uint)data[offset] << 24) |
        (cast(uint)data[offset + 1] << 16) |
        (cast(uint)data[offset + 2] << 8) |
        cast(uint)data[offset + 3];
}

void appendU32LE(ref ubyte[] data, uint value)
{
    data ~= cast(ubyte)value;
    data ~= cast(ubyte)(value >> 8);
    data ~= cast(ubyte)(value >> 16);
    data ~= cast(ubyte)(value >> 24);
}

void appendU32BE(ref ubyte[] data, uint value)
{
    data ~= cast(ubyte)(value >> 24);
    data ~= cast(ubyte)(value >> 16);
    data ~= cast(ubyte)(value >> 8);
    data ~= cast(ubyte)value;
}

WavData readWav(string path)
{
    auto raw = cast(const(ubyte)[])read(path);
    if (raw.length < 12 || !equalsBytes(raw, 0, "RIFF") || !equalsBytes(raw, 8, "WAVE"))
        throw new Exception(path ~ ": cannot read WAV (not a RIFF/WAVE file). Only integer PCM WAV is supported (8/16/24/32-bit); float WAVs must be converted first.");

    bool haveFormat, haveData;
    ushort format, channelCount, bitsPerSample;
    uint sampleRate;
    size_t audioOffset, audioLength;
    size_t offset = 12;

    while (offset + 8 <= raw.length)
    {
        auto chunkSize = cast(size_t)readU32LE(raw, offset + 4);
        size_t chunkStart = offset + 8;
        if (chunkSize > raw.length - chunkStart)
            throw new Exception(path ~ ": truncated WAV chunk");

        if (equalsBytes(raw, offset, "fmt "))
        {
            if (chunkSize < 16)
                throw new Exception(path ~ ": invalid WAV format chunk");
            format = cast(ushort)(raw[chunkStart] | (raw[chunkStart + 1] << 8));
            channelCount = cast(ushort)(raw[chunkStart + 2] | (raw[chunkStart + 3] << 8));
            sampleRate = readU32LE(raw, chunkStart + 4);
            bitsPerSample = cast(ushort)(raw[chunkStart + 14] | (raw[chunkStart + 15] << 8));
            if (format == 0xFFFE && chunkSize >= 40 && isPcmSubtype(raw, chunkStart + 24))
                format = 1;
            haveFormat = true;
        }
        else if (equalsBytes(raw, offset, "data") && !haveData)
        {
            audioOffset = chunkStart;
            audioLength = chunkSize;
            haveData = true;
        }

        offset = chunkStart + chunkSize + (chunkSize & 1);
    }

    if (!haveFormat || !haveData || format != 1 || channelCount == 0 || sampleRate == 0)
        throw new Exception(path ~ ": unsupported WAV format; expected integer PCM.");
    if (bitsPerSample != 8 && bitsPerSample != 16 && bitsPerSample != 24 && bitsPerSample != 32)
        throw new Exception(path ~ ": unsupported sample width " ~ to!string(bitsPerSample) ~ " bits");

    size_t bytesPerSample = bitsPerSample / 8;
    size_t frameSize = bytesPerSample * channelCount;
    size_t frameCount = audioLength / frameSize;
    int[][] channels;
    channels.length = channelCount;
    foreach (ref channel; channels)
        channel.length = frameCount;

    for (size_t i = 0; i < frameCount; ++i)
    {
        for (size_t c = 0; c < channelCount; ++c)
        {
            size_t sampleOffset = audioOffset + (i * channelCount + c) * bytesPerSample;
            int sample;
            switch (bitsPerSample)
            {
                case 8:
                    sample = (cast(int)raw[sampleOffset] - 128) << 8;
                    break;
                case 16:
                    uint bits = raw[sampleOffset] | (cast(uint)raw[sampleOffset + 1] << 8);
                    sample = cast(short)bits;
                    break;
                case 24:
                    uint bits = raw[sampleOffset] |
                        (cast(uint)raw[sampleOffset + 1] << 8) |
                        (cast(uint)raw[sampleOffset + 2] << 16);
                    if (bits & 0x800000)
                        bits -= 0x1000000;
                    sample = cast(int)bits >> 8;
                    break;
                case 32:
                    sample = cast(int)readU32LE(raw, sampleOffset) >> 16;
                    break;
                default:
                    assert(0);
            }
            channels[c][i] = sample;
        }
    }
    return WavData(channels, sampleRate);
}

int[] resample(const(int)[] samples, uint sourceRate, uint targetRate)
{
    if (sourceRate == targetRate || samples.length == 0)
        return samples.dup;

    size_t count = cast(size_t)(cast(double)samples.length * targetRate / sourceRate);
    if (count == 0)
        count = 1;
    double ratio = cast(double)sourceRate / targetRate;
    int[] result;
    result.length = count;
    foreach (size_t i; 0 .. count)
    {
        double position = i * ratio;
        size_t j = cast(size_t)position;
        double fraction = position - j;
        int a = samples[min(j, samples.length - 1)];
        int b = samples[min(j + 1, samples.length - 1)];
        double value = a + (b - a) * fraction;
        double lower = value < 0 ? cast(double)cast(long)value - 1 : cast(double)cast(long)value;
        long rounded;
        if (value - lower < 0.5)
            rounded = cast(long)lower;
        else if (value - lower > 0.5)
            rounded = cast(long)(lower + 1);
        else
        {
            auto base = cast(long)lower;
            rounded = base % 2 == 0 ? base : base + 1;
        }
        result[i] = cast(int)rounded;
    }
    return result;
}

struct EncodedBlock
{
    int shift;
    int filter;
    ubyte[blockSamples] nibbles;
    int h1;
    int h2;
    long error;
}

EncodedBlock encodeBlock(const(int)[] block, int initialH1, int initialH2)
{
    bool haveBest;
    EncodedBlock best;
    foreach (size_t filterIndex, filter; filters)
    {
        int p1 = initialH1;
        int p2 = initialH2;
        int maximum = 0;
        foreach (sample; block)
        {
            int difference = sample - ((p1 * filter[0] + p2 * filter[1] + 32) >> 6);
            int magnitude = difference < 0 ? -difference : difference;
            maximum = max(maximum, magnitude);
            p2 = p1;
            p1 = sample;
        }

        int shift = 12;
        while (shift > 0 && maximum > 7 * (1 << (12 - shift)))
            --shift;

        int[2] shifts = [shift, shift > 0 ? shift - 1 : shift];
        size_t shiftCount = shift > 0 ? 2 : 1;
        foreach (candidateShift; shifts[0 .. shiftCount])
        {
            int step = 1 << (12 - candidateShift);
            int half = step >> 1;
            p1 = initialH1;
            p2 = initialH2;
            long error;
            EncodedBlock candidate;
            candidate.shift = candidateShift;
            candidate.filter = cast(int)filterIndex;

            foreach (size_t i, sample; block)
            {
                int prediction = (p1 * filter[0] + p2 * filter[1] + 32) >> 6;
                int nibble = floorDiv(sample - prediction + half, step);
                nibble = nibble < -8 ? -8 : nibble > 7 ? 7 : nibble;
                int reconstructed = clamp16(nibble * step + prediction);
                long residual = sample - reconstructed;
                error += residual * residual;
                candidate.nibbles[i] = cast(ubyte)(nibble & 0xF);
                p2 = p1;
                p1 = reconstructed;
            }
            candidate.h1 = p1;
            candidate.h2 = p2;
            candidate.error = error;
            if (!haveBest || error < best.error)
            {
                best = candidate;
                haveBest = true;
            }
        }
    }
    return best;
}

ubyte[] encodeAdpcm(int[] samples, int loopStart = int.min)
{
    if (samples.length == 0)
        samples = [0];

    size_t padding = (blockSamples - samples.length % blockSamples) % blockSamples;
    samples ~= new int[padding];
    size_t blockCount = samples.length / blockSamples;
    bool looping = loopStart != int.min;
    long loopBlock = looping
        ? min(floorDiv(loopStart, blockSamples), cast(int)blockCount - 1)
        : -1;

    ubyte[] output;
    output.reserve(blockCount * 16);
    int h1, h2;
    foreach (size_t blockIndex; 0 .. blockCount)
    {
        auto block = samples[blockIndex * blockSamples .. (blockIndex + 1) * blockSamples];
        auto encoded = encodeBlock(block, h1, h2);
        h1 = encoded.h1;
        h2 = encoded.h2;
        ubyte flag;
        if (!looping)
        {
            if (blockIndex == blockCount - 1)
                flag = 1;
        }
        else
        {
            if (blockIndex == loopBlock)
                flag = 6;
            if (blockIndex == blockCount - 1)
                flag = 3;
        }
        output ~= cast(ubyte)(encoded.shift | (encoded.filter << 4));
        output ~= flag;
        foreach (i; 0 .. blockSamples / 2)
            output ~= cast(ubyte)(encoded.nibbles[i * 2] | (encoded.nibbles[i * 2 + 1] << 4));
    }
    return output;
}

ubyte[] buildVag(const(ubyte)[] adpcm, uint rate, string name)
{
    ubyte[] output;
    output ~= cast(const(ubyte)[])"VAGp";
    appendU32BE(output, 0x20);
    appendU32BE(output, 0);
    appendU32BE(output, cast(uint)adpcm.length);
    appendU32BE(output, rate);
    output ~= new ubyte[12];
    ubyte[] encodedName;
    foreach (dchar character; byDchar(name))
    {
        if (encodedName.length == 16)
            break;
        encodedName ~= character < 128 ? cast(ubyte)character : cast(ubyte)'?';
    }
    output ~= encodedName;
    output ~= new ubyte[16 - encodedName.length];
    output ~= adpcm;
    return output;
}

int[] decodeVag(const(ubyte)[] data, out uint rate)
{
    if (data.length < 20 || (!equalsBytes(data, 0, "VAGp") && !equalsBytes(data, 0, "pGAV")))
        throw new Exception("Not a VAG file (missing VAGp magic)");
    bool bigEndian = equalsBytes(data, 0, "VAGp");
    uint size = bigEndian ? readU32BE(data, 12) : readU32LE(data, 12);
    rate = bigEndian ? readU32BE(data, 16) : readU32LE(data, 16);
    if (data.length < 48)
        throw new Exception("Invalid VAG header");

    size_t bodyEnd = size == 0 ? data.length : min(data.length, 48 + cast(size_t)size);
    auto body = data[48 .. bodyEnd];
    int[] output;
    int h1, h2;
    for (size_t offset = 0; offset + 16 <= body.length; offset += 16)
    {
        int shift = min(cast(int)(body[offset] & 0xF), 12);
        int filterIndex = (body[offset] >> 4) % 5;
        ubyte flag = body[offset + 1];
        auto filter = filters[filterIndex];
        foreach (i; 0 .. 14)
        {
            ubyte packed = body[offset + 2 + i];
            foreach (ubyte value; [cast(ubyte)(packed & 0xF), cast(ubyte)(packed >> 4)])
            {
                int nibble = value & 8 ? cast(int)value - 16 : value;
                int sample = clamp16(((nibble << 12) >> shift) +
                    ((h1 * filter[0] + h2 * filter[1] + 32) >> 6));
                output ~= sample;
                h2 = h1;
                h1 = sample;
            }
        }
        if (flag & 1)
            break;
    }
    return output;
}

ubyte[] buildWav(const(int)[] samples, uint rate)
{
    uint dataSize = cast(uint)(samples.length * 2);
    ubyte[] output;
    output ~= cast(const(ubyte)[])"RIFF";
    appendU32LE(output, 36 + dataSize);
    output ~= cast(const(ubyte)[])"WAVEfmt ";
    appendU32LE(output, 16);
    output ~= [cast(ubyte)1, 0, 1, 0];
    appendU32LE(output, rate);
    appendU32LE(output, rate * 2);
    output ~= [cast(ubyte)2, 0, 16, 0];
    output ~= cast(const(ubyte)[])"data";
    appendU32LE(output, dataSize);
    foreach (sample; samples)
    {
        ushort bits = cast(ushort)sample;
        output ~= cast(ubyte)bits;
        output ~= cast(ubyte)(bits >> 8);
    }
    return output;
}

string stemOf(string path)
{
    string leaf = baseName(path);
    size_t dot = leaf.length;
    foreach (i, character; leaf)
        if (character == '.')
            dot = i;
    return dot > 0 ? leaf[0 .. dot] : leaf;
}

string pathWithoutExtension(string path)
{
    string leaf = baseName(path);
    string stem = stemOf(path);
    return path[0 .. $ - leaf.length] ~ stem;
}

string withoutVagExtension(string path)
{
    if (path.length >= 4)
    {
        string suffix = path[$ - 4 .. $];
        if (suffix[0] == '.' && (suffix[1] == 'v' || suffix[1] == 'V') &&
            (suffix[2] == 'a' || suffix[2] == 'A') && (suffix[3] == 'g' || suffix[3] == 'G'))
            return path[0 .. $ - 4];
    }
    return path;
}

string suffixFor(size_t channel, size_t channelCount)
{
    if (channelCount == 1)
        return "";
    if (channel == 0)
        return "_L";
    if (channel == 1)
        return "_R";
    return "_" ~ to!string(channel);
}

void convertFile(string path, string outputPath, string customName, uint targetRate,
                 bool loop, bool hasLoopStart, int loopStart, bool mix)
{
    auto wav = readWav(path);
    string stem = stemOf(path);
    if (wav.channels.length > 1 && mix)
    {
        size_t count = wav.channels[0].length;
        foreach (channel; wav.channels[1 .. $])
            count = min(count, channel.length);
        int[] mixed;
        mixed.length = count;
        foreach (size_t i; 0 .. count)
        {
            int sum;
            foreach (channel; wav.channels)
                sum += channel[i];
            mixed[i] = floorDiv(sum, cast(int)wav.channels.length);
        }
        wav.channels = [mixed];
    }
    if (targetRate != 0 && targetRate != wav.rate)
    {
        foreach (ref channel; wav.channels)
            channel = resample(channel, wav.rate, targetRate);
        wav.rate = targetRate;
    }

    int actualLoopStart = hasLoopStart ? loopStart : loop ? 0 : int.min;
    string base = outputPath.length == 0
        ? pathWithoutExtension(path)
        : withoutVagExtension(outputPath);
    foreach (size_t channelIndex, channel; wav.channels)
    {
        string suffix = suffixFor(channelIndex, wav.channels.length);
        string name = (customName.length == 0 ? stem : customName) ~ suffix;
        auto vag = buildVag(encodeAdpcm(channel.dup, actualLoopStart), wav.rate, name);
        string destination = base ~ suffix ~ ".vag";
        write(destination, vag);
        double duration = cast(double)channel.length / wav.rate;
        writefln("%s -> %s  (%s samples, %s Hz, %.2fs, %s bytes%s)",
            path, destination, channel.length, wav.rate, duration, vag.length,
            actualLoopStart != int.min ? ", looped" : "");
    }
}

void decodeFile(string path, string outputPath)
{
    uint rate;
    auto samples = decodeVag(cast(const(ubyte)[])read(path), rate);
    string destination = outputPath.length != 0
        ? outputPath
        : pathWithoutExtension(path) ~ ".wav";
    write(destination, buildWav(samples, rate));
    writefln("%s -> %s  (%s samples, %s Hz)", path, destination, samples.length, rate);
}

void printUsage()
{
    writeln("Convert PCM WAV to PlayStation ADPCM VAG.");
    writeln("Usage: wav2vag [options] input.wav [input.wav ...]");
    writeln("  -o, --output <file>      output path (single input only)");
    writeln("  -r, --rate <hz>          resample to this rate (1..44100)");
    writeln("      --name <name>        name stored in the VAG header (max 16 chars)");
    writeln("      --loop               loop the whole sample");
    writeln("      --loop-start <n>     loop from this output sample to the end");
    writeln("      --mix                mix multichannel input down to mono");
    writeln("      --decode             decode VAG back to WAV");
    writeln("  -h, --help               show this help");
}

int main(string[] args)
{
    string outputPath, customName;
    int targetRate;
    int loopStart = int.min;
    bool loop, hasLoopStart, mix, decode, help;
    try
    {
        getopt(args,
            "output|o", &outputPath,
            "rate|r", &targetRate,
            "name", &customName,
            "loop", &loop,
            "loop-start", &loopStart,
            "mix", &mix,
            "decode", &decode,
            "help|h", &help);
    }
    catch (Exception error)
    {
        stderr.writeln(error.msg);
        printUsage();
        return 1;
    }
    if (help)
    {
        printUsage();
        return 0;
    }
    hasLoopStart = loopStart != int.min;
    if (args.length < 2)
    {
        printUsage();
        return 1;
    }
    if (outputPath.length != 0 && args.length > 2)
    {
        stderr.writeln("-o can only be used with a single input");
        return 1;
    }
    if (targetRate != 0 && (targetRate < 1 || targetRate > 44100))
    {
        stderr.writeln("--rate must be between 1 and 44100");
        return 1;
    }

    try
    {
        foreach (path; args[1 .. $])
        {
            if (decode)
                decodeFile(path, outputPath);
            else
                convertFile(path, outputPath, customName, cast(uint)targetRate,
                    loop, hasLoopStart, loopStart, mix);
        }
    }
    catch (Exception error)
    {
        stderr.writeln(error.msg);
        return 1;
    }
    return 0;
}
