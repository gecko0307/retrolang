/**
 * MIPS-I assembler v2.
 *
 * Line format:
 *
 *   [label:] [mnemonic operands | directive args]   [; comment]
 *
 * Comments
 * --------
 *   ; ...   # ...   // ...   to the end of the line, and block comments  /* ... *​/
 *
 * Sections and labels
 * -------------------
 *   .text / .data      switch the current section (the default is .text)
 *   name:              a label. In .text it marks a jump target, in .data it starts a data entry.
 *                      Several labels may stand on one line before an instruction: "a: b: nop"
 *   .name              legacy code label (no colon), referenced as ".name"
 *   Labels can be used as operands of j/jal, all branches, li/la, %hi()/%lo(), .word and as
 *   "label+offset". They are local to the file, the linker resolves them to absolute addresses.
 *
 * Operands
 * --------
 *   Registers   $t0, t0, $8, $zero, $s8/$fp, $k0, $r5 ...
 *   Immediates  full constant expressions: 123, -4, 0x1F, 0b101, 0o17, 'a', "1 << 4", "(A + 4) * 2"
 *               operators: | ^ & << >> + - * / % ~ ( )   and names defined with .equ
 *   Memory      4($sp)   ($a0)   label+8($t0)   %lo(label)($at)   and the pseudo forms
 *               "lw $t0, label" / "sw $t0, 0x1F801070" which expand to lui + load/store
 *   %hi(x) %lo(x)   upper / lower halves (%hi is adjusted for the sign of %lo, GNU style)
 *
 * Directives
 * ----------
 *   .equ name, expr    (also .set name, expr)  define a constant
 *   .word  e, ...      32-bit values (labels allowed); in .text they become raw instruction words
 *   .half  e, ...      16-bit values            (.short, .hword)        .data only
 *   .byte  e, ...      8-bit values                                     .data only
 *   .ascii "s", ...    string without terminator                        .data only
 *   .asciiz "s", ...   string with a zero terminator (.string)          .data only
 *   .space n[, fill]   n bytes (.skip, .zero); in .text n must be a multiple of 4
 *   .align n           align the current data entry to 2^n bytes        .data only
 *   .balign n          align the current data entry to n bytes          .data only
 *   .globl .global .extern .option .set noat/noreorder/...   accepted and ignored
 *   "text"             legacy: a bare string literal line in .data = .ascii
 *
 * Pseudoinstructions
 * ------------------
 *   nop move clear neg negu not li la b bal beqz bnez
 *   blt ble bgt bge bltu bleu bgtu bgeu   (register or immediate second operand, use $at)
 *   seq sne sgt sge sle sgtu sgeu sleu
 *   mul rd,rs,rt   div/divu/rem/remu rd,rs,rt   (3-operand forms, no zero check)
 *   subi subiu     add/addu/sub/subu/and/or/xor/slt/sltu with an immediate last operand
 *   sll/srl/sra with a register shift amount
 *   lb/lbu/lh/lhu/lw/sb/sh/sw/lwl/lwr/swl/swr with a label or absolute address
 *
 * The assembler never reorders instructions and never fills delay slots: write the nops yourself.
 *
 * If used in a broad context (e.g., with a compiler), a unique `labelPrefix` should be provided
 * to avoid label collisions across multiple files.
 */
module assembler2;

import std.string;
import std.array: appender;
import std.ascii: isAlpha, isAlphaNum, isDigit, isWhite;
import std.format: format;
import mips;
import ir;
import error;
import utils;

/// Symbolic or numeric value of an expression: a constant, or label + constant.
private struct EV
{
    long v;
    string label; // empty for plain constants
}

/// Operand of an immediate slot: constant, or label with a relocation kind.
private struct Imm
{
    long v;
    string label;
    RelocKind rk;
}

private bool isLabelStart(char c)
{
    return isAlpha(c) || c == '_' || c == '.';
}

private bool isLabelChar(char c)
{
    return isAlphaNum(c) || c == '_' || c == '.' || c == '$';
}

private long hiOf(long v)
{
    return ((v + 0x8000) >> 16) & 0xFFFF;
}

private long loOf(long v)
{
    return cast(short)v;
}

/// Removes comments from a line, honoring string and character literals.
private string stripComment(string line, ref bool inBlock)
{
    auto sb = appender!string;
    size_t i = 0;
    char quote = 0;
    while (i < line.length)
    {
        char c = line[i];
        if (inBlock)
        {
            if (c == '*' && i + 1 < line.length && line[i + 1] == '/')
            {
                inBlock = false;
                i += 2;
                sb ~= ' ';
            }
            else
                i++;
            continue;
        }
        if (quote)
        {
            sb ~= c;
            if (c == '\\' && i + 1 < line.length)
            {
                sb ~= line[i + 1];
                i += 2;
                continue;
            }
            if (c == quote)
                quote = 0;
            i++;
            continue;
        }
        if (c == '"' || c == '\'')
        {
            quote = c;
            sb ~= c;
            i++;
            continue;
        }
        if (c == ';' || c == '#')
            break;
        if (c == '/' && i + 1 < line.length)
        {
            if (line[i + 1] == '/')
                break;
            if (line[i + 1] == '*')
            {
                inBlock = true;
                i += 2;
                continue;
            }
        }
        sb ~= c;
        i++;
    }
    return sb.data;
}

/// If the line starts with "name:", removes it from the line and returns true.
private bool takeLabel(ref string line, out string name)
{
    if (line.length == 0 || !isLabelStart(line[0]))
        return false;
    size_t i = 0;
    while (i < line.length && isLabelChar(line[i]))
        i++;
    size_t j = i;
    while (j < line.length && (line[j] == ' ' || line[j] == '\t'))
        j++;
    if (j < line.length && line[j] == ':')
    {
        name = line[0 .. i];
        line = line[j + 1 .. $].strip;
        return true;
    }
    return false;
}

/// Splits "a, b(c, d), e" at top-level commas.
private string[] splitOperands(string s)
{
    string[] res;
    s = s.strip;
    if (s.length == 0)
        return res;

    int depth = 0;
    char quote = 0;
    size_t start = 0;
    size_t i = 0;
    while (i < s.length)
    {
        char c = s[i];
        if (quote)
        {
            if (c == '\\')
                i++;
            else if (c == quote)
                quote = 0;
        }
        else if (c == '"' || c == '\'')
            quote = c;
        else if (c == '(')
            depth++;
        else if (c == ')')
            depth--;
        else if (c == ',' && depth == 0)
        {
            res ~= s[start .. i].strip;
            start = i + 1;
        }
        i++;
    }
    res ~= s[start .. $].strip;

    // Legacy: operands separated by blanks only ("lw t0 4 sp")
    if (res.length == 1)
    {
        string[] toks = res[0].split();
        if (toks.length > 1)
        {
            bool simple = true;
            foreach (t; toks)
            {
                foreach (k, ch; t)
                {
                    if ("+*/%<>&|^~!=\"'".indexOf(ch) >= 0 || (ch == '-' && k > 0))
                        simple = false;
                }
            }
            if (simple)
                res = toks;
        }
    }
    return res;
}

private class Asm
{
    string filename;
    string labelPrefix;
    size_t instrIndexStart;

    AsmInstr[] output;
    AsmDataEntry[] dataEntries;
    size_t[string] sections; // code label -> global instruction index
    size_t[string] dataLabels;
    long[string] equs;
    bool[string] defined;

    bool inData = false;
    bool textLabelDefined = false;
    int curEntry = -1;
    uint lineNum = 0;

    // expression parser state
    string es;
    size_t ep;

    this(string filename, string labelPrefix, size_t instrIndexStart)
    {
        this.filename = filename;
        this.labelPrefix = labelPrefix;
        this.instrIndexStart = instrIndexStart;
    }

    Exception bad(string msg)
    {
        return err(filename, lineNum, msg);
    }

    /*
     * Driver
     */

    void run(string code)
    {
        bool inBlock = false;
        uint n = 0;
        foreach (raw; code.splitLines)
        {
            n++;
            lineNum = n;
            string line = stripComment(raw, inBlock).strip;
            processLine(line);
        }
        if (inBlock)
            throw bad("unterminated comment");
    }

    Assembly result()
    {
        Assembly ass = new Assembly();
        ass.instructions = output;
        ass.dataEntries = dataEntries;
        ass.sections = sections;
        ass.dataLabels = dataLabels;
        return ass;
    }

    void processLine(string line)
    {
        while (line.length)
        {
            string lbl;
            if (!takeLabel(line, lbl))
                break;
            defineLabel(lbl);
        }
        if (line.length == 0)
            return;

        if (line[0] == '"')
        {
            legacyString(line);
            return;
        }
        if (line[0] == '.')
        {
            directive(line);
            return;
        }
        instruction(line);
    }

    void defineLabel(string name)
    {
        string full = labelPrefix ~ name;
        if (full in defined)
            throw bad("duplicate label \"" ~ name ~ "\"");
        defined[full] = true;
        if (inData)
        {
            dataEntries ~= AsmDataEntry(full, null);
            curEntry = cast(int)dataEntries.length - 1;
            dataLabels[full] = dataEntries.length - 1;
        }
        else
        {
            sections[full] = instrIndexStart + output.length;
        }
    }

    /*
     * Emission helpers
     */

    void emit(Op op, AsmOperand a = AsmOperand.init, AsmOperand b = AsmOperand.init, AsmOperand c = AsmOperand.init)
    {
        output ~= AsmInstr(op, a, b, c, lineNum);
    }

    void need(string mn, string[] args, size_t n)
    {
        if (args.length != n)
            throw bad(format("\"%s\" expects %s operand(s) but %s given", mn, n, args.length));
    }

    void needRange(string mn, string[] args, size_t lo, size_t hi)
    {
        if (args.length < lo || args.length > hi)
            throw bad(format("\"%s\" expects %s to %s operand(s) but %s given", mn, lo, hi, args.length));
    }

    /*
     * Registers
     */

    Reg getReg(string s)
    {
        try
        {
            return parseReg(s);
        }
        catch (Exception)
        {
            throw bad("invalid register \"" ~ s ~ "\"");
        }
    }

    Reg getCop0(string s)
    {
        try
        {
            return parseRegCop0(s);
        }
        catch (Exception)
        {
            throw bad("invalid COP0 register \"" ~ s ~ "\"");
        }
    }

    Reg getGteData(string s)
    {
        try
        {
            return parseRegGteData(s);
        }
        catch (Exception)
        {
            throw bad("invalid GTE data register \"" ~ s ~ "\"");
        }
    }

    Reg getGteCtrl(string s)
    {
        try
        {
            return parseRegGteControl(s);
        }
        catch (Exception)
        {
            throw bad("invalid GTE control register \"" ~ s ~ "\"");
        }
    }

    /// Is the operand a register (as opposed to an immediate)? Plain numbers are immediates.
    bool looksLikeReg(string s)
    {
        if (s.length == 0)
            return false;
        if (s[0] == '$')
            return true;
        if (isDigit(s[0]) || s[0] == '-' || s[0] == '+' || s[0] == '(' || s[0] == '%' || s[0] == '\'' || s[0] == '~')
            return false;
        try
        {
            parseReg(s);
            return true;
        }
        catch (Exception)
        {
            return false;
        }
    }

    AsmOperand R(string s)
    {
        return makeReg(getReg(s));
    }

    /*
     * Expressions
     */

    void skipWs()
    {
        while (ep < es.length && isWhite(es[ep]))
            ep++;
    }

    bool acceptOp(string op)
    {
        skipWs();
        if (ep + op.length <= es.length && es[ep .. ep + op.length] == op)
        {
            // do not mistake "<" of "<<" etc.: callers test longer operators first
            ep += op.length;
            return true;
        }
        return false;
    }

    EV evalExpr(string text)
    {
        es = text;
        ep = 0;
        skipWs();
        if (ep >= es.length)
            throw bad("missing operand");
        EV r = parseOr();
        skipWs();
        if (ep < es.length)
            throw bad("unexpected \"" ~ es[ep .. $] ~ "\" in expression");
        return r;
    }

    EV binop(string op, EV a, EV b)
    {
        bool la = a.label.length > 0;
        bool lb = b.label.length > 0;
        if (la || lb)
        {
            if (op == "+" && !(la && lb))
                return EV(a.v + b.v, la ? a.label : b.label);
            if (op == "-" && la && !lb)
                return EV(a.v - b.v, a.label);
            throw bad("operator \"" ~ op ~ "\" cannot be applied to a label");
        }

        switch (op)
        {
            case "|":  return EV(a.v | b.v);
            case "^":  return EV(a.v ^ b.v);
            case "&":  return EV(a.v & b.v);
            case "<<":
                if (b.v < 0 || b.v > 63)
                    throw bad("invalid shift count");
                return EV(a.v << b.v);
            case ">>":
                if (b.v < 0 || b.v > 63)
                    throw bad("invalid shift count");
                return EV(a.v >> b.v);
            case "+":  return EV(a.v + b.v);
            case "-":  return EV(a.v - b.v);
            case "*":  return EV(a.v * b.v);
            case "/":
                if (b.v == 0)
                    throw bad("division by zero");
                return EV(a.v / b.v);
            case "%":
                if (b.v == 0)
                    throw bad("division by zero");
                return EV(a.v % b.v);
            default:
                throw bad("unsupported operator " ~ op);
        }
    }

    EV parseOr()
    {
        EV l = parseXor();
        while (true)
        {
            skipWs();
            if (ep < es.length && es[ep] == '|')
            {
                ep++;
                l = binop("|", l, parseXor());
            }
            else
                return l;
        }
    }

    EV parseXor()
    {
        EV l = parseAnd();
        while (true)
        {
            skipWs();
            if (ep < es.length && es[ep] == '^')
            {
                ep++;
                l = binop("^", l, parseAnd());
            }
            else
                return l;
        }
    }

    EV parseAnd()
    {
        EV l = parseShift();
        while (true)
        {
            skipWs();
            if (ep < es.length && es[ep] == '&')
            {
                ep++;
                l = binop("&", l, parseShift());
            }
            else
                return l;
        }
    }

    EV parseShift()
    {
        EV l = parseAdd();
        while (true)
        {
            if (acceptOp("<<"))
                l = binop("<<", l, parseAdd());
            else if (acceptOp(">>"))
                l = binop(">>", l, parseAdd());
            else
                return l;
        }
    }

    EV parseAdd()
    {
        EV l = parseMul();
        while (true)
        {
            skipWs();
            if (ep < es.length && (es[ep] == '+' || es[ep] == '-'))
            {
                string op = es[ep .. ep + 1];
                ep++;
                l = binop(op, l, parseMul());
            }
            else
                return l;
        }
    }

    EV parseMul()
    {
        EV l = parseUnary();
        while (true)
        {
            skipWs();
            if (ep < es.length && (es[ep] == '*' || es[ep] == '/' || es[ep] == '%'))
            {
                string op = es[ep .. ep + 1];
                ep++;
                l = binop(op, l, parseUnary());
            }
            else
                return l;
        }
    }

    EV parseUnary()
    {
        skipWs();
        if (ep >= es.length)
            throw bad("unexpected end of expression");
        char c = es[ep];
        if (c == '-' || c == '+' || c == '~')
        {
            ep++;
            EV a = parseUnary();
            if (a.label.length)
                throw bad("unary operator cannot be applied to a label");
            if (c == '-')
                return EV(-a.v);
            if (c == '~')
                return EV(~a.v);
            return a;
        }
        return parsePrimary();
    }

    EV parsePrimary()
    {
        skipWs();
        char c = es[ep];

        if (c == '(')
        {
            ep++;
            EV r = parseOr();
            skipWs();
            if (ep >= es.length || es[ep] != ')')
                throw bad("missing \")\" in expression");
            ep++;
            return r;
        }

        if (isDigit(c))
        {
            size_t s = ep;
            while (ep < es.length && (isAlphaNum(es[ep]) || es[ep] == '_'))
                ep++;
            string t = es[s .. ep].replace("_", "").toLower;
            if (t.length > 1 && t[$ - 1] == 'u' && !(t.length > 2 && t[1] == 'x' && false))
            {
                // C-style unsigned suffix (hex digits never include 'u')
                t = t[0 .. $ - 1];
            }
            try
                return EV(parseInt(t));
            catch (Exception)
                throw bad("bad number \"" ~ es[s .. ep] ~ "\"");
        }

        if (c == '\'')
        {
            size_t s = ++ep;
            while (ep < es.length && es[ep] != '\'')
            {
                if (es[ep] == '\\')
                    ep++;
                ep++;
            }
            if (ep >= es.length)
                throw bad("unterminated character literal");
            ubyte[] b = parseEscapes(es[s .. ep]);
            ep++;
            if (b.length != 1)
                throw bad("bad character literal");
            return EV(b[0]);
        }

        if (isLabelStart(c))
        {
            size_t s = ep;
            while (ep < es.length && isLabelChar(es[ep]) && es[ep] != '$')
                ep++;
            string name = es[s .. ep];
            if (auto p = name in equs)
                return EV(*p);
            return EV(0, labelPrefix ~ name);
        }

        throw bad("unexpected \"" ~ es[ep .. $] ~ "\" in expression");
    }

    /// Parses an immediate operand: an expression, optionally wrapped in %hi() / %lo().
    Imm parseImm(string s)
    {
        s = s.strip;
        if (s.length == 0)
            throw bad("missing operand");

        if (s[0] == '%')
        {
            ptrdiff_t open = s.indexOf('(');
            if (open < 0 || s[$ - 1] != ')')
                throw bad("malformed relocation operator \"" ~ s ~ "\"");
            string fn = s[1 .. open].toLower;
            RelocKind rk;
            if (fn == "hi")
                rk = RelocKind.Hi;
            else if (fn == "lo")
                rk = RelocKind.Lo;
            else
                throw bad("unknown relocation operator \"%" ~ fn ~ "\"");

            EV e = evalExpr(s[open + 1 .. $ - 1]);
            if (e.label.length == 0)
                return Imm(rk == RelocKind.Hi ? hiOf(e.v) : loOf(e.v), "", RelocKind.None);
            return Imm(e.v, e.label, rk);
        }

        EV e = evalExpr(s);
        return Imm(e.v, e.label, RelocKind.None);
    }

    long constant(string s)
    {
        Imm im = parseImm(s);
        if (im.label.length)
            throw bad("constant expression expected, got a label in \"" ~ s ~ "\"");
        return im.v;
    }

    AsmOperand labelOperand(Imm im, RelocKind rk)
    {
        AsmOperand o = makeLabel(im.label);
        o.offset = im.v;
        o.reloc = rk;
        return o;
    }

    /// 16-bit immediate slot (addi, andi, lui, load/store offsets ...).
    AsmOperand imm16(string s, bool negate = false)
    {
        Imm im = parseImm(s);
        if (im.label.length)
        {
            if (im.rk == RelocKind.None)
                throw bad("a label cannot be used as a 16-bit immediate, use %hi(" ~ s ~ ") or %lo(" ~ s ~ ")");
            if (negate)
                throw bad("cannot negate a relocation");
            return labelOperand(im, im.rk);
        }
        long v = negate ? -im.v : im.v;
        if (v < -32768 || v > 65535)
            throw bad(format("immediate %s does not fit in 16 bits", v));
        return makeImm(v);
    }

    AsmOperand shiftAmount(string s)
    {
        long v = constant(s);
        if (v < 0 || v > 31)
            throw bad(format("shift amount %s is out of range 0..31", v));
        return makeImm(v);
    }

    /// Jump target: a label (absolute address resolved by the linker) or a numeric address.
    AsmOperand jumpTarget(string s)
    {
        Imm im = parseImm(s);
        if (im.rk != RelocKind.None)
            throw bad("relocation operators are not allowed in jumps");
        if (im.label.length)
            return labelOperand(im, RelocKind.None);
        if ((im.v & 3) != 0)
            throw bad("jump address must be a multiple of 4");
        return makeImm(im.v);
    }

    /// Branch target: a label (offset computed by the linker) or a raw word offset.
    AsmOperand branchTarget(string s)
    {
        Imm im = parseImm(s);
        if (im.rk != RelocKind.None)
            throw bad("relocation operators are not allowed in branches");
        if (im.label.length)
            return labelOperand(im, RelocKind.None);
        return makeImm(im.v);
    }

    /*
     * Directives
     */

    void directive(string line)
    {
        size_t i = 1;
        while (i < line.length && isLabelChar(line[i]) && line[i] != '$')
            i++;
        string name = line[1 .. i].toLower;
        string rest = line[i .. $].strip;

        switch (name)
        {
            case "text":
                inData = false;
                if (!textLabelDefined)
                {
                    textLabelDefined = true;
                    defineLabel(".text");
                }
                return;

            case "data":
                inData = true;
                curEntry = -1;
                return;

            case "globl", "global", "extern", "option", "ent", "end_":
                return;

            case "equ":
            case "set":
            {
                string[] a = splitOperands(rest);
                if (name == "set" && a.length == 1)
                {
                    string f = a[0].toLower;
                    if (f == "noat" || f == "at" || f == "noreorder" || f == "reorder"
                        || f == "macro" || f == "nomacro" || f == "bopt" || f == "nobopt")
                        return;
                }
                if (a.length != 2)
                    throw bad("." ~ name ~ " expects \"name, value\"");
                if (a[0].length == 0 || !isLabelStart(a[0][0]))
                    throw bad("invalid constant name \"" ~ a[0] ~ "\"");
                equs[a[0]] = constant(a[1]);
                return;
            }

            case "word", "long":
                words(splitOperands(rest));
                return;

            case "half", "short", "hword":
                dataValues(splitOperands(rest), 2, name);
                return;

            case "byte":
                dataValues(splitOperands(rest), 1, name);
                return;

            case "ascii":
                strings(rest, false);
                return;

            case "asciiz", "string":
                strings(rest, true);
                return;

            case "space", "skip", "zero":
            {
                string[] a = splitOperands(rest);
                needRange("." ~ name, a, 1, 2);
                long n = constant(a[0]);
                long fill = a.length > 1 ? constant(a[1]) : 0;
                if (n < 0 || n > 0x1000000)
                    throw bad("invalid size for ." ~ name);
                if (!inData)
                {
                    if (n % 4 != 0)
                        throw bad("." ~ name ~ " in .text must be a multiple of 4 bytes");
                    foreach (k; 0 .. n / 4)
                    {
                        uint w = cast(uint)((fill & 0xFF) * 0x01010101);
                        output ~= AsmInstr(Op.WORD, AsmOperand.init, AsmOperand.init, AsmOperand.init, lineNum, [cast(Word)w]);
                    }
                    return;
                }
                ubyte[] b = new ubyte[cast(size_t)n];
                b[] = cast(ubyte)fill;
                dataBytes(b);
                return;
            }

            case "align":
            case "balign":
            {
                string[] a = splitOperands(rest);
                need("." ~ name, a, 1);
                long n = constant(a[0]);
                long bytes;
                if (name == "align")
                {
                    if (n < 0 || n > 12)
                        throw bad("invalid alignment");
                    bytes = 1L << n;
                }
                else
                {
                    bytes = n;
                    if (bytes <= 0 || (bytes & (bytes - 1)) != 0)
                        throw bad(".balign needs a power of two");
                }
                if (!inData)
                {
                    if (bytes <= 4)
                        return; // code is always word aligned
                    throw bad("." ~ name ~ " larger than 4 bytes is not supported in .text");
                }
                requireEntry();
                size_t len = dataEntries[curEntry].data.length;
                size_t pad = (cast(size_t)bytes - len % cast(size_t)bytes) % cast(size_t)bytes;
                dataBytes(new ubyte[pad]);
                return;
            }

            default:
                break;
        }

        // Legacy code label written as ".name" without a colon
        if (rest.length == 0 && !inData)
        {
            defineLabel(line);
            return;
        }
        throw bad("unknown directive \"." ~ name ~ "\"");
    }

    void requireEntry()
    {
        if (!inData)
            throw bad("this directive is only valid in the .data section");
        if (curEntry < 0)
            throw bad("data without a label (put a \"name:\" before it)");
    }

    void dataBytes(const(ubyte)[] b)
    {
        requireEntry();
        dataEntries[curEntry].data ~= b;
    }

    void legacyString(string line)
    {
        strings(line, false);
    }

    void strings(string rest, bool zero)
    {
        requireEntry();
        size_t i = 0;
        bool any = false;
        while (i < rest.length)
        {
            while (i < rest.length && (isWhite(rest[i]) || rest[i] == ','))
                i++;
            if (i >= rest.length)
                break;
            if (rest[i] != '"')
                throw bad("string literal expected");
            size_t start = ++i;
            while (i < rest.length && rest[i] != '"')
            {
                if (rest[i] == '\\')
                    i++;
                i++;
            }
            if (i >= rest.length)
                throw bad("unterminated string literal");
            ubyte[] b = parseEscapes(rest[start .. i]);
            i++;
            dataBytes(b);
            if (zero)
                dataBytes([cast(ubyte)0]);
            any = true;
        }
        if (!any)
            throw bad("string literal expected");
    }

    void dataValues(string[] a, int size, string name)
    {
        requireEntry();
        if (a.length == 0)
            throw bad("." ~ name ~ " needs at least one value");
        foreach (s; a)
        {
            long v = constant(s);
            long lo = size == 1 ? -128 : -32768;
            long hi = size == 1 ? 255 : 65535;
            if (v < lo || v > hi)
                throw bad(format("value %s does not fit in %s byte(s)", v, size));
            ubyte[] b;
            foreach (k; 0 .. size)
                b ~= cast(ubyte)((v >> (8 * k)) & 0xFF);
            dataBytes(b);
        }
    }

    /// .word / word
    void words(string[] a)
    {
        if (a.length == 0)
            throw bad("\".word\" needs at least one value");
        foreach (s; a)
        {
            Imm im = parseImm(s);
            if (im.rk != RelocKind.None)
                throw bad("relocation operators are not allowed in .word");

            if (inData)
            {
                requireEntry();
                if (im.label.length)
                {
                    dataEntries[curEntry].relocs ~= DataReloc(dataEntries[curEntry].data.length, im.label, im.v);
                    dataBytes(new ubyte[4]);
                }
                else
                {
                    if (im.v < -2147483648L || im.v > 0xFFFFFFFFL)
                        throw bad(format("value %s does not fit in 32 bits", im.v));
                    uint w = cast(uint)im.v;
                    dataBytes([cast(ubyte)w, cast(ubyte)(w >> 8), cast(ubyte)(w >> 16), cast(ubyte)(w >> 24)]);
                }
            }
            else if (im.label.length)
            {
                output ~= AsmInstr(Op.WORD, labelOperand(im, RelocKind.None), AsmOperand.init, AsmOperand.init, lineNum, [cast(Word)0]);
            }
            else
            {
                if (im.v < -2147483648L || im.v > 0xFFFFFFFFL)
                    throw bad(format("value %s does not fit in 32 bits", im.v));
                output ~= AsmInstr(Op.WORD, AsmOperand.init, AsmOperand.init, AsmOperand.init, lineNum, [cast(Word)cast(uint)im.v]);
            }
        }
    }

    /*
     * Instructions
     */

    void instruction(string line)
    {
        size_t i = 0;
        while (i < line.length && !isWhite(line[i]))
            i++;
        string mn = line[0 .. i].toLower;
        string[] args = splitOperands(line[i .. $]);

        if (mn == "word")
        {
            words(args);
            return;
        }

        if (inData)
            throw bad("instruction \"" ~ mn ~ "\" is not allowed in the .data section");

        switch (mn)
        {
            case "nop":
                need(mn, args, 0);
                emit(Op.NOP);
                break;

            // Arithmetic and logic: register or immediate third operand
            case "add":   alu3(args, mn, Op.ADD,  Op.ADDI,  false); break;
            case "addu":  alu3(args, mn, Op.ADDU, Op.ADDIU, false); break;
            case "sub":   alu3(args, mn, Op.SUB,  Op.ADDI,  true);  break;
            case "subu":  alu3(args, mn, Op.SUBU, Op.ADDIU, true);  break;
            case "and":   alu3(args, mn, Op.AND,  Op.ANDI,  false); break;
            case "or":    alu3(args, mn, Op.OR,   Op.ORI,   false); break;
            case "xor":   alu3(args, mn, Op.XOR,  Op.XORI,  false); break;
            case "nor":   alu3(args, mn, Op.NOR,  Op.NOP,   false); break;
            case "slt":   alu3(args, mn, Op.SLT,  Op.SLTI,  false); break;
            case "sltu":  alu3(args, mn, Op.SLTU, Op.SLTIU, false); break;

            case "addi":  rri(args, mn, Op.ADDI,  false); break;
            case "addiu": rri(args, mn, Op.ADDIU, false); break;
            case "subi":  rri(args, mn, Op.ADDI,  true);  break;
            case "subiu": rri(args, mn, Op.ADDIU, true);  break;
            case "andi":  rri(args, mn, Op.ANDI,  false); break;
            case "ori":   rri(args, mn, Op.ORI,   false); break;
            case "xori":  rri(args, mn, Op.XORI,  false); break;
            case "slti":  rri(args, mn, Op.SLTI,  false); break;
            case "sltiu": rri(args, mn, Op.SLTIU, false); break;

            case "sll":  shift(args, mn, Op.SLL, Op.SLLV); break;
            case "srl":  shift(args, mn, Op.SRL, Op.SRLV); break;
            case "sra":  shift(args, mn, Op.SRA, Op.SRAV); break;
            case "sllv": rrr(args, mn, Op.SLLV); break;
            case "srlv": rrr(args, mn, Op.SRLV); break;
            case "srav": rrr(args, mn, Op.SRAV); break;

            case "lui":
                need(mn, args, 2);
                emit(Op.LUI, R(args[0]), imm16(args[1]));
                break;

            // Multiply / divide
            case "mult":  rsrt(args, mn, Op.MULT); break;
            case "multu": rsrt(args, mn, Op.MULTU); break;
            case "div":
                if (args.length == 3)
                    mulDiv3(args, mn, Op.DIV, false);
                else
                    rsrt(args, mn, Op.DIV);
                break;
            case "divu":
                if (args.length == 3)
                    mulDiv3(args, mn, Op.DIVU, false);
                else
                    rsrt(args, mn, Op.DIVU);
                break;
            case "mul":  mulDiv3(args, mn, Op.MULT, false); break;
            case "rem":  mulDiv3(args, mn, Op.DIV,  true);  break;
            case "remu": mulDiv3(args, mn, Op.DIVU, true);  break;

            case "mfhi": need(mn, args, 1); emit(Op.MFHI, R(args[0])); break;
            case "mflo": need(mn, args, 1); emit(Op.MFLO, R(args[0])); break;
            case "mthi": need(mn, args, 1); emit(Op.MTHI, R(args[0])); break;
            case "mtlo": need(mn, args, 1); emit(Op.MTLO, R(args[0])); break;

            // Register moves
            case "move":  need(mn, args, 2); emit(Op.MOVE, R(args[0]), R(args[1])); break;
            case "clear": need(mn, args, 1); emit(Op.CLEAR, R(args[0])); break;
            case "neg":   need(mn, args, 2); emit(Op.NEG, R(args[0]), R(args[1])); break;
            case "negu":  need(mn, args, 2); emit(Op.SUBU, R(args[0]), makeReg(R0), R(args[1])); break;
            case "not":   need(mn, args, 2); emit(Op.NOT, R(args[0]), R(args[1])); break;

            case "li":
            case "la":
            {
                need(mn, args, 2);
                Imm im = parseImm(args[1]);
                if (im.rk != RelocKind.None)
                    throw bad("\"" ~ mn ~ "\" takes a full value, not %hi/%lo (use lui/ori)");
                if (im.label.length)
                    emit(Op.LI, R(args[0]), labelOperand(im, RelocKind.None));
                else
                {
                    if (im.v < -2147483648L || im.v > 0xFFFFFFFFL)
                        throw bad(format("value %s does not fit in 32 bits", im.v));
                    emit(Op.LI, R(args[0]), makeImm(im.v));
                }
                break;
            }

            // Comparison pseudoinstructions
            case "seq":
                need(mn, args, 3);
                emit(Op.XOR, R(args[0]), R(args[1]), R(args[2]));
                emit(Op.SLTIU, R(args[0]), R(args[0]), makeImm(1));
                break;
            case "sne":
                need(mn, args, 3);
                emit(Op.XOR, R(args[0]), R(args[1]), R(args[2]));
                emit(Op.SLTU, R(args[0]), makeReg(R0), R(args[0]));
                break;
            case "sgt":  setCmp(args, mn, Op.SLT,  true,  false); break;
            case "sgtu": setCmp(args, mn, Op.SLTU, true,  false); break;
            case "sge":  setCmp(args, mn, Op.SLT,  false, true);  break;
            case "sgeu": setCmp(args, mn, Op.SLTU, false, true);  break;
            case "sle":  setCmp(args, mn, Op.SLT,  true,  true);  break;
            case "sleu": setCmp(args, mn, Op.SLTU, true,  true);  break;

            // Jumps
            case "j":
                need(mn, args, 1);
                emit(Op.J, jumpTarget(args[0]));
                break;
            case "jal":
                need(mn, args, 1);
                emit(Op.JAL, jumpTarget(args[0]));
                break;
            case "jr":
                need(mn, args, 1);
                emit(Op.JR, R(args[0]));
                break;
            case "jalr":
                needRange(mn, args, 1, 2);
                if (args.length == 1)
                    emit(Op.JALR, makeReg(RA), R(args[0]));
                else
                    emit(Op.JALR, R(args[0]), R(args[1]));
                break;

            // Branches
            case "beq":
            case "bne":
                need(mn, args, 3);
                emit(mn == "beq" ? Op.BEQ : Op.BNE, R(args[0]), R(args[1]), branchTarget(args[2]));
                break;
            case "beqz":
            case "bnez":
                need(mn, args, 2);
                emit(mn == "beqz" ? Op.BEQ : Op.BNE, R(args[0]), makeReg(R0), branchTarget(args[1]));
                break;
            case "b":
                need(mn, args, 1);
                emit(Op.BEQ, makeReg(R0), makeReg(R0), branchTarget(args[0]));
                break;
            case "bal":
                need(mn, args, 1);
                emit(Op.BGEZAL, makeReg(R0), branchTarget(args[0]));
                break;
            case "blez": branch1(args, mn, Op.BLEZ); break;
            case "bgtz": branch1(args, mn, Op.BGTZ); break;
            case "bgez": branch1(args, mn, Op.BGEZ); break;
            case "bltz": branch1(args, mn, Op.BLTZ); break;
            case "bgezal": branch1(args, mn, Op.BGEZAL); break;
            case "bltzal": branch1(args, mn, Op.BLTZAL); break;

            case "blt":  cmpBranch(args, mn, false, false, true);  break;
            case "bge":  cmpBranch(args, mn, false, false, false); break;
            case "bgt":  cmpBranch(args, mn, false, true,  true);  break;
            case "ble":  cmpBranch(args, mn, false, true,  false); break;
            case "bltu": cmpBranch(args, mn, true,  false, true);  break;
            case "bgeu": cmpBranch(args, mn, true,  false, false); break;
            case "bgtu": cmpBranch(args, mn, true,  true,  true);  break;
            case "bleu": cmpBranch(args, mn, true,  true,  false); break;

            // Memory
            case "lw":  memOp(args, mn, Op.LW,  0, true);  break;
            case "lh":  memOp(args, mn, Op.LH,  0, true);  break;
            case "lhu": memOp(args, mn, Op.LHU, 0, true);  break;
            case "lb":  memOp(args, mn, Op.LB,  0, true);  break;
            case "lbu": memOp(args, mn, Op.LBU, 0, true);  break;
            case "lwl": memOp(args, mn, Op.LWL, 0, false); break;
            case "lwr": memOp(args, mn, Op.LWR, 0, false); break;
            case "sw":  memOp(args, mn, Op.SW,  0, false); break;
            case "sh":  memOp(args, mn, Op.SH,  0, false); break;
            case "sb":  memOp(args, mn, Op.SB,  0, false); break;
            case "swl": memOp(args, mn, Op.SWL, 0, false); break;
            case "swr": memOp(args, mn, Op.SWR, 0, false); break;
            case "lwc0": memOp(args, mn, Op.LWC0, 1, false); break;
            case "swc0": memOp(args, mn, Op.SWC0, 1, false); break;
            case "lwc2": memOp(args, mn, Op.LWC2, 2, false); break;
            case "swc2": memOp(args, mn, Op.SWC2, 2, false); break;

            // System
            case "syscall":
            case "break":
            {
                needRange(mn, args, 0, 1);
                long code = args.length ? constant(args[0]) : 0;
                if (code < 0 || code > 0xFFFFF)
                    throw bad("code is out of range 0..0xFFFFF");
                emit(mn == "syscall" ? Op.SYSCALL : Op.BREAK, makeImm(code));
                break;
            }

            // COP0
            case "mfc0": need(mn, args, 2); emit(Op.MFC0, R(args[0]), makeRegCop0(getCop0(args[1]))); break;
            case "mtc0": need(mn, args, 2); emit(Op.MTC0, R(args[0]), makeRegCop0(getCop0(args[1]))); break;
            case "cfc0": need(mn, args, 2); emit(Op.CFC0, R(args[0]), makeRegCop0(getCop0(args[1]))); break;
            case "ctc0": need(mn, args, 2); emit(Op.CTC0, R(args[0]), makeRegCop0(getCop0(args[1]))); break;
            case "rfe":  need(mn, args, 0); emit(Op.RFE); break;
            case "cop0": copCommand(args, mn, Op.COP0); break;
            case "bc0f": need(mn, args, 1); emit(Op.BC0F, branchTarget(args[0])); break;
            case "bc0t": need(mn, args, 1); emit(Op.BC0T, branchTarget(args[0])); break;

            // COP2 / GTE
            case "mfc2": need(mn, args, 2); emit(Op.MFC2, R(args[0]), makeRegGteData(getGteData(args[1]))); break;
            case "mtc2": need(mn, args, 2); emit(Op.MTC2, R(args[0]), makeRegGteData(getGteData(args[1]))); break;
            case "cfc2": need(mn, args, 2); emit(Op.CFC2, R(args[0]), makeRegGteControl(getGteCtrl(args[1]))); break;
            case "ctc2": need(mn, args, 2); emit(Op.CTC2, R(args[0]), makeRegGteControl(getGteCtrl(args[1]))); break;
            case "cop2": copCommand(args, mn, Op.COP2); break;
            case "bc2f": need(mn, args, 1); emit(Op.BC2F, branchTarget(args[0])); break;
            case "bc2t": need(mn, args, 1); emit(Op.BC2T, branchTarget(args[0])); break;

            case "mvmva":
            {
                // mvmva            (all fields zero)
                // mvmva sf, mx, v, cv, lm
                if (args.length == 0)
                {
                    emit(Op.MVMVA);
                    break;
                }
                need(mn, args, 5);
                long sf = constant(args[0]);
                long mx = constant(args[1]);
                long v  = constant(args[2]);
                long cv = constant(args[3]);
                long lm = constant(args[4]);
                if (sf < 0 || sf > 1 || mx < 0 || mx > 3 || v < 0 || v > 3 || cv < 0 || cv > 3 || lm < 0 || lm > 1)
                    throw bad("mvmva field out of range (sf 0..1, mx 0..3, v 0..3, cv 0..3, lm 0..1)");
                emit(Op.MVMVA, makeImm((sf << 19) | (mx << 17) | (v << 15) | (cv << 13) | (lm << 10)));
                break;
            }

            case "rtps":  gteCmd(args, mn, Op.RTPS);  break;
            case "rtpt":  gteCmd(args, mn, Op.RTPT);  break;
            case "dcpl":  gteCmd(args, mn, Op.DCPL);  break;
            case "dpcs":  gteCmd(args, mn, Op.DPCS);  break;
            case "dpct":  gteCmd(args, mn, Op.DPCT);  break;
            case "intpl": gteCmd(args, mn, Op.INTPL); break;
            case "sqr":   gteCmd(args, mn, Op.SQR);   break;
            case "ncs":   gteCmd(args, mn, Op.NCS);   break;
            case "nct":   gteCmd(args, mn, Op.NCT);   break;
            case "ncds":  gteCmd(args, mn, Op.NCDS);  break;
            case "ncdt":  gteCmd(args, mn, Op.NCDT);  break;
            case "nccs":  gteCmd(args, mn, Op.NCCS);  break;
            case "ncct":  gteCmd(args, mn, Op.NCCT);  break;
            case "cdp":   gteCmd(args, mn, Op.CDP);   break;
            case "cc":    gteCmd(args, mn, Op.CC);    break;
            case "nclip": gteCmd(args, mn, Op.NCLIP); break;
            case "avsz3": gteCmd(args, mn, Op.AVSZ3); break;
            case "avsz4": gteCmd(args, mn, Op.AVSZ4); break;
            case "op":    gteCmd(args, mn, Op.OP);    break;
            case "gpf":   gteCmd(args, mn, Op.GPF);   break;
            case "gpl":   gteCmd(args, mn, Op.GPL);   break;

            default:
                throw bad("unknown instruction \"" ~ mn ~ "\"");
        }
    }

    void alu3(string[] args, string mn, Op regOp, Op immOp, bool negate)
    {
        need(mn, args, 3);
        if (looksLikeReg(args[2]))
        {
            emit(regOp, R(args[0]), R(args[1]), R(args[2]));
            return;
        }
        if (immOp == Op.NOP)
            throw bad("\"" ~ mn ~ "\" has no immediate form");
        emit(immOp, R(args[0]), R(args[1]), imm16(args[2], negate));
    }

    void rri(string[] args, string mn, Op op, bool negate)
    {
        need(mn, args, 3);
        emit(op, R(args[0]), R(args[1]), imm16(args[2], negate));
    }

    void rrr(string[] args, string mn, Op op)
    {
        need(mn, args, 3);
        emit(op, R(args[0]), R(args[1]), R(args[2]));
    }

    void rsrt(string[] args, string mn, Op op)
    {
        need(mn, args, 2);
        emit(op, R(args[0]), R(args[1]));
    }

    void shift(string[] args, string mn, Op immOp, Op regOp)
    {
        need(mn, args, 3);
        if (looksLikeReg(args[2]))
            emit(regOp, R(args[0]), R(args[1]), R(args[2]));
        else
            emit(immOp, R(args[0]), R(args[1]), shiftAmount(args[2]));
    }

    /// mul / div / rem with three operands: op rs, rt  then mflo/mfhi rd
    void mulDiv3(string[] args, string mn, Op op, bool useHi)
    {
        need(mn, args, 3);
        Reg rd = getReg(args[0]);
        Reg rs = getReg(args[1]);
        Reg rt;
        if (looksLikeReg(args[2]))
            rt = getReg(args[2]);
        else
        {
            emit(Op.LI, makeReg(AT), makeImm(constant(args[2])));
            rt = AT;
        }
        emit(op, makeReg(rs), makeReg(rt));
        emit(useHi ? Op.MFHI : Op.MFLO, makeReg(rd));
    }

    void setCmp(string[] args, string mn, Op slt, bool swap, bool invert)
    {
        need(mn, args, 3);
        Reg rd = getReg(args[0]);
        Reg a = getReg(args[1]);
        Reg b = getReg(args[2]);
        if (swap)
            emit(slt, makeReg(rd), makeReg(b), makeReg(a));
        else
            emit(slt, makeReg(rd), makeReg(a), makeReg(b));
        if (invert)
            emit(Op.XORI, makeReg(rd), makeReg(rd), makeImm(1));
    }

    void branch1(string[] args, string mn, Op op)
    {
        need(mn, args, 2);
        emit(op, R(args[0]), branchTarget(args[1]));
    }

    /**
     * blt/bge/bgt/ble and unsigned variants: slt into $at, then bne/beq.
     * swap: operands of slt are swapped (bgt, ble). branchIfSet: use bne (blt, bgt), else beq.
     */
    void cmpBranch(string[] args, string mn, bool uns, bool swap, bool branchIfSet)
    {
        need(mn, args, 3);
        Reg rs = getReg(args[0]);
        AsmOperand tgt = branchTarget(args[2]);
        Op slt = uns ? Op.SLTU : Op.SLT;
        Op br = branchIfSet ? Op.BNE : Op.BEQ;
        Reg rt;

        if (looksLikeReg(args[1]))
            rt = getReg(args[1]);
        else
        {
            long v = constant(args[1]);
            if (!swap && v >= -32768 && v <= 32767)
            {
                emit(uns ? Op.SLTIU : Op.SLTI, makeReg(AT), makeReg(rs), makeImm(v));
                emit(br, makeReg(AT), makeReg(R0), tgt);
                return;
            }
            if (v < -2147483648L || v > 0xFFFFFFFFL)
                throw bad(format("value %s does not fit in 32 bits", v));
            emit(Op.LI, makeReg(AT), makeImm(v));
            rt = AT;
        }

        if (swap)
            emit(slt, makeReg(AT), makeReg(rt), makeReg(rs));
        else
            emit(slt, makeReg(AT), makeReg(rs), makeReg(rt));
        emit(br, makeReg(AT), makeReg(R0), tgt);
    }

    void copCommand(string[] args, string mn, Op op)
    {
        need(mn, args, 1);
        long c = constant(args[0]);
        if (c < 0 || c > 0x1FFFFFF)
            throw bad("coprocessor command is out of range");
        emit(op, makeImm(c));
    }

    void gteCmd(string[] args, string mn, Op op)
    {
        need(mn, args, 0);
        emit(op);
    }

    /**
     * Load / store.  kind: 0 = CPU register, 1 = COP0 register, 2 = GTE data register.
     * rtAsTemp: for loads of a CPU register the destination can hold the intermediate address.
     */
    void memOp(string[] args, string mn, Op op, int kind, bool rtAsTemp)
    {
        string offStr = "";
        string baseStr = "";
        bool hasBase = false;

        if (args.length == 3)
        {
            // legacy: rt, off, base
            offStr = args[1];
            baseStr = args[2];
            hasBase = true;
        }
        else if (args.length == 2)
        {
            string m = args[1];
            if (m.length && m[$ - 1] == ')')
            {
                int depth = 0;
                size_t open = size_t.max;
                for (size_t k = m.length; k-- > 0;)
                {
                    if (m[k] == ')')
                        depth++;
                    else if (m[k] == '(')
                    {
                        depth--;
                        if (depth == 0)
                        {
                            open = k;
                            break;
                        }
                    }
                }
                if (open == size_t.max)
                    throw bad("unbalanced parentheses in \"" ~ m ~ "\"");
                offStr = m[0 .. open].strip;
                baseStr = m[open + 1 .. $ - 1].strip;
                hasBase = true;
            }
            else
                offStr = m;
        }
        else
            throw bad(format("\"%s\" expects 2 operands but %s given", mn, args.length));

        AsmOperand makeRt()
        {
            if (kind == 1)
                return makeRegCop0(getCop0(args[0]));
            if (kind == 2)
                return makeRegGteData(getGteData(args[0]));
            return R(args[0]);
        }

        Imm im = parseImm(offStr.length ? offStr : "0");

        if (hasBase)
        {
            Reg base = getReg(baseStr);
            AsmOperand off;
            if (im.label.length)
            {
                if (im.rk == RelocKind.None)
                    throw bad("a label offset needs %lo(label)");
                off = labelOperand(im, im.rk);
            }
            else
            {
                if (im.v < -32768 || im.v > 32767)
                    throw bad(format("offset %s does not fit in 16 bits", im.v));
                off = makeImm(im.v);
            }
            emit(op, makeRt(), off, makeReg(base));
            return;
        }

        // No base register: absolute address or label
        if (im.rk != RelocKind.None)
            throw bad("%hi/%lo needs a base register, e.g. %lo(label)($at)");

        Reg tmp = AT;
        if (rtAsTemp && kind == 0)
        {
            Reg rt = getReg(args[0]);
            if (rt != R0)
                tmp = rt;
        }

        if (im.label.length == 0)
        {
            if (im.v >= -32768 && im.v <= 32767)
            {
                emit(op, makeRt(), makeImm(im.v), makeReg(R0));
                return;
            }
            long a = im.v & 0xFFFFFFFFL;
            emit(Op.LUI, makeReg(tmp), makeImm(hiOf(a)));
            emit(op, makeRt(), makeImm(loOf(a)), makeReg(tmp));
            return;
        }

        emit(Op.LUI, makeReg(tmp), labelOperand(im, RelocKind.Hi));
        emit(op, makeRt(), labelOperand(im, RelocKind.Lo), makeReg(tmp));
    }
}

/**
 * Translates an assembly text to Assembly object filled with IR opcodes, labels and data entries.
 * If used in a broad context (e.g., with a compiler), unique `labelPrefix` should be provided
 * to avoid label collisions across multiple files.
 * `instrIndexStart` is a global index of the first IR opcode. It should be 0 if the program
 * consists of a single assembly, otherwise the index at which the assembly is inserted into the program.
 */
Assembly assemble(string code, string filename, string labelPrefix = "", size_t instrIndexStart = 0)
{
    auto a = new Asm(filename, labelPrefix, instrIndexStart);
    a.run(code);
    return a.result();
}
