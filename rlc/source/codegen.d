    /*
     * Emission helpers
     */

    void emit(Op op, AsmOperand a, AsmOperand b, AsmOperand c)
    {
        cur ~= AsmInstr(op, a, b, c, cast(size_t)curLine);
    }

    void rrr(Op op, Reg d, Reg s, Reg t)
    {
        emit(op, makeReg(d), makeReg(s), makeReg(t));
    }

    void rri(Op op, Reg d, Reg s, long imm)
    {
        emit(op, makeReg(d), makeReg(s), makeImm(imm));
    }

    void mem(Op op, Reg rt, long off, Reg base)
    {
        emit(op, makeReg(rt), makeImm(off), makeReg(base));
    }

    void nop()
    {
        emit(Op.NOP, makeNone(), makeNone(), makeNone());
    }

    void move(Reg d, Reg s)
    {
        if (d != s)
            emit(Op.MOVE, makeReg(d), makeReg(s), makeNone());
    }

    void li(Reg d, long v)
    {
        emit(Op.LI, makeReg(d), makeImm(v), makeNone());
    }

    void liLabel(Reg d, string label)
    {
        emit(Op.LI, makeReg(d), makeLabel(label), makeNone());
    }

    void jump(string label)
    {
        emit(Op.J, makeLabel(label), makeNone(), makeNone());
        nop();
    }

    void branch2(Op op, Reg a, Reg b, string label)
    {
        emit(op, makeReg(a), makeReg(b), makeLabel(label));
        nop();
    }

    void branch1(Op op, Reg a, string label)
    {
        emit(op, makeReg(a), makeLabel(label), makeNone());
        nop();
    }

    void emitLoad(CType ty, Reg rt, long off, Reg base)
    {
        int sz = ty.size();
        Op lop = Op.LW;
        if (sz == 2)
            lop = ty.uns ? Op.LHU : Op.LH;
        else if (sz == 1)
            lop = ty.uns ? Op.LBU : Op.LB;
        mem(lop, rt, off, base);
        nop(); // load delay slot
    }

    void emitStore(CType ty, Reg rt, long off, Reg base)
    {
        int sz = ty.size();
        mem(sz == 4 ? Op.SW : (sz == 2 ? Op.SH : Op.SB), rt, off, base);
    }

    /// Sign-extends a register holding a char / short variable.
    void narrowReg(Reg r, CType ty)
    {
        if (ty.isPtr)
            return;
        if (ty.base == Base.Char)
        {
            if (ty.uns)
            {
                rri(Op.ANDI, r, r, 0xFF);
            }
            else
            {
                rri(Op.SLL, r, r, 24);
                rri(Op.SRA, r, r, 24);
            }
        }
        else if (ty.base == Base.Short)
        {
            if (ty.uns)
            {
                rri(Op.ANDI, r, r, 0xFFFF);
            }
            else
            {
                rri(Op.SLL, r, r, 16);
                rri(Op.SRA, r, r, 16);
            }
        }
    }

    string newLabel()
    {
        return format("L%s", labelCounter++);
    }

    void placeLabel(string name)
    {
        curLbls ~= Lbl(name, cur.length);
    }
    
