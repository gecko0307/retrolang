    /*
     * Temporaries
     */

    Reg allocTemp()
    {
        if (td >= NTEMPS)
            throw err(curFile, curLine, "expression too complex (out of temporary registers)");
        return tempRegs[td++];
    }

    void release(Val v)
    {
        if (v.isTemp)
            td--;
    }

    /// Destination for a fresh result: the requested register, or a new temporary.
    Val dest0(int want)
    {
        if (want >= 0)
            return Val(cast(Reg) want, false);
        return Val(allocTemp(), true);
    }

    /**
     * Release operands (LIFO), then pick a destination.
     * A released temporary is naturally reused as the destination.
     */
    Val dest1(int want, Val a)
    {
        release(a);
        return dest0(want);
    }

    Val dest2(int want, Val a, Val b)
    {
        release(b);
        release(a);
        return dest0(want);
    }

    /*
     * Symbols
     */

    void pushScope()
    {
        Var[string] m;
        scopes ~= m;
        savedS ~= nextS;
    }

    void popScope()
    {
        scopes = scopes[0..$-1];
        nextS = savedS[$ - 1];
        savedS = savedS[0..$-1];
    }

    Var lookup(string name, string file, int line)
    {
        foreach_reverse (ref sc; scopes)
        {
            if (auto p = name in sc)
                return *p;
        }
        if (auto p = name in globals)
            return *p;
        throw err(file, line, "undefined variable \"" ~ name ~ "\"");
    }

    int allocStack(int bytes)
    {
        int off = localsTop;
        localsTop += (bytes + 3) & ~3;
        if (localsTop > 32000)
            throw err(curFile, curLine, "stack frame too large");
        return off;
    }

    Var declareLocal(string name, CType ty, int arrLen, string file, int line)
    {
        if (name in scopes[$ - 1])
            throw err(file, line, "redeclaration of \"" ~ name ~ "\"");
        if (ty.base == Base.Void && ty.ptr == 0)
            throw err(file, line, "variable \"" ~ name ~ "\" cannot have type \"void\"");

        auto v = new Var();
        v.name = name;
        v.ty = ty;
        if (arrLen >= 0)
        {
            v.isArray = true;
            v.arrLen = arrLen;
            v.st = Storage.InStack;
            v.offset = allocStack(arrLen * ty.size());
        }
        else if (isStructVal(ty))
        {
            v.st = Storage.InStack;
            v.offset = allocStack(ty.size());
        }
        else if ((name in addrTaken) || nextS >= 8)
        {
            v.st = Storage.InStack;
            v.offset = allocStack(4);
        }
        else
        {
            v.st = Storage.InReg;
            v.reg = sRegs[nextS++];
            if (nextS > maxS)
                maxS = nextS;
        }
        scopes[$ - 1][name] = v;
        return v;
    }

    string internString(string raw)
    {
        if (auto p = raw in strPool)
            return *p;
        string label = format("str_%s", strCounter++);
        ass.dataEntries ~= AsmDataEntry(label, parseEscapes(raw) ~ cast(ubyte) 0);
        strPool[raw] = label;
        return label;
    }

    /*
     * Types of expressions
     */

    CType typeOf(Expr e)
    {
        switch (e.kind)
        {
            case EK.Num:
                return CType(Base.Int, 0, e.uns);

            case EK.Str:
                return CType(Base.Char, 1);

            case EK.Var:
            {
                Var v = lookup(e.name, e.file, e.line);
                CType t = v.ty;
                if (v.isArray)
                    t.ptr++;
                return t;
            }

            case EK.Unary:
            {
                if (e.op == "*")
                {
                    CType t = typeOf(e.a);
                    if (!t.isPtr)
                        throw err(e.file, e.line, "cannot dereference a non-pointer");
                    return t.deref();
                }
                if (e.op == "&")
                {
                    if (e.a.kind == EK.Var && lookup(e.a.name, e.a.file, e.a.line).isArray)
                        return typeOf(e.a);
                    if (e.a.kind == EK.Member && memberField(e.a).isArray)
                        return typeOf(e.a);
                    return typeOf(e.a).addr();
                }
                if (e.op == "!")
                    return CType(Base.Int, 0);
                // - and ~ : promoted operand type
                return isUint(typeOf(e.a)) ? CType(Base.Int, 0, true) : CType(Base.Int, 0);
            }

            case EK.Binary:
            {
                CType lt = typeOf(e.a);
                CType rt = typeOf(e.b);
                if (e.op == "+")
                {
                    if (lt.isPtr && !rt.isPtr) return lt;
                    if (rt.isPtr && !lt.isPtr) return rt;
                }
                else if (e.op == "-")
                {
                    if (lt.isPtr && !rt.isPtr) return lt;
                }
                if (inList(e.op, ["==", "!=", "<", "<=", ">", ">=", "&&", "||"]))
                    return CType(Base.Int, 0);
                if (e.op == "<<" || e.op == ">>")
                    return isUint(lt) ? CType(Base.Int, 0, true) : CType(Base.Int, 0);
                return (isUint(lt) || isUint(rt)) ? CType(Base.Int, 0, true) : CType(Base.Int, 0);
            }

            case EK.Assign:
            case EK.IncDec:
                return typeOf(e.a);

            case EK.Call:
            {
                if (e.name == "bios_a" || e.name == "bios_b" || e.name == "bios_c")
                    return CType(Base.Int, 0);
                if (isIntrinsic(e.name))
                    return CType(Base.Int, 0);
                if (auto p = e.name in funcs)
                    return p.ret;
                throw err(e.file, e.line, "call to undefined function \"" ~ e.name ~ "\"");
            }

            case EK.Index:
            {
                CType t = typeOf(e.a);
                if (!t.isPtr)
                    throw err(e.file, e.line, "subscripted value is neither array nor pointer");
                return t.deref();
            }

            case EK.Member:
            {
                Field f = memberField(e);
                CType t = f.ty;
                if (f.isArray)
                    t.ptr++;
                return t;
            }

            case EK.Cast:
                return e.ty;

            default:
                assert(0);
        }
    }

    /*
     * Expressions
     */

    /// Resolves the field named by a Member expression.
    Field memberField(Expr e)
    {
        CType bt = typeOf(e.a);
        if (e.arrow)
        {
            if (!(bt.ptr == 1 && bt.base == Base.Struct))
                throw err(e.file, e.line, "\"->\" needs a pointer to a struct");
        }
        else
        {
            if (!isStructVal(bt))
                throw err(e.file, e.line, "\".\" needs a struct value (use \"->\" on pointers)");
        }
        StructDef sd = structDefs[bt.sname];
        foreach (f; sd.fields)
        {
            if (f.name == e.name)
                return f;
        }
        throw err(e.file, e.line, format("struct \"%s\" has no member \"%s\"", bt.sname, e.name));
    }

    /**
     * `want` is a hint: the result may be placed in that register.
     * Callers must check Val.r.
     */
    Val genExpr(Expr e, int want = -1)
    {
        curFile = e.file;
        curLine = e.line;

        long cv;
        if (e.kind != EK.Num && constEval(e, cv))
            return genConst(cv, want);

        switch (e.kind)
        {
            case EK.Num:
                return genConst(e.num, want);

            case EK.Str:
            {
                Val d = dest0(want);
                liLabel(d.r, internString(e.name));
                return d;
            }

            case EK.Var:    return genVar(e, want);
            case EK.Unary:  return genUnary(e, want);
            case EK.Binary: return genBinary(e, want);
            case EK.Assign: return genAssign(e, want, false);
            case EK.IncDec: return genIncDec(e, want, false);
            case EK.Call:
                if (isIntrinsic(e.name))
                    return genIntrinsicValue(e, want);
                return genCall(e, want, false);
            case EK.Cast:   return genCast(e, want);

            case EK.Member:
            {
                LValue lv = genLValue(e);
                if (lv.isArr)
                {
                    // array member decays to its address
                    Val da = dest1(want, Val(lv.reg, lv.tempAddr));
                    if (da.r != lv.reg || lv.off != 0)
                        rri(Op.ADDIU, da.r, lv.reg, lv.off);
                    return da;
                }
                return loadLV(lv, want, false);
            }

            case EK.Index:
            {
                LValue lv = genLValue(e);
                return loadLV(lv, want, false);
            }

            default:
                assert(0);
        }
    }

    Val genConst(long v, int want)
    {
        if (v == 0 && want < 0)
            return Val(R0, false);
        Val d = dest0(want);
        li(d.r, v);
        return d;
    }

    Val genVar(Expr e, int want)
    {
        Var v = lookup(e.name, e.file, e.line);
        if (v.isArray)
        {
            Val d = dest0(want);
            if (v.st == Storage.InStack)
                rri(Op.ADDIU, d.r, SP, v.offset);
            else
                liLabel(d.r, v.label);
            return d;
        }
        if (v.st == Storage.InReg)
            return Val(v.reg, false);
        LValue lv = genLValue(e);
        return loadLV(lv, want, false);
    }

    /*
     * lvalues
     */

    LValue genLValue(Expr e)
    {
        curFile = e.file;
        curLine = e.line;
        switch (e.kind)
        {
            case EK.Var:
            {
                Var v = lookup(e.name, e.file, e.line);
                if (v.isArray)
                    throw err(e.file, e.line, "cannot assign to array \"" ~ v.name ~ "\"");
                if (v.st == Storage.InReg)
                    return LValue(LK.RegVar, v.reg, 0, v.ty, false);
                if (v.st == Storage.InStack)
                    return LValue(LK.Mem, SP, v.offset, v.ty, false);
                Reg a = allocTemp();
                liLabel(a, v.label);
                return LValue(LK.Mem, a, 0, v.ty, true);
            }

            case EK.Unary:
            {
                if (e.op != "*")
                    throw err(e.file, e.line, "expression is not assignable");
                
                // *(T*)&x  and  *&x: reinterpret the location, no address computation
                {
                    Expr inner = e.a;
                    CType castTy;
                    bool hasCast = false;
                    if (inner.kind == EK.Cast && inner.ty.isPtr)
                    {
                        castTy = inner.ty;
                        hasCast = true;
                        inner = inner.a;
                    }
                    if (inner.kind == EK.Unary && inner.op == "&" && inner.a.kind != EK.Var)
                    {
                        LValue lv = genLValue(inner.a);
                        if (lv.kind != LK.Mem)
                            throw err(e.file, e.line, "cannot take the address of this expression");
                        CType t = hasCast ? castTy.deref() : lv.ty;
                        if (t.ptr == 0 && t.base == Base.Void)
                            throw err(e.file, e.line, "cannot dereference void*");
                        return LValue(LK.Mem, lv.reg, lv.off, t, lv.tempAddr);
                    }
                }
                
                CType pt = typeOf(e.a);
                if (!pt.isPtr)
                    throw err(e.file, e.line, "cannot dereference a non-pointer");
                CType et = pt.deref();
                if (et.ptr == 0 && et.base == Base.Void)
                    throw err(e.file, e.line, "cannot dereference void*");
                Val pv = genExpr(e.a);
                return LValue(LK.Mem, pv.r, 0, et, pv.isTemp);
            }

            /*
            case EK.Index:
            {
                CType bt = typeOf(e.a);
                if (!bt.isPtr)
                    throw err(e.file, e.line, "subscripted value is neither array nor pointer");
                CType et = bt.deref();
                if (et.ptr == 0 && et.base == Base.Void)
                    throw err(e.file, e.line, "cannot index void*");
                int esz = et.size();

                long ci;
                if (constEval(e.b, ci) && fits16(ci * esz))
                {
                    long off = ci * esz;
                    if (e.a.kind == EK.Var)
                    {
                        Var av = lookup(e.a.name, e.a.file, e.a.line);
                        if (av.isArray && av.st == Storage.InStack && fits16(av.offset + off))
                            return LValue(LK.Mem, SP, av.offset + off, et, false);
                    }
                    Val bv = genExpr(e.a);
                    return LValue(LK.Mem, bv.r, off, et, bv.isTemp);
                }

                Val basev = genExpr(e.a);
                Val idx = scaleVal(genExpr(e.b), esz);
                Val sum = dest2(-1, basev, idx);
                rrr(Op.ADDU, sum.r, basev.r, idx.r);
                return LValue(LK.Mem, sum.r, 0, et, true);
            }
            */
            
            case EK.Index:
            {
                CType bt = typeOf(e.a);
                if (!bt.isPtr)
                    throw err(e.file, e.line, "subscripted value is neither array nor pointer");
                CType et = bt.deref();
                if (et.ptr == 0 && et.base == Base.Void)
                    throw err(e.file, e.line, "cannot index void*");
                int esz = et.size();

                LValue base;
                bool haveBase = arrayLValue(e.a, base);

                // constant index
                long ci;
                if (constEval(e.b, ci) && fits16(ci * esz))
                {
                    long off = ci * esz;
                    if (haveBase && fits16(base.off + off))
                        return LValue(LK.Mem, base.reg, base.off + off, et, base.tempAddr);
                    if (haveBase)        // offset too large: materialize the address
                    {
                        Val bv2 = dest1(-1, Val(base.reg, base.tempAddr));
                        rri(Op.ADDIU, bv2.r, base.reg, base.off);   // may need li+addu for huge offsets
                        return LValue(LK.Mem, bv2.r, off, et, bv2.isTemp);
                    }
                    Val bv = genExpr(e.a);
                    return LValue(LK.Mem, bv.r, off, et, bv.isTemp);
                }

                // variable index: base + (idx << log2 esz), the array's own offset stays in the immediate
                if (haveBase && fits16(base.off))
                {
                    Val basev = Val(base.reg, base.tempAddr);
                    Val idx = scaleVal(genExpr(e.b), esz);
                    Val sum = dest2(-1, basev, idx);
                    rrr(Op.ADDU, sum.r, base.reg, idx.r);
                    return LValue(LK.Mem, sum.r, base.off, et, true);
                }

                Val basev = genExpr(e.a);
                Val idx = scaleVal(genExpr(e.b), esz);
                Val sum = dest2(-1, basev, idx);
                rrr(Op.ADDU, sum.r, basev.r, idx.r);
                return LValue(LK.Mem, sum.r, 0, et, true);
            }

            case EK.Member:
            {
                Field f = memberField(e);
                if (e.arrow)
                {
                    Val pv = genExpr(e.a);
                    LValue la = LValue(LK.Mem, pv.r, f.offset, f.ty, pv.isTemp);
                    la.isArr = f.isArray;
                    return la;
                }
                LValue blv = genLValue(e.a);
                if (blv.kind != LK.Mem)
                    throw err(e.file, e.line, "internal error: struct held in a register");
                if (!fits16(blv.off + f.offset))
                    throw err(e.file, e.line, "struct member offset too large");
                blv.off += f.offset;
                blv.ty = f.ty;
                blv.isArr = f.isArray;
                return blv;
            }

            default:
                throw err(e.file, e.line, "expression is not assignable");
        }
    }
    
    // If e names an array object in memory (local/global array, or an array-typed
    // struct member), returns its location without materializing a pointer.
    bool arrayLValue(Expr e, out LValue lv)
    {
        if (e.kind == EK.Var)
        {
            Var v = lookup(e.name, e.file, e.line);
            if (!v.isArray)
                return false;
            if (v.st == Storage.InStack)
            {
                lv = LValue(LK.Mem, SP, v.offset, v.ty, false);
                return true;
            }
            Reg a = allocTemp();
            liLabel(a, v.label);
            lv = LValue(LK.Mem, a, 0, v.ty, true);
            return true;
        }

        // Struct member whose type is an array: ask your member code for the
        // member's location (base reg + offset), exactly what it computes today
        // before it decays the array to an address.
        //if (isMember(e) && memberIsArray(e)) { lv = genMemberLocation(e); return true; }
        if (e.kind == EK.Member && memberField(e).isArray)
        {
            LValue m = genLValue(e); // base reg + (struct offset + member offset)
            if (m.kind != LK.Mem)
                return false;
            lv = m;
            return true;
        }

        return false;
    }

    /**
     * Load the value of an lvalue. With keepAddr the address temporary (if any)
     * stays allocated and a fresh temporary receives the value.
     */
    Val loadLV(LValue lv, int want, bool keepAddr)
    {
        if (isStructVal(lv.ty))
            throw err(curFile, curLine, "a struct cannot be used as a value here (use its members, &, or '=')");
        if (lv.kind == LK.RegVar)
            return Val(lv.reg, false);
        Val d;
        if (keepAddr)
            d = dest0(want);
        else
            d = dest1(want, Val(lv.reg, lv.tempAddr));
        emitLoad(lv.ty, d.r, lv.off, lv.reg);
        return d;
    }

    void storeLV(LValue lv, Val v)
    {
        if (lv.kind == LK.RegVar)
        {
            move(lv.reg, v.r);
            narrowReg(lv.reg, lv.ty);
        }
        else
        {
            emitStore(lv.ty, v.r, lv.off, lv.reg);
        }
    }

    /**
     * After a store to a memory lvalue: free temporaries and produce the
     * expression's value (v is on top of the temporary stack, the lvalue's
     * address temporary, if any, is just below it).
     */
    Val finishStore(LValue lv, Val v, bool discard)
    {
        if (discard)
        {
            release(v);
            if (lv.tempAddr)
                td--;
            return Val(R0, false);
        }
        if (lv.tempAddr)
        {
            if (v.isTemp)
            {
                move(lv.reg, v.r);
                release(v);
                return Val(lv.reg, true);
            }
            td--;
            return v;
        }
        return v;
    }

    /// v << log2(size), reusing v's temporary when possible.
    Val scaleVal(Val v, int size)
    {
        if (size <= 1)
            return v;
        if (isPow2(size))
        {
            Val d = dest1(-1, v);
            rri(Op.SLL, d.r, v.r, log2i(size));
            return d;
        }
        // Non power of two (e.g. a 12-byte struct): multiply by a constant.
        Reg k = allocTemp();
        li(k, size);
        td--; // k is free again, but its register stays intact
        Val dm = dest1(-1, v);
        emit(Op.MULT, makeReg(v.r), makeReg(k), makeNone());
        emit(Op.MFLO, makeReg(dm.r), makeNone(), makeNone());
        return dm;
    }

    /*
     * Assignment, ++/--
     */

    Val genAssign(Expr e, int want, bool discard)
    {
        LValue lv = genLValue(e.a);
        bool isReg = (lv.kind == LK.RegVar);
        Val res;

        if (lv.isArr)
            throw err(e.file, e.line, "cannot assign to an array member");
        if (isStructVal(lv.ty))
        {
            if (e.op != "=")
                throw err(e.file, e.line, "invalid operator for structs");
            if (!discard)
                throw err(e.file, e.line, "a struct assignment cannot be used as a value");
            genStructCopy(lv, e.b, e.file, e.line);
            return Val(R0, false);
        }

        if (e.op == "=")
        {
            if (isReg)
            {
                Val v = genExpr(e.b, lv.reg);
                if (v.r != lv.reg)
                {
                    move(lv.reg, v.r);
                    release(v);
                }
                narrowReg(lv.reg, lv.ty);
                return Val(lv.reg, false);
            }
            res = genExpr(e.b);
        }
        else
        {
            string bop = e.op[0 .. $ - 1];
            long rscale = (lv.ty.isPtr && (bop == "+" || bop == "-")) ? elemSize(lv.ty) : 1;
            Val cur = loadLV(lv, -1, true);
            res = binopRhs(bop, cur, e.b, rscale, isReg ? lv.reg : -1,
                           opUnsigned(bop, lv.ty, typeOf(e.b)));
            if (isReg)
            {
                if (res.r != lv.reg)
                {
                    move(lv.reg, res.r);
                    release(res);
                }
                narrowReg(lv.reg, lv.ty);
                return Val(lv.reg, false);
            }
        }

        storeLV(lv, res);
        return finishStore(lv, res, discard);
    }

    Val genIncDec(Expr e, int want, bool discard)
    {
        // Prefix form (or value not needed): same as  x += 1  /  x -= 1
        if (!e.post || discard)
        {
            auto c = new Expr(EK.Assign, e.file, e.line);
            c.op = (e.op == "++") ? "+=" : "-=";
            c.a = e.a;
            c.b = numExpr(1, e.file, e.line);
            return genAssign(c, want, discard);
        }

        // Postfix with a used value: result is the old value.
        CType t = typeOf(e.a);
        long step = t.isPtr ? elemSize(t) : 1;
        if (e.op == "--")
            step = -step;

        LValue lv = genLValue(e.a);
        if (lv.isArr)
            throw err(e.file, e.line, "cannot modify an array member");
        if (lv.kind == LK.RegVar)
        {
            Reg old = allocTemp();
            move(old, lv.reg);
            rri(Op.ADDIU, lv.reg, lv.reg, step);
            narrowReg(lv.reg, lv.ty);
            return Val(old, true);
        }

        Val curv = loadLV(lv, -1, true);
        Reg nw = allocTemp();
        rri(Op.ADDIU, nw, curv.r, step);
        emitStore(lv.ty, nw, lv.off, lv.reg);
        td--; // release nw
        return finishStore(lv, curv, false);
    }

    /// dst = <struct lvalue expression>: unrolled word / halfword / byte copy.
    void genStructCopy(LValue dst, Expr srcExpr, string file, int line)
    {
        CType st = typeOf(srcExpr);
        if (!isStructVal(st) || st.sname != dst.ty.sname)
            throw err(file, line, "struct assignment needs the same struct type on both sides");
        LValue src = genLValue(srcExpr);
        if (src.kind != LK.Mem || dst.kind != LK.Mem)
            throw err(file, line, "internal error: struct held in a register");

        StructDef sd = structDefs[dst.ty.sname];
        int chunk = (sd.align_ >= 4) ? 4 : sd.align_;
        int n = sd.size / chunk;
        if (n > 32)
            throw err(file, line, "struct too large to copy inline (limit 32 words)");

        CType ct = CType(chunk == 4 ? Base.Int : (chunk == 2 ? Base.Short : Base.Char), 0, true);
        Reg t = allocTemp();
        foreach (i; 0 .. n)
        {
            emitLoad(ct, t, src.off + i * chunk, src.reg);
            emitStore(ct, t, dst.off + i * chunk, dst.reg);
        }
        td--; // t
        if (src.tempAddr)
            td--;
        if (dst.tempAddr)
            td--;
    }

    /*
     * Unary / cast / address-of
     */
    
    Val genUnary(Expr e, int want)
    {
        if (e.op == "*")
        {
            LValue lv = genLValue(e);
            return loadLV(lv, want, false);
        }
        if (e.op == "&")
            return genAddrOf(e, want);

        Val a = genExpr(e.a);
        Val d = dest1(want, a);
        if (e.op == "-")
            rrr(Op.SUBU, d.r, R0, a.r);
        else if (e.op == "~")
            rrr(Op.NOR, d.r, a.r, R0);
        else if (e.op == "!")
            rri(Op.SLTIU, d.r, a.r, 1);
        else
            throw err(e.file, e.line, "unsupported unary operator " ~ e.op);
        return d;
    }

    Val genAddrOf(Expr e, int want)
    {
        Expr t = e.a;
        if (t.kind == EK.Var)
        {
            Var v = lookup(t.name, t.file, t.line);
            if (v.isArray)
                return genVar(t, want);
            if (v.st == Storage.InStack)
            {
                Val ds = dest0(want);
                rri(Op.ADDIU, ds.r, SP, v.offset);
                return ds;
            }
            if (v.st == Storage.InGlobal)
            {
                Val dg = dest0(want);
                liLabel(dg.r, v.label);
                return dg;
            }
            throw err(e.file, e.line, "internal error: address of a register variable");
        }

        LValue lv = genLValue(t);
        if (lv.kind != LK.Mem)
            throw err(e.file, e.line, "cannot take the address of this expression");
        Val dm = dest1(want, Val(lv.reg, lv.tempAddr));
        if (dm.r != lv.reg || lv.off != 0)
            rri(Op.ADDIU, dm.r, lv.reg, lv.off);
        return dm;
    }

    Val genCast(Expr e, int want)
    {
        Val v = genExpr(e.a, want);
        if (!e.ty.isPtr && (e.ty.base == Base.Char || e.ty.base == Base.Short))
        {
            Val d = dest1(want, v);
            if (e.ty.uns)
            {
                rri(Op.ANDI, d.r, v.r, (e.ty.base == Base.Char) ? 0xFF : 0xFFFF);
            }
            else
            {
                int sh = (e.ty.base == Base.Char) ? 24 : 16;
                rri(Op.SLL, d.r, v.r, sh);
                rri(Op.SRA, d.r, d.r, sh);
            }
            return d;
        }
        return v;
    }

    /*
     * Binary operators
     */

    Val genBinary(Expr e, int want)
    {
        if (e.op == "&&" || e.op == "||")
            return genLogicalValue(e, want);

        CType lt = typeOf(e.a);
        CType rt = typeOf(e.b);
        bool lp = lt.isPtr;
        bool rp = rt.isPtr;

        long lscale = 1;
        long rscale = 1;
        bool ptrDiff = false;
        if (e.op == "+" && lp && !rp)        rscale = elemSize(lt);
        else if (e.op == "+" && rp && !lp)   lscale = elemSize(rt);
        else if (e.op == "-" && lp && !rp)   rscale = elemSize(lt);
        else if (e.op == "-" && lp && rp)    ptrDiff = true;

        Val l = genExpr(e.a);
        if (lscale > 1)
            l = scaleVal(l, cast(int) lscale);

        bool uns = opUnsigned(e.op, lt, rt);
        Val res = binopRhs(e.op, l, e.b, rscale, ptrDiff ? -1 : want, uns);

        if (ptrDiff)
        {
            int sz = elemSize(lt);
            if (sz > 1)
            {
                if (isPow2(sz))
                {
                    Val d = dest1(want, res);
                    rri(Op.SRA, d.r, res.r, log2i(sz));
                    return d;
                }
                Reg k = allocTemp();
                li(k, sz);
                td--;
                Val dq = dest1(want, res);
                emit(Op.DIV, makeReg(res.r), makeReg(k), makeNone());
                emit(Op.MFLO, makeReg(dq.r), makeNone(), makeNone());
                return dq;
            }
        }
        return res;
    }

    /**
     * Evaluate `l op rhs` where l is already evaluated.
     * rscale scales the right operand (pointer arithmetic).
     */
    Val binopRhs(string op, Val l, Expr rhs, long rscale, int want, bool uns)
    {
        long c;
        if (constEval(rhs, c))
        {
            long cs = c * rscale;
            if (op == "+" && fits16(cs))
            {
                Val d = dest1(want, l);
                rri(Op.ADDIU, d.r, l.r, cs);
                return d;
            }
            if (op == "-" && fits16(-cs))
            {
                Val d = dest1(want, l);
                rri(Op.ADDIU, d.r, l.r, -cs);
                return d;
            }
            if ((op == "&" || op == "|" || op == "^") && cs >= 0 && cs <= 0xFFFF)
            {
                Val d = dest1(want, l);
                rri(op == "&" ? Op.ANDI : (op == "|" ? Op.ORI : Op.XORI), d.r, l.r, cs);
                return d;
            }
            if ((op == "<<" || op == ">>") && cs >= 0 && cs < 32)
            {
                Val d = dest1(want, l);
                rri(op == "<<" ? Op.SLL : (uns ? Op.SRL : Op.SRA), d.r, l.r, cs);
                return d;
            }
            if (op == "<" && fits16(cs))
            {
                Val d = dest1(want, l);
                rri(uns ? Op.SLTIU : Op.SLTI, d.r, l.r, cs);
                return d;
            }
            if (op == "*" && cs > 1 && isPow2(cs))
            {
                Val d = dest1(want, l);
                rri(Op.SLL, d.r, l.r, log2i(cs));
                return d;
            }
            if (op == "/" && uns && cs > 1 && isPow2(cs))
            {
                Val d = dest1(want, l);
                rri(Op.SRL, d.r, l.r, log2i(cs));
                return d;
            }
            if (op == "%" && uns && cs > 1 && isPow2(cs) && cs - 1 <= 0xFFFF)
            {
                Val d = dest1(want, l);
                rri(Op.ANDI, d.r, l.r, cs - 1);
                return d;
            }
        }

        Val r = genExpr(rhs);
        if (rscale > 1)
            r = scaleVal(r, cast(int) rscale);
        return emitBin(op, l, r, want, uns);
    }

    Val emitBin(string op, Val l, Val r, int want, bool uns)
    {
        Val d = dest2(want, l, r);
        Reg a = l.r;
        Reg b = r.r;
        Reg x = d.r;

        switch (op)
        {
            case "+":  rrr(Op.ADDU, x, a, b); break;
            case "-":  rrr(Op.SUBU, x, a, b); break;
            case "*":
                emit(Op.MULT, makeReg(a), makeReg(b), makeNone());
                emit(Op.MFLO, makeReg(x), makeNone(), makeNone());
                break;
            case "/":
                emit(uns ? Op.DIVU : Op.DIV, makeReg(a), makeReg(b), makeNone());
                emit(Op.MFLO, makeReg(x), makeNone(), makeNone());
                break;
            case "%":
                emit(uns ? Op.DIVU : Op.DIV, makeReg(a), makeReg(b), makeNone());
                emit(Op.MFHI, makeReg(x), makeNone(), makeNone());
                break;
            case "&":  rrr(Op.AND, x, a, b); break;
            case "|":  rrr(Op.OR, x, a, b); break;
            case "^":  rrr(Op.XOR, x, a, b); break;
            case "<<": rrr(Op.SLLV, x, a, b); break;
            case ">>": rrr(uns ? Op.SRLV : Op.SRAV, x, a, b); break;
            case "<":  rrr(uns ? Op.SLTU : Op.SLT, x, a, b); break;
            case ">":  rrr(uns ? Op.SLTU : Op.SLT, x, b, a); break;
            case "<=":
                rrr(uns ? Op.SLTU : Op.SLT, x, b, a);
                rri(Op.XORI, x, x, 1);
                break;
            case ">=":
                rrr(uns ? Op.SLTU : Op.SLT, x, a, b);
                rri(Op.XORI, x, x, 1);
                break;
            case "==":
                rrr(Op.XOR, x, a, b);
                rri(Op.SLTIU, x, x, 1);
                break;
            case "!=":
                rrr(Op.XOR, x, a, b);
                rrr(Op.SLTU, x, R0, x);
                break;
            default:
                throw err(curFile, curLine, "unsupported operator " ~ op);
        }
        return d;
    }

    /// && / || used as a value: materialize 0 or 1.
    Val genLogicalValue(Expr e, int want)
    {
        string lFalse = newLabel();
        string lEnd = newLabel();
        genBranch(e, lFalse, false);
        Val d = dest0(want);
        li(d.r, 1);
        jump(lEnd);
        placeLabel(lFalse);
        li(d.r, 0);
        placeLabel(lEnd);
        return d;
    }

    /*
     * Conditions
     */

    /**
     * Jump to `target` if e is true (jumpIfTrue) or false (!jumpIfTrue);
     * otherwise fall through.
     */
    void genBranch(Expr e, string target, bool jumpIfTrue)
    {
        curFile = e.file;
        curLine = e.line;

        long cv;
        if (constEval(e, cv))
        {
            if ((cv != 0) == jumpIfTrue)
                jump(target);
            return;
        }

        if (e.kind == EK.Unary && e.op == "!")
        {
            genBranch(e.a, target, !jumpIfTrue);
            return;
        }

        if (e.kind == EK.Binary)
        {
            string op = e.op;
            if (op == "&&")
            {
                if (jumpIfTrue)
                {
                    string skip = newLabel();
                    genBranch(e.a, skip, false);
                    genBranch(e.b, target, true);
                    placeLabel(skip);
                }
                else
                {
                    genBranch(e.a, target, false);
                    genBranch(e.b, target, false);
                }
                return;
            }
            if (op == "||")
            {
                if (jumpIfTrue)
                {
                    genBranch(e.a, target, true);
                    genBranch(e.b, target, true);
                }
                else
                {
                    string skip = newLabel();
                    genBranch(e.a, skip, true);
                    genBranch(e.b, target, false);
                    placeLabel(skip);
                }
                return;
            }
            if (op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=")
            {
                bool uns = opUnsigned(op, typeOf(e.a), typeOf(e.b));
                genCmpBranch(jumpIfTrue ? op : invertCmp(op), e.a, e.b, target, uns);
                return;
            }
        }

        Val v = genExpr(e);
        branch2(jumpIfTrue ? Op.BNE : Op.BEQ, v.r, R0, target);
        release(v);
    }

    /// Jump to target if `a op b` holds.
    void genCmpBranch(string op, Expr a, Expr b, string target, bool uns)
    {
        long c;
        if (constEval(b, c) && c == 0 && (op == "<" || op == "<=" || op == ">" || op == ">="))
        {
            Val z = genExpr(a);
            if (!uns)
            {
                Op bop = (op == "<") ? Op.BLTZ : (op == "<=") ? Op.BLEZ : (op == ">") ? Op.BGTZ : Op.BGEZ;
                branch1(bop, z.r, target);
            }
            else if (op == ">=")
            {
                jump(target);                       // unsigned x >= 0 is always true
            }
            else if (op == ">")
            {
                branch2(Op.BNE, z.r, R0, target);   // x > 0  <=>  x != 0
            }
            else if (op == "<=")
            {
                branch2(Op.BEQ, z.r, R0, target);   // x <= 0  <=>  x == 0
            }
            // unsigned x < 0 is never true: no branch
            release(z);
            return;
        }

        Val l = genExpr(a);
        Val r = genExpr(b);

        if (op == "==" || op == "!=")
        {
            branch2(op == "==" ? Op.BEQ : Op.BNE, l.r, r.r, target);
            release(r);
            release(l);
            return;
        }

        Op slt = uns ? Op.SLTU : Op.SLT;
        Val t = dest2(-1, l, r);
        if (op == "<")
        {
            rrr(slt, t.r, l.r, r.r);
            branch2(Op.BNE, t.r, R0, target);
        }
        else if (op == ">=")
        {
            rrr(slt, t.r, l.r, r.r);
            branch2(Op.BEQ, t.r, R0, target);
        }
        else if (op == ">")
        {
            rrr(slt, t.r, r.r, l.r);
            branch2(Op.BNE, t.r, R0, target);
        }
        else // "<="
        {
            rrr(slt, t.r, r.r, l.r);
            branch2(Op.BEQ, t.r, R0, target);
        }
        release(t);
    }
    
    /*
     * GTE intrinsics
     */
    
    void genGteLoadV3(Expr v0Expr, Expr v1Expr, Expr v2Expr)
    {
        Val v0 = genExpr(v0Expr);
        Val v1 = genExpr(v1Expr);
        Val v2 = genExpr(v2Expr);

        Reg t0 = allocTemp();
        Reg t1 = allocTemp();

        // Vertex0 -> GTE VXY0 ($0), VZ0 ($1)
        mem(Op.LW, t0, 0, v0.r);
        mem(Op.LW, t1, 4, v0.r);
        nop();
        gte_mtc2(t0, 0); // VXY0
        gte_mtc2(t1, 1); // VZ0

        // Vertex1 -> GTE VXY1 ($2), VZ1 ($3)
        mem(Op.LW, t0, 0, v1.r);
        mem(Op.LW, t1, 4, v1.r);
        nop();
        gte_mtc2(t0, 2); // VXY1
        gte_mtc2(t1, 3); // VZ1

        // Vertex2 -> GTE VXY2 ($4), VZ2 ($5)
        mem(Op.LW, t0, 0, v2.r);
        mem(Op.LW, t1, 4, v2.r);
        nop();
        gte_mtc2(t0, 4); // VXY2
        gte_mtc2(t1, 5); // VZ2

        release(Val(t1, true));
        release(Val(t0, true));
        release(v2);
        release(v1);
        release(v0);
    }
    
    Val genGteGetMAC0(int want = -1)
    {
        Val d = dest0(want);
        gte_mfc2(d.r, 24); // MAC0 register, stores NCLIP result
        return d;
    }

    Val genGteGetOTZ(int want = -1)
    {
        Val d = dest0(want);
        gte_mfc2(d.r, 25); // OTZ register, stores AVSZ3 result
        return d;
    }

    Val genGteGetFlags(int want = -1)
    {
        Val d = dest0(want);
        gte_cfc2(d.r, 63); // FLAG
        return d;
    }
    
    void genGteStoreSXY0(Expr packetBaseExpr, long offset)
    {
        Val base = genExpr(packetBaseExpr);
        gte_swc2(12, offset, base.r);
        release(base);
    }

    void genGteStoreSXY1(Expr packetBaseExpr, long offset)
    {
        Val base = genExpr(packetBaseExpr);
        gte_swc2(13, offset, base.r);
        release(base);
    }

    void genGteStoreSXY2(Expr packetBaseExpr, long offset)
    {
        Val base = genExpr(packetBaseExpr);
        gte_swc2(14, offset, base.r);
        release(base);
    }

    /*
     * Calls
     */

    Val genCall(Expr e, int want, bool discard)
    {
        string name = e.name;
        bool bios = (name == "bios_a" || name == "bios_b" || name == "bios_c");
        Expr[] args = e.args;
        long biosFn = 0;

        if (bios)
        {
            if (args.length < 1 || !constEval(args[0], biosFn))
                throw err(e.file, e.line, name ~ "() needs a constant function number as its first argument");
            args = args[1 .. $];
        }
        else
        {
            auto pf = name in funcs;
            if (pf is null)
                throw err(e.file, e.line, "call to undefined function \"" ~ name ~ "\"");
            if (!pf.defined)
                throw err(e.file, e.line, "function \"" ~ name ~ "\" is declared but never defined");
            if (args.length != pf.params.length)
                throw err(e.file, e.line, format("\"%s\" expects %s argument(s) but %s given",
                                         name, pf.params.length, args.length));
        }
        if (args.length > 4)
            throw err(e.file, e.line, "at most 4 call arguments are supported");

        hasCall = true;
        int d0 = td; // temporaries that are live across the call

        Val[] vals;
        foreach (a; args)
            vals ~= genExpr(a);

        // Save live temporaries
        foreach (i; 0 .. d0)
            mem(Op.SW, tempRegs[i], 4 * i, SP);

        foreach (i, v; vals)
            move(argRegs[i], v.r);

        if (bios)
        {
            li(T1, biosFn);
            li(T2, name == "bios_a" ? 0xA0 : (name == "bios_b" ? 0xB0 : 0xC0));
            emit(Op.JALR, makeReg(RA), makeReg(T2), makeNone());
            nop();
        }
        else
        {
            emit(Op.JAL, makeLabel("f_" ~ name), makeNone(), makeNone());
            nop();
        }

        // Restore live temporaries
        foreach (i; 0 .. d0)
            mem(Op.LW, tempRegs[i], 4 * i, SP);
        if (d0 > 0)
            nop(); // load delay slot

        foreach_reverse (v; vals)
            release(v);

        if (discard)
            return Val(R0, false);

        Val d = dest0(want);
        move(d.r, V0);
        return d;
    }

    /*
     * Statements
     */

    void genExprStmt(Expr e)
    {
        curFile = e.file;
        curLine = e.line;
        Val v;
        if (e.kind == EK.Assign)
            v = genAssign(e, -1, true);
        else if (e.kind == EK.IncDec)
            v = genIncDec(e, -1, true);
        else if (e.kind == EK.Call)
        {
            if (isIntrinsic(e.name))
                v = genIntrinsicValue(e, -1);
            else
                v = genCall(e, -1, true);
        }
        else
            v = genExpr(e);
        release(v);
        td = 0;
    }
    
    // TODO: COP0 intrinsics
    string[] intrinsics = [
        "nop",
        "gte_enable",
        // TODO: "gte_disable"
        "gte_set_matrix",
        "gte_set_vertex", "gte_get_vertex",
        "gte_mfc2", "gte_cfc2",
        "gte_mtc2", "gte_ctc2",
        "gte_swc2", "gte_lwc2",
        "gte_rtps", "gte_rtpt", "gte_mvmva",
        "gte_dcpl", "gte_dpcs", "gte_dpct",
        "gte_intpl", "gte_sqr", "gte_ncs",
        "gte_nct", "gte_ncds", "gte_ncdt",
        "gte_nccs", "gte_ncct", "gte_cdp",
        "gte_cc", "gte_nclip", "gte_avsz3",
        "gte_avsz4", "gte_op", "gte_gpf",
        "gte_gpl"
    ];

    bool isIntrinsic(string name)
    {
        return intrinsics.canFind(name);
    }
    
    Val genIntrinsicValue(Expr e, int want)
    {
        switch (e.name)
        {
            case "gte_mfc2":
            case "gte_cfc2":
            {
                checkArgs(e, 1);
                Reg g = gteRegArg(e.args[0], e.name);
                Val d = dest0(want);
                if (e.name == "gte_mfc2") gte_mfc2(d.r, g);
                else                      gte_cfc2(d.r, g);
                return d;
            }
            default:
                genIntrinsic(e);          // commands, stores: no value
                return Val(R0, false);
        }
    }

    /// Coprocessor intrinsics.
    void genIntrinsic(Expr e)
    {
        string name = e.name;
        switch(name)
        {
            case "nop":
                nop();
                break;
            
            case "gte_enable":
            {
                Reg t0 = allocTemp();
                Reg t1 = allocTemp();
                emit(Op.MFC0, makeReg(t0), makeRegCop0(SR), makeNone);
                nop();
                emit(Op.LUI,  makeReg(t1), makeImm(0x4000), makeNone);
                emit(Op.OR,   makeReg(t0), makeReg(t0),     makeReg(t1));
                emit(Op.MTC0, makeReg(t0), makeRegCop0(SR), makeNone);
                nop();
                nop();
                release(Val(t1, true));
                release(Val(t0, true));
                break;
            }
            
            case "gte_set_matrix":
            {
                checkArgs(e, 1);
                Val v = genExpr(e.args[0]);
                Reg t0 = allocTemp();
                Reg t1 = allocTemp();
                mem(Op.LW, t0, 0, v.r);
                mem(Op.LW, t1, 4, v.r);
                gte_ctc2(t0, 0);
                mem(Op.LW, t0, 8, v.r);
                gte_ctc2(t1, 1);
                mem(Op.LW, t1, 12, v.r);
                gte_ctc2(t0, 2);
                mem(Op.LH, t0, 16, v.r);
                gte_ctc2(t1, 3);
                gte_ctc2(t0, 4);
                td -= 2;
                release(v);
                break;
            }
            
            case "gte_set_vertex":
            {
                checkArgs(e, 1);
                Val v = genExpr(e.args[0]);
                gte_lwc2(VXY0,  0, v.r);
                gte_lwc2(VZ0,   4, v.r);
                gte_lwc2(VXY1,  8, v.r);
                gte_lwc2(VZ1,  12, v.r);
                gte_lwc2(VXY2, 16, v.r);
                gte_lwc2(VZ2,  20, v.r);
                nop();
                nop();
                break;
            }
            
            case "gte_get_vertex":
            {
                checkArgs(e, 1);
                Val v = genExpr(e.args[0]);
                gte_swc2(SXY0,  0, v.r);
                gte_swc2(SZ1,   4, v.r);
                gte_swc2(SXY1,  8, v.r);
                gte_swc2(SZ2,  12, v.r);
                gte_swc2(SXY2, 16, v.r);
                gte_swc2(SZ3,  20, v.r);
                release(v);
                break;
            }
            
            case "gte_mtc2":
            case "gte_ctc2":
            {
                checkArgs(e, 2);
                Reg g = gteRegArg(e.args[0], name);
                Val v = genExpr(e.args[1]);
                if (name == "gte_mtc2") gte_mtc2(v.r, g);
                else                    gte_ctc2(v.r, cast(uint)g);
                release(v);
                break;
            }
            case "gte_swc2":
            case "gte_lwc2":
            {
                checkArgs(e, 2);
                Reg g = gteRegArg(e.args[0], name);
                Val p = genExpr(e.args[1]);
                if (name == "gte_swc2") gte_swc2(g, 0, p.r);
                else                    gte_lwc2(g, 0, p.r);
                release(p);
                break;
            }
            
            case "gte_rtps":  gte_rtps(); break;
            case "gte_rtpt":  gte_rtpt(); break;
            case "gte_mvmva": gte_mvmva(); break;
            case "gte_dcpl":  gte_dcpl(); break;
            case "gte_dpcs":  gte_dpcs(); break;
            case "gte_dpct":  gte_dpct(); break;
            case "gte_intpl": gte_intpl(); break;
            case "gte_sqr":   gte_sqr(); break;
            case "gte_ncs":   gte_ncs(); break;
            case "gte_nct":   gte_nct(); break;
            case "gte_ncds":  gte_ncds(); break;
            case "gte_ncdt":  gte_ncdt(); break;
            case "gte_nccs":  gte_nccs(); break;
            case "gte_ncct":  gte_ncct(); break;
            case "gte_cdp":   gte_cdp(); break;
            case "gte_cc":    gte_cc(); break;
            case "gte_nclip": gte_nclip(); break;
            case "gte_avsz3": gte_avsz3(); break;
            case "gte_avsz4": gte_avsz4(); break;
            case "gte_op":    gte_op(); break;
            case "gte_gpf":   gte_gpf(); break;
            case "gte_gpl":   gte_gpl(); break;
            default: break;
        }
    }
    
    Reg gteRegArg(Expr arg, string fname)
    {
        long n;
        if (!constEval(arg, n) || n < 0 || n > 31)
            throw err(curFile, arg.line, fname ~ ": register number must be a constant from 0 to 31");
        return cast(Reg)n;
    }

    void checkArgs(Expr e, size_t n)
    {
        if (e.args.length != n)
            throw err(curFile, e.line,
                format("%s expects %s argument(s) but %s given", e.name, n, e.args.length));
    }

    void genStmt(Stmt s)
    {
        curFile = s.file;
        curLine = s.line;
        switch (s.kind)
        {
            case SK.Block:
            {
                if (s.scoped)
                    pushScope();
                foreach (c; s.stmts)
                    genStmt(c);
                if (s.scoped)
                    popScope();
                break;
            }

            case SK.Decl:
                genDecl(s);
                break;

            case SK.ExprS:
                genExprStmt(s.e);
                break;

            case SK.If:
            {
                string lElse = newLabel();
                genBranch(s.e, lElse, false);
                td = 0;
                genStmt(s.thenS);
                if (s.elseS !is null)
                {
                    string lEnd = newLabel();
                    jump(lEnd);
                    placeLabel(lElse);
                    genStmt(s.elseS);
                    placeLabel(lEnd);
                }
                else
                {
                    placeLabel(lElse);
                }
                break;
            }

            case SK.While:
            {
                string lCond = newLabel();
                string lEnd = newLabel();
                placeLabel(lCond);
                genBranch(s.e, lEnd, false);
                td = 0;
                breakStack ~= lEnd;
                contStack ~= lCond;
                genStmt(s.thenS);
                breakStack = breakStack[0 .. $ - 1];
                contStack = contStack[0 .. $ - 1];
                jump(lCond);
                placeLabel(lEnd);
                break;
            }

            case SK.DoWhile:
            {
                string lTop = newLabel();
                string lCont = newLabel();
                string lEnd = newLabel();
                placeLabel(lTop);
                breakStack ~= lEnd;
                contStack ~= lCont;
                genStmt(s.thenS);
                breakStack = breakStack[0 .. $ - 1];
                contStack = contStack[0 .. $ - 1];
                placeLabel(lCont);
                genBranch(s.e, lTop, true);
                td = 0;
                placeLabel(lEnd);
                break;
            }

            case SK.For:
            {
                pushScope();
                if (s.forInit !is null)
                    genStmt(s.forInit);
                string lCond = newLabel();
                string lStep = newLabel();
                string lEnd = newLabel();
                placeLabel(lCond);
                if (s.e !is null)
                {
                    genBranch(s.e, lEnd, false);
                    td = 0;
                }
                breakStack ~= lEnd;
                contStack ~= lStep;
                genStmt(s.thenS);
                breakStack = breakStack[0 .. $ - 1];
                contStack = contStack[0 .. $ - 1];
                placeLabel(lStep);
                if (s.step !is null)
                    genExprStmt(s.step);
                jump(lCond);
                placeLabel(lEnd);
                popScope();
                break;
            }

            case SK.Return:
            {
                if (s.e !is null)
                {
                    if (curRet.ptr == 0 && curRet.base == Base.Void)
                        throw err(s.file, s.line, "void function cannot return a value");
                    Val v = genExpr(s.e, V0);
                    move(V0, v.r);
                    release(v);
                    td = 0;
                }
                jump(retLabel);
                break;
            }

            case SK.Break:
                if (breakStack.length == 0)
                    throw err(s.file, s.line, "\"break\" outside of a loop");
                jump(breakStack[$ - 1]);
                break;

            case SK.Continue:
                if (contStack.length == 0)
                    throw err(s.file, s.line, "\"continue\" outside of a loop");
                jump(contStack[$ - 1]);
                break;

            default:
                break;
        }
    }

    void genDecl(Stmt s)
    {
        Var v = declareLocal(s.name, s.ty, s.arrLen, s.file, s.line);
        if (s.e !is null)
        {
            if (v.isArray)
                throw err(s.file, s.line, "local array initializers are not supported");
            auto target = new Expr(EK.Var, s.file, s.line);
            target.name = s.name;
            auto asg = new Expr(EK.Assign, s.file, s.line);
            asg.op = "=";
            asg.a = target;
            asg.b = s.e;
            genExprStmt(asg);
        }
    }

    /*
     * Functions and program
     */

    /// Finds variables whose address is taken (they must live in memory).
    void scanExpr(Expr e)
    {
        if (e is null)
            return;
        if (e.kind == EK.Unary && e.op == "&" && e.a !is null && e.a.kind == EK.Var)
            addrTaken[e.a.name] = true;
        scanExpr(e.a);
        scanExpr(e.b);
        foreach (x; e.args)
            scanExpr(x);
    }

    void scanStmt(Stmt s)
    {
        if (s is null)
            return;
        scanExpr(s.e);
        scanExpr(s.step);
        scanStmt(s.forInit);
        scanStmt(s.thenS);
        scanStmt(s.elseS);
        foreach (c; s.stmts)
            scanStmt(c);
    }

    void genFunc(Func f)
    {
        cur = null;
        curLbls = null;
        scopes = null;
        savedS = null;
        breakStack = null;
        contStack = null;
        pmoves = null;
        td = 0;
        nextS = 0;
        maxS = 0;
        localsTop = TEMP_SAVE_AREA;
        hasCall = false;
        curRet = f.ret;
        curFile = f.file;
        curLine = f.line;
        retLabel = newLabel();
        addrTaken = null;
        scanStmt(f.body_);

        if (f.params.length > 4)
            throw err(f.file, f.line, "functions may have at most 4 parameters");

        pushScope();
        foreach (i, prm; f.params)
        {
            Var v = declareLocal(prm.name, prm.ty, -1, f.file, f.line);
            pmoves ~= PMove(v, argRegs[i]);
        }
        genStmt(f.body_);
        popScope();

        placeLabel(retLabel);

        // Peephole: drop a trailing "j ret; nop" (a return as the last statement).
        if (cur.length >= 2
            && cur[$ - 2].op == Op.J
            && cur[$ - 2].operand1.type == AsmOperandType.Label
            && cur[$ - 2].operand1.label == retLabel
            && cur[$ - 1].op == Op.NOP)
        {
            cur = cur[0 .. $ - 2];
            foreach (ref l; curLbls)
            {
                if (l.idx > cur.length)
                    l.idx = cur.length;
            }
        }

        AsmInstr[] bodyInstrs = cur;
        Lbl[] bodyLbls = curLbls;
        cur = null;
        curLbls = null;

        int savedBase = (localsTop + 3) & ~3;
        int raOff = savedBase + 4 * maxS;
        int frame = (raOff + 4 + 7) & ~7;
        if (frame > 32000)
            throw err(f.file, f.line, "stack frame too large");

        // Prologue
        placeLabel("f_" ~ f.name);
        rri(Op.ADDIU, SP, SP, -frame);
        if (hasCall)
            mem(Op.SW, RA, raOff, SP);
        foreach (i; 0 .. maxS)
            mem(Op.SW, sRegs[i], savedBase + 4 * i, SP);
        foreach (pm; pmoves)
        {
            if (pm.v.st == Storage.InReg)
            {
                move(pm.v.reg, pm.src);
                narrowReg(pm.v.reg, pm.v.ty);
            }
            else
            {
                emitStore(pm.v.ty, pm.src, pm.v.offset, SP);
            }
        }

        // Body
        size_t bodyBase = cur.length;
        foreach (l; bodyLbls)
            curLbls ~= Lbl(l.name, l.idx + bodyBase);
        cur ~= bodyInstrs;

        // Epilogue ($ra is reloaded first so the load delay is covered)
        if (hasCall)
            mem(Op.LW, RA, raOff, SP);
        foreach (i; 0 .. maxS)
            mem(Op.LW, sRegs[i], savedBase + 4 * i, SP);
        rri(Op.ADDIU, SP, SP, frame);
        emit(Op.JR, makeReg(RA), makeNone(), makeNone());
        nop();

        flush();
    }

    void genAsmFunc(Func f)
    {
        cur = null;
        curLbls = null;
        scopes = null;
        savedS = null;
        breakStack = null;
        contStack = null;
        pmoves = null;
        td = 0;
        nextS = 0;
        maxS = 0;
        localsTop = TEMP_SAVE_AREA;
        hasCall = true;
        curRet = f.ret;
        curFile = f.file;
        curLine = f.line;
        retLabel = newLabel();
        addrTaken = null;
        
        if (f.params.length > 4)
            throw err(f.file, f.line, "functions may have at most 4 parameters");

        pushScope();
        foreach (i, prm; f.params)
        {
            Var v = declareLocal(prm.name, prm.ty, -1, f.file, f.line);
            pmoves ~= PMove(v, argRegs[i]);
        }
        
        if (f.attrFilename != "")
        {
            string asmFilename = buildPath(parentDirectory, f.attrFilename).buildNormalizedPath;
            if (!exists(asmFilename))
                throw err(f.file, f.line, "can't find file \"" ~ asmFilename ~ "\"");
            
            if (auto owner = asmFilename in asmFileOwner)
                throw err(f.file, f.line, "assembly file \"" ~ asmFilename ~ "\" is already used by function \"" ~ *owner ~ "\"");
            asmFileOwner[asmFilename] = f.name;
            
            string asmCode = readText(asmFilename);
            string asmLabelPrefix = asmFilename;
            Assembly extAsm = assemble(asmCode, asmFilename, asmLabelPrefix, cur.length);
            cur ~= extAsm.instructions;
            ass.dataEntries ~= extAsm.dataEntries;
        }
        
        popScope();

        placeLabel(retLabel);

        // Peephole: drop a trailing "j ret; nop" (a return as the last statement).
        if (cur.length >= 2
            && cur[$ - 2].op == Op.J
            && cur[$ - 2].operand1.type == AsmOperandType.Label
            && cur[$ - 2].operand1.label == retLabel
            && cur[$ - 1].op == Op.NOP)
        {
            cur = cur[0 .. $ - 2];
            foreach (ref l; curLbls)
            {
                if (l.idx > cur.length)
                    l.idx = cur.length;
            }
        }

        AsmInstr[] bodyInstrs = cur;
        Lbl[] bodyLbls = curLbls;
        cur = null;
        curLbls = null;

        int savedBase = (localsTop + 3) & ~3;
        int raOff = savedBase + 4 * maxS;
        int frame = (raOff + 4 + 7) & ~7;
        if (frame > 32000)
            throw err(f.file, f.line, "stack frame too large");

        // Prologue
        placeLabel("f_" ~ f.name);
        rri(Op.ADDIU, SP, SP, -frame);
        if (hasCall)
            mem(Op.SW, RA, raOff, SP);
        foreach (i; 0 .. maxS)
            mem(Op.SW, sRegs[i], savedBase + 4 * i, SP);
        foreach (pm; pmoves)
        {
            if (pm.v.st == Storage.InReg)
            {
                move(pm.v.reg, pm.src);
                narrowReg(pm.v.reg, pm.v.ty);
            }
            else
            {
                emitStore(pm.v.ty, pm.src, pm.v.offset, SP);
            }
        }

        // Body
        size_t bodyBase = cur.length;
        foreach (l; bodyLbls)
            curLbls ~= Lbl(l.name, l.idx + bodyBase);
        cur ~= bodyInstrs;

        // Epilogue ($ra is reloaded first so the load delay is covered)
        if (hasCall)
            mem(Op.LW, RA, raOff, SP);
        foreach (i; 0 .. maxS)
            mem(Op.LW, sRegs[i], savedBase + 4 * i, SP);
        rri(Op.ADDIU, SP, SP, frame);
        emit(Op.JR, makeReg(RA), makeNone(), makeNone());
        nop();

        flush();
    }

    /// Append the current buffer to the program and register its labels.
    void flush()
    {
        foreach (l; curLbls)
            ass.sections[l.name] = program.length + l.idx;
        program ~= cur;
        cur = null;
        curLbls = null;
    }

    /// Entry stub: set up $sp, call main, spin forever if it returns.
    void genStartup()
    {
        cur = null;
        curLbls = null;
        curFile = path;
        curLine = 0;
        placeLabel("_start");
        li(SP, STACK_ADDR);
        emit(Op.JAL, makeLabel("f_main"), makeNone(), makeNone());
        nop();
        placeLabel("_halt");
        jump("_halt");
        flush();
    }

    void declareGlobal(GlobalDecl g)
    {
        if (g.name in globals)
            throw err(g.file, g.line, "redefinition of global \"" ~ g.name ~ "\"");
        if (g.ty.ptr == 0 && g.ty.base == Base.Void)
            throw err(g.file, g.line, "variable \"" ~ g.name ~ "\" cannot have type \"void\"");

        if (isStructVal(g.ty) && g.hasInit)
            throw err(g.file, g.line, "struct initializers are not supported");

        auto v = new Var();
        v.name = g.name;
        v.ty = g.ty;
        v.st = Storage.InGlobal;
        v.label = "g_" ~ g.name;

        int esz = g.ty.size();
        ubyte[] data;
        
        if (g.attrFilename.length > 0)
        {
            if (g.ty.ptr == 0)
                throw err(g.file, g.line, "file attribute requires an array");
            
            // TODO: build path for searching external files
            string externalFile = g.attrFilename;
            if (exists(externalFile))
                data = cast(ubyte[])read(externalFile);
            else
                throw err(g.file, g.line, "can't find file \"" ~ externalFile ~ "\"");
            v.isArray = true;
            v.arrLen = cast(int)data.length;
        }
        else if (g.isArray)
        {
            int n = g.arrLen;
            if (g.strInit)
            {
                if (g.ty.ptr != 0 || g.ty.base != Base.Char)
                    throw err(g.file, g.line, "a string initializer requires a char array");
                if (n < 0)
                    n = cast(int) g.strBytes.length;
                if (cast(int) g.strBytes.length > n)
                    throw err(g.file, g.line, "string initializer is too long for the array");
                data = g.strBytes.dup;
                data.length = n;
            }
            else
            {
                if (n < 0)
                {
                    if (!g.hasInit)
                        throw err(g.file, g.line, "array needs a size or an initializer");
                    n = cast(int) g.inits.length;
                }
                if (cast(int) g.inits.length > n)
                    throw err(g.file, g.line, "too many initializers");
                foreach (x; g.inits)
                    data ~= toBytes(x, esz);
                data.length = n * esz;
            }
            v.isArray = true;
            v.arrLen = n;
        }
        else
        {
            if (g.strInit)
                throw err(g.file, g.line, "string initializers are only supported for char arrays");
            if (isStructVal(g.ty))
            {
                data = new ubyte[esz]; // zero-initialized
            }
            else
            {
                long iv = (g.inits.length > 0) ? g.inits[0] : 0;
                data = toBytes(iv, esz);
            }
        }

        ass.dataEntries ~= AsmDataEntry(v.label, data);
        globals[g.name] = v;
    }

    void registerFunc(Func f)
    {
        CType[] ps;
        foreach (prm; f.params)
            ps ~= prm.ty;

        bool alreadyDefined = false;
        if (auto q = f.name in funcs)
            alreadyDefined = q.defined;
        if (alreadyDefined && f.body_ !is null)
            throw err(f.file, f.line, "redefinition of function \"" ~ f.name ~ "\"");

        FuncInfo fi;
        fi.ret = f.ret;
        fi.params = ps;
        fi.defined = alreadyDefined || f.body_ !is null || f.isExternal;
        funcs[f.name] = fi;
    }

    Assembly generate(Program p)
    {
        prog = p;
        ass = new Assembly();

        foreach (g; p.globals)
            declareGlobal(g);
        foreach (f; p.funcs)
            registerFunc(f);

        auto pm = "main" in funcs;
        if (pm is null || !pm.defined)
            throw err(path, 0, "program has no main() function");

        genStartup();
        foreach (f; p.funcs)
        {
            if (f.body_ !is null)
                genFunc(f);
            else if (f.attrFilename != "")
                genAsmFunc(f);
        }

        ass.instructions = program;
        return ass;
    }
}
