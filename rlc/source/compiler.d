/**
 * Simple C-like language compiler targeting the MIPS R3000 (PlayStation 1).
 *
 * The compiler does not encode machine code itself. It builds an `Assembly`
 * (the same structure the assembler front end produces) so the regular back end
 * in main.d does encoding, label resolution, data layout and PS-X EXE output.
 *
 *   - Code labels live in Assembly.sections (label -> instruction index).
 *   - Globals and string literals live in Assembly.dataEntries.
 *   - Branch / jump / li operands that refer to labels use AsmOperandType.Label.
 *
 * Language summary
 * ----------------
 *   Types      : int/short/char, uint/ushort/uchar (also unsigned [int|short|char]),
 *                void, and pointers to them. Pointers compare as unsigned.
 *                Literals above 0x7FFFFFFF, or with a 'u' suffix, are unsigned.
 *                Like C, uchar/ushort promote to (signed) int in arithmetic; only uint
 *                makes / % >> and comparisons unsigned.
 *   Structs    : top-level definitions  struct Name { int a; uchar c[3]; struct Other o; };
 *                Used as  struct Name x;  struct Name* p;  p->a  x.a  x.o.b  arr[i].a
 *                Fields may be scalars, pointers, arrays or nested structs. Structs can be
 *                copied with '=' (inline, up to 32 words), have their address taken, and be
 *                measured with sizeof(struct Name) / sizeof(type).
 *                Not supported: struct initializers, passing/returning structs by value,
 *                unions, bit-fields, typedef, sizeof(expression).
 *   Globals    : scalars and arrays with constant initializers, e.g.
 *                    int x = 5;   int t[4] = {1,2,3,4};   char s[] = "hi";
 *   Locals     : scalars and (uninitialized) arrays.
 *   Statements : if/else, while, do-while, for, break, continue, return, blocks.
 *   Operators  : C precedence, minus the ternary and comma operators.
 *                + - * / % & | ^ << >> ~ ! && || == != < <= > >= = op= ++ -- * & [] () casts.
 *   Calls      : up to 4 arguments / parameters (passed in $a0-$a3), result in $v0.
 *   Builtins   : bios_a(n, ...), bios_b(n, ...), bios_c(n, ...) call BIOS function n
 *                through the A0h / B0h / C0h vectors (up to 3 further arguments).
 *                e.g. bios_a(0x3F, "x=%d\n", x)  ->  printf
 *   Macros     : AST macros, defined at top level and expanded in place by the parser
 *                (a macro must be defined before it is used). Arguments are expressions;
 *                they are substituted by name, so an argument is re-evaluated wherever its
 *                parameter is used. Variables declared in a macro body are hygienic.
 *                    macro hello(s) { bios_a(0x3F, "hi\n"); }      statement macro: hello();
 *                    macro repeat(f, n) { for (int i = 0; i < n; i++) { f; } }
 *                                                                  repeat(x++; 10);  (',' also works)
 *                    macro sq(x) = x * x;                          expression macro with parameters
 *                    macro log(f, a = 0) = bios_a(0x3F, f, a);     default parameter values: log("hi\n");
 *                    macro N = 16;  macro N2 = N * 2;              constants (any expression)
 *                    macro Region = (0x80050000, 2048);            list macro: Region[0], Region.length,
 *                                                                  and f(Region) passes both elements
 *   Entry      : main(), started from a small stub that sets $sp.
 *
 * Code generation notes
 * ---------------------
 *   - Scalar locals live in $s0-$s7 (callee-saved) unless their address is taken,
 *     in which case (or when registers run out) they live in the stack frame.
 *   - Expression temporaries use $t0-$t9 as a register stack. Live temporaries
 *     are saved around calls.
 *   - Every branch / jump is followed by a nop, every load by a nop (R3000 delay slots).
 */
module compiler;

import std.file: readText, exists;
import std.format: format;
import std.path: absolutePath, buildNormalizedPath, buildPath, dirName, isAbsolute;
import std.string: join;

import types;
import lexer;
import ast;
import parser;
import codegen;
import ir;
import error;

struct ModuleImport
{
    string path;
    Token token;
}

private ModuleImport[] findModuleImports(Token[] toks)
{
    ModuleImport[] imports;
    int braceDepth = 0;

    for (size_t i = 0; i < toks.length && toks[i].kind != TK.Eof; ++i)
    {
        Token t = toks[i];
        if (t.kind == TK.Ident && t.text == "import")
        {
            if (braceDepth != 0)
                throw err(t.file, t.line, "import declarations are only allowed at file scope");
            if (i + 2 >= toks.length || toks[i + 1].kind != TK.Str ||
                toks[i + 2].kind != TK.Sym || toks[i + 2].text != ";")
                throw err(t.file, t.line, "expected import \"file\";");
            if (toks[i + 1].text.length == 0)
                throw err(t.file, t.line, "import path cannot be empty");
            imports ~= ModuleImport(toks[i + 1].text, t);
            i += 2;
            continue;
        }

        if (t.kind == TK.Sym && t.text == "{")
            braceDepth++;
        else if (t.kind == TK.Sym && t.text == "}")
            braceDepth--;
    }

    return imports;
}

private string resolveModulePath(string name, string importer, string[] includeDirs, Token use)
{
    string full = isAbsolute(name)
        ? name
        : (importer.length ? buildPath(dirName(importer), name) : name);
    if (!exists(full) && !isAbsolute(name))
    {
        foreach (dir; includeDirs)
        {
            full = buildPath(dir, name);
            if (exists(full))
                break;
        }
    }

    if (!exists(full))
        throw err(use.file, use.line, format("can't find imported module \"%s\"", name));

    return buildNormalizedPath(absolutePath(full));
}

/// Compiles source text to Assembly object.
Assembly compile(
    string source,
    string filename,
    string[] includeDirs = [],
    string[] dataDirs = [])
{
    structDefs = null;

    auto p = new Program();
    bool[string] loading;
    bool[string] loaded;
    string[] importStack;

    void loadModule(string moduleSource, string modulePath, Token useSite)
    {
        string normalizedPath = buildNormalizedPath(absolutePath(modulePath));
        if (normalizedPath in loaded)
            return;
        if (normalizedPath in loading)
        {
            bool inCycle = false;
            string[] cycle;
            foreach (path; importStack)
            {
                if (path == normalizedPath)
                    inCycle = true;
                if (inCycle)
                    cycle ~= path;
            }
            cycle ~= normalizedPath;
            throw err(useSite.file, useSite.line, "circular module import: " ~ cycle.join(" -> "));
        }

        loading[normalizedPath] = true;
        importStack ~= normalizedPath;
        scope(exit)
        {
            importStack = importStack[0 .. $ - 1];
            loading.remove(normalizedPath);
        }

        Token[] toks = lex(moduleSource, modulePath, includeDirs);
        foreach (moduleImport; findModuleImports(toks))
        {
            string importedPath = resolveModulePath(
                moduleImport.path,
                normalizedPath,
                includeDirs,
                moduleImport.token
            );

            string importedSource;
            try
                importedSource = readText(importedPath);
            catch (Exception e)
                throw err(moduleImport.token.file, moduleImport.token.line,
                    format("error reading imported module \"%s\": %s", importedPath, e.msg));

            loadModule(importedSource, importedPath, moduleImport.token);
        }

        (new Parser(toks, p)).parseProgram();
        loaded[normalizedPath] = true;
    }

    loadModule(source, filename, Token.init);
    return (new CodeGen(filename, dataDirs, includeDirs)).generate(p);
}
