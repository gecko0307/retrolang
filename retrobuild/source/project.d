private immutable string[string] scaffoldFiles = [
    "src/main.r": `void main()
{
    bios_a(0x3f, "Hello, world!\n");
}
`,
    "iso/SYSTEM.CNF": "BOOT = cdrom:\\PSX.EXE;1\n",
    "iso.xml": `<?xml version="1.0" encoding="UTF-8"?>
<iso_project image_name="game.bin" cue_sheet="game.cue">
  <track type="data" xa_edc="true" new_type="false">
    <identifiers system="PLAYSTATION" application="PLAYSTATION" volume="GAME"/>
    <directory_tree>
      <file name="SYSTEM.CNF" type="data" source="iso/SYSTEM.CNF" order="0"/>
      <file name="PSX.EXE" type="data" source="iso/PSX.EXE" order="1"/>
    </directory_tree>
  </track>
</iso_project>
`,
    "retrobuild.toml": `# Entry point passed to rlc
source = "src/main.r"

# Compiler output, also the file mkpsxiso packs (must match iso.xml)
executable = "iso/PSX.EXE"

# mkpsxiso project description and output CUE sheet
iso_xml = "iso.xml"
cue = "game.cue"

# Extra arguments forwarded to rlc
rlc_args = []

[tools]
# rlc = "C:/retrolang/rlc/rlc.exe"
# mkpsxiso = "C:/retrolang/mkpsxiso/mkpsxiso.exe"
`,
    ".gitignore": `/iso/PSX.EXE
/game.bin
/game.cue
/game.cu2
`
];

/// Creates a starter project. With force, only scaffold files are replaced;
/// unrelated files in the destination are preserved.
void createProject(string name, bool force)
{
    if (name.length == 0)
        throw new RetrobuildException("Project name cannot be empty", ExitCode.usage);

    auto target = buildNormalizedPath(absolutePath(name));
    if (exists(target) && !isDir(target))
        throw new RetrobuildException("Project path is not a directory: " ~ name);

    bool nonEmpty;
    if (exists(target))
        foreach (entry; dirEntries(target, SpanMode.shallow))
        {
            nonEmpty = true;
            break;
        }
    if (nonEmpty && !force)
        throw new RetrobuildException(
            "Project directory is not empty: " ~ name ~ " (use --force to replace scaffold files)");

    try
    {
        mkdirRecurse(target);
        foreach (path, contents; scaffoldFiles)
        {
            auto output = buildPath(target, path);
            if (exists(output) && !force)
                throw new RetrobuildException("File already exists: " ~ output
                    ~ " (use --force to replace scaffold files)");
            mkdirRecurse(dirName(output));
            write(output, contents);
        }
    }
    catch (FileException e)
        throw new RetrobuildException("Could not create project in \"" ~ name ~ "\": " ~ e.msg);

    info("Created project " ~ name);
}

private string display(ref const Manifest m, string path)
{
    return relativePath(path, m.baseDir);
}

private bool insideProject(ref const Manifest m, string path)
{
    auto root = buildNormalizedPath(absolutePath(m.baseDir));
    auto candidate = buildNormalizedPath(absolutePath(path));
    if (!root.endsWith(dirSeparator))
        root ~= dirSeparator;

    version (Windows)
    {
        root = root.toLower();
        candidate = candidate.toLower();
    }
    return candidate.startsWith(root);
}

private void removeOutput(ref const Manifest m, string path, ref bool[string] removed)
{
    if (path in removed)
        return;
    removed[path] = true;

    if (!exists(path))
        return;
    if (!isFile(path))
    {
        warning("Not removing non-file output: " ~ display(m, path));
        return;
    }

    try
        remove(path);
    catch (FileException e)
        throw new RetrobuildException("Could not remove " ~ display(m, path) ~ ": " ~ e.msg);
    info("Removed " ~ display(m, path));
}

/// Removes configured build outputs and the CUE-referenced BIN when it is
/// contained within the project directory. Directories are never recursed.
void cleanProject(Manifest m)
{
    bool[string] removed;
    if (exists(m.cue))
    {
        try
        {
            auto binary = binaryFileName(readText(m.cue).splitLines());
            auto binaryPath = buildNormalizedPath(absolutePath(buildPath(dirName(m.cue), binary)));
            if (insideProject(m, binaryPath))
                removeOutput(m, binaryPath, removed);
            else
                warning("Not removing CUE-referenced BIN outside project directory: " ~ binaryPath);
        }
        catch (Cu2Exception e)
            warning("Could not identify BIN referenced by " ~ display(m, m.cue) ~ ": " ~ e.msg);
        catch (FileException e)
            warning("Could not read " ~ display(m, m.cue) ~ " to identify its BIN: " ~ e.msg);
    }

    removeOutput(m, m.executable, removed);
    removeOutput(m, m.cue, removed);
    removeOutput(m, m.cu2, removed);
}

/// Reports tool availability without treating missing optional tools as an error.
void doctorProject(Manifest m)
{
    reportTool(rlcTool, m);
    reportTool(mkpsxisoTool, m);
}

private void reportTool(in ToolInfo tool, ref const Manifest m)
{
    auto location = optionalTool(tool, m.toolPaths);
    if (location.found)
        writeln("[OK] ", tool.name, ": ", location.path, " (", location.origin, ")");
    else
    {
        writeln("[MISSING] ", tool.name, ": not found; searched:");
        foreach (path; toolSearchLocations(tool, m.toolPaths))
            writeln("  ", path);
    }
}
