module expression;

import std.format: format;

/**
 * Expression nodes used by LNK2 relocation (patch) records.
 * An expression is stored in prefix form: a tag byte, then either
 * a u32 constant, a u16 id, or two nested expressions (binary operators).
 */
enum ExprOp: ubyte
{
    CONSTANT       = 0x00, // u32 value
    SYMBOL         = 0x02, // u16 symbol index (address of symbol)
    SECTION_BASE   = 0x04, // u16 section index (base address of section)
    BANK           = 0x06,
    SECTION_OFFSET = 0x08,
    OFFSET         = 0x0A,
    SECTION_START  = 0x0C, // u16 section index
    GROUP_START    = 0x0E,
    GROUP_OFFSET   = 0x10,
    SEGMENT        = 0x12,
    GROUP_ORG      = 0x14,
    SECTION_END    = 0x16, // u16 section index

    EQUALS         = 0x20,
    NOT_EQUALS     = 0x22,
    LTE            = 0x24,
    LESS_THAN      = 0x26,
    GTE            = 0x28,
    GREATER_THAN   = 0x2A,
    ADD            = 0x2C,
    SUB            = 0x2E,
    MUL            = 0x30,
    DIV            = 0x32,
    AND            = 0x34,
    OR             = 0x36,
    XOR            = 0x38,
    SHL            = 0x3A,
    SHR            = 0x3C,
    MOD            = 0x3E,
    DASHES         = 0x40,
    REVWORD        = 0x42,
    CHECK0         = 0x44,
    CHECK1         = 0x46,
    BITRANGE       = 0x48,
    ARSHIFT_CHK    = 0x4A
}

bool isIdOp(ubyte op)
{
    return op >= 0x02 && op <= 0x16 && (op & 1) == 0;
}

bool isBinaryOp(ubyte op)
{
    return op >= 0x20 && op <= 0x4A && (op & 1) == 0;
}

string opSymbol(ubyte op)
{
    switch (op)
    {
        case ExprOp.EQUALS:       return "=";
        case ExprOp.NOT_EQUALS:   return "<>";
        case ExprOp.LTE:          return "<=";
        case ExprOp.LESS_THAN:    return "<";
        case ExprOp.GTE:          return ">=";
        case ExprOp.GREATER_THAN: return ">";
        case ExprOp.ADD:          return "+";
        case ExprOp.SUB:          return "-";
        case ExprOp.MUL:          return "*";
        case ExprOp.DIV:          return "/";
        case ExprOp.AND:          return "&";
        case ExprOp.OR:           return "!";
        case ExprOp.XOR:          return "^";
        case ExprOp.SHL:          return "<<";
        case ExprOp.SHR:          return ">>";
        case ExprOp.MOD:          return "%";
        case ExprOp.DASHES:       return "---";
        case ExprOp.REVWORD:      return "-revword-";
        case ExprOp.CHECK0:       return "-check0-";
        case ExprOp.CHECK1:       return "-check1-";
        case ExprOp.BITRANGE:     return "-bitrange-";
        case ExprOp.ARSHIFT_CHK:  return "-arshift_chk-";
        default:                  return "?";
    }
}

class Expression
{
    ubyte op;
    uint value; // constant value or symbol/section/group id
    Expression left;
    Expression right;

    this(ubyte op)
    {
        this.op = op;
    }

    /// leafName (optional) maps (op, id) of an id-leaf to a readable name,
    /// or returns an empty string if it doesn't know one.
    string describe(string delegate(ubyte, uint) leafName = null)
    {
        if (op == ExprOp.CONSTANT)
            return format("0x%x", value);

        if (isIdOp(op))
        {
            if (leafName !is null)
            {
                string s = leafName(op, value);
                if (s.length > 0)
                    return s;
            }
            return format("%s(%d)", cast(ExprOp)op, value);
        }

        if (left is null || right is null)
            return "?";

        return format("(%s %s %s)", left.describe(leafName), opSymbol(op),
                      right.describe(leafName));
    }
}

/**
 * Tries to reduce an expression to the form
 *     [symbol | section base] + constant
 * which covers practically every relocation emitted by the PsyQ toolchain.
 * Returns false for anything more complex.
 */
bool resolveSimple(Expression e, out int symbolIndex, out int sectionIndex, out long addend)
{
    int sym = -1;
    int sec = -1;
    long add = 0;

    bool walk(Expression n, int sign)
    {
        if (n is null)
            return false;

        switch (n.op)
        {
            case ExprOp.CONSTANT:
                add += sign * cast(long)cast(int)n.value;
                return true;

            case ExprOp.SYMBOL:
                if (sign != 1 || sym >= 0 || sec >= 0)
                    return false;
                sym = cast(int)n.value;
                return true;

            case ExprOp.SECTION_BASE:
            case ExprOp.SECTION_START:
                if (sign != 1 || sym >= 0 || sec >= 0)
                    return false;
                sec = cast(int)n.value;
                return true;

            case ExprOp.ADD:
                return walk(n.left, sign) && walk(n.right, sign);

            case ExprOp.SUB:
                return walk(n.left, sign) && walk(n.right, -sign);

            default:
                return false;
        }
    }

    bool ok = walk(e, 1);
    symbolIndex = sym;
    sectionIndex = sec;
    addend = add;
    return ok;
}
