/**
 * MIDI to SEQ converter.
 *
 * Converts a type 0 or type 1 MIDI file to a single-track SEQ file and
 * writes a program map that describes which instruments the song needs.
 * The map is the input of SF2TOVAB, which builds a matching VAB bank.
 */
module main;

import std.algorithm: map, max, min, sort;
import std.array: appender, array;
import std.conv: to;
import std.file: read, write, exists;
import std.getopt: getopt, config;
import std.path: setExtension, baseName;
import std.stdio: stderr, writefln, writeln, File;
import std.string: format, strip, split, toLower, startsWith;
import std.exception: enforce;
import std.uni: isAlpha;

enum int drumBank = 128;
enum int defaultPpqn = 96;

// Event classes, they also define the order of events with equal time
enum: int
{
    prioNoteOff = 0,
    prioMeta = 1,
    prioControl = 2,
    prioNoteOn = 3
}

struct Ev
{
    ulong tick;
    uint index;       // position in the file, keeps sorting stable
    int prio;
    ubyte status;     // channel voice status, 0xFF for meta events
    ubyte d1, d2;
    ubyte metaType;
    ubyte[] data;     // meta event payload
}

struct MidiFile
{
    uint ppqn;
    int format;
    int trackCount;
    ulong endTick;
    Ev[] events;
}

uint be16(const(ubyte)[] d, size_t p) { return (d[p] << 8) | d[p + 1]; }
uint be32(const(ubyte)[] d, size_t p) { return (be16(d, p) << 16) | be16(d, p + 2); }

uint readVlq(const(ubyte)[] d, ref size_t p, size_t end)
{
    uint v = 0;
    foreach (i; 0..4)
    {
        enforce(p < end, "unexpected end of track data");
        ubyte b = d[p++];
        v = (v << 7) | (b & 0x7F);
        if (!(b & 0x80))
            return v;
    }
    throw new Exception("variable-length value is too long");
}

MidiFile parseMidi(const(ubyte)[] d)
{
    enforce(d.length >= 14 && d[0..4] == cast(const(ubyte)[])"MThd", "not a MIDI file (no MThd header)");
    uint headerLen = be32(d, 4);
    enforce(headerLen >= 6 && 8 + headerLen <= d.length, "bad MIDI header");

    MidiFile m;
    m.format = be16(d, 8);
    uint tracks = be16(d, 10);
    uint division = be16(d, 12);
    enforce(!(division & 0x8000), "SMPTE time division is not supported");
    enforce(division > 0, "bad time division");
    enforce(m.format != 2, "MIDI type 2 files (independent sequences) are not supported");
    m.ppqn = division;

    size_t pos = 8 + headerLen;
    uint index = 0;
    while (pos + 8 <= d.length)
    {
        bool isTrack = d[pos..pos + 4] == cast(const(ubyte)[])"MTrk";
        uint len = be32(d, pos + 4);
        size_t start = pos + 8;
        size_t end = min(start + len, d.length);
        pos = start + len;
        if (!isTrack)
            continue;
        m.trackCount++;

        size_t p = start;
        ulong tick = 0;
        ubyte running = 0;
        while (p < end)
        {
            tick += readVlq(d, p, end);
            enforce(p < end, "unexpected end of track data");
            ubyte b = d[p];
            ubyte status;
            if (b < 0x80)
            {
                enforce(running != 0, "data byte without running status");
                status = running;
            }
            else
            {
                status = b;
                p++;
                running = status < 0xF0 ? status : 0;
            }

            if (status < 0xF0)
            {
                ubyte kind = status & 0xF0;
                Ev e;
                e.tick = tick;
                e.index = index++;
                e.status = status;
                enforce(p < end, "unexpected end of track data");
                e.d1 = d[p++];
                if (kind != 0xC0 && kind != 0xD0)
                {
                    enforce(p < end, "unexpected end of track data");
                    e.d2 = d[p++];
                }
                if (kind == 0x80 || (kind == 0x90 && e.d2 == 0))
                    e.prio = prioNoteOff;
                else if (kind == 0x90)
                    e.prio = prioNoteOn;
                else
                    e.prio = prioControl;
                m.events ~= e;
            }
            else if (status == 0xFF)
            {
                enforce(p < end, "unexpected end of track data");
                ubyte type = d[p++];
                uint len2 = readVlq(d, p, end);
                enforce(p + len2 <= end, "meta event is longer than its track");
                Ev e;
                e.tick = tick;
                e.index = index++;
                e.status = 0xFF;
                e.metaType = type;
                e.data = d[p .. p + len2].dup;
                e.prio = prioMeta;
                p += len2;
                m.endTick = max(m.endTick, tick);
                if (type == 0x2F)
                    break;
                m.events ~= e;
            }
            else if (status == 0xF0 || status == 0xF7)
            {
                uint len2 = readVlq(d, p, end);
                p += len2;
            }
            else
            {
                // system common messages
                if (status == 0xF2) p += 2;
                else if (status == 0xF1 || status == 0xF3) p += 1;
            }
        }
        m.endTick = max(m.endTick, tick);
    }
    enforce(m.trackCount > 0, "the file has no tracks");

    m.events.sort!((a, b) => a.tick != b.tick ? a.tick < b.tick
                           : a.prio != b.prio ? a.prio < b.prio
                           : a.index < b.index);
    return m;
}

// --- Program map

struct ProgEntry
{
    int vabProg;
    bool drums;
    int bank;       // melodic: bank select (CC0); drums: kit (GM program on the drum channel)
    int gm;         // melodic: GM program number
    int[] keys;     // drums: keys assigned to this program
    int keyLo = 0;  // melodic: range of keys that the song plays
    int keyHi = 127;
}

struct ProgMap
{
    ProgEntry[] entries;
    int[int] melodic;   // (bank << 8 | gm) -> vab program
    int[int] drums;     // (kit << 8 | key) -> vab program

    void add(ProgEntry e)
    {
        entries ~= e;
        if (e.drums)
            foreach (k; e.keys)
                drums[(e.bank << 8) | k] = e.vabProg;
        else
            melodic[(e.bank << 8) | e.gm] = e.vabProg;
    }

    // -1 if the instrument is not in the map
    int lookupMelodic(int bank, int gm)
    {
        if (auto p = ((bank << 8) | gm) in melodic) return *p;
        if (auto p = (gm) in melodic) return *p;    // fall back to bank 0
        return -1;
    }

    int lookupDrum(int kit, int key)
    {
        if (auto p = ((kit << 8) | key) in drums) return *p;
        if (auto p = (key) in drums) return *p;     // fall back to kit 0
        return -1;
    }
}

ProgMap readMap(string path)
{
    ProgMap map;
    foreach (lineNo, raw; File(path).byLine.map!(l => l.idup).array)
    {
        string line = raw;
        auto hash = line.indexOfHash;
        if (hash >= 0) line = line[0..hash];
        auto parts = line.strip.split;
        if (parts.length == 0)
            continue;
        enforce(parts.length >= 3, format("%s(%d): bad map line", path, lineNo + 1));
        ProgEntry e;
        e.vabProg = parts[0].to!int;
        enforce(e.vabProg >= 0 && e.vabProg < 128, format("%s(%d): program out of range", path, lineNo + 1));
        if (parts[1] == "melodic")
        {
            enforce(parts.length == 4 || parts.length == 6,
                format("%s(%d): expected: <program> melodic <bank> <gm program> [<key lo> <key hi>]", path, lineNo + 1));
            e.bank = parts[2].to!int;
            e.gm = parts[3].to!int;
            if (parts.length == 6)
            {
                e.keyLo = parts[4].to!int;
                e.keyHi = parts[5].to!int;
            }
        }
        else if (parts[1] == "drums")
        {
            e.drums = true;
            e.bank = parts[2].to!int;
            foreach (k; parts[3..$])
                e.keys ~= k.to!int;
        }
        else
            throw new Exception(format("%s(%d): unknown program kind '%s'", path, lineNo + 1, parts[1]));
        map.add(e);
    }
    return map;
}

ptrdiff_t indexOfHash(string s)
{
    foreach (i, c; s)
        if (c == '#')
            return i;
    return -1;
}

void writeMap(string path, ProgMap pm, string song)
{
    auto f = File(path, "w");
    f.writefln("# Program map generated by mid2seq for %s", song);
    f.writeln("# <program> melodic <bank> <GM program> <lowest key> <highest key>");
    f.writeln("# <program> drums <kit> <keys...>");
    foreach (e; pm.entries)
    {
        if (e.drums)
        {
            f.writef("%d drums %d", e.vabProg, e.bank);
            foreach (k; e.keys)
                f.writef(" %d", k);
            f.writeln();
        }
        else
            f.writefln("%d melodic %d %d %d %d", e.vabProg, e.bank, e.gm, e.keyLo, e.keyHi);
    }
}

// --- Conversion

struct OutEv
{
    ulong tick;
    ubyte[] bytes;
    bool meta;
}

struct Options
{
    string input, output, mapOut, mapIn;
    bool loop;
    int drumChannel = 10;
    uint ppqn;
    int tones = 16;
}

string normalizeText(const(ubyte)[] data)
{
    string s;
    foreach (b; data)
        if (isAlpha(cast(dchar)b))
            s ~= cast(char)b;
    return s.toLower;
}

void vlq(ref ubyte[] b, ulong v)
{
    ubyte[5] tmp;
    int n = 0;
    tmp[n++] = cast(ubyte)(v & 0x7F);
    v >>= 7;
    while (v)
    {
        tmp[n++] = cast(ubyte)((v & 0x7F) | 0x80);
        v >>= 7;
    }
    while (n > 0)
        b ~= tmp[--n];
}

int main(string[] args)
{
    Options opt;
    bool help;
    try
    {
        getopt(args, config.caseSensitive,
            "output|o", &opt.output,
            "map-out", &opt.mapOut,
            "map-in", &opt.mapIn,
            "loop", &opt.loop,
            "drum-channel", &opt.drumChannel,
            "ppqn", &opt.ppqn,
            "tones", &opt.tones,
            "help|h", &help);
    }
    catch (Exception e)
    {
        stderr.writeln("Error: ", e.msg);
        return 1;
    }

    if (help || args.length != 2)
    {
        writeln("Convert a Standard MIDI File to a PlayStation SEQ file.");
        writeln("Usage: mid2seq [options] input.mid");
        writeln("  -o, --output <file>     output SEQ file (default: input name with .seq)");
        writeln("      --map-out <file>    write the program map for sf2tovab (default: output name with .map)");
        writeln("      --map-in <file>     use an existing program map (e.g. of a ready sound bank)");
        writeln("                          instead of generating one; notes without an instrument are dropped");
        writeln("      --loop              loop the whole song if it has no loop markers");
        writeln("      --drum-channel <n>  MIDI channel (1..16) that carries drums, 0 for none (default 10)");
        writeln("      --ppqn <n>          rescale the time resolution (ticks per quarter note)");
        writeln("      --tones <n>         maximum drum keys per program, 1..16 (default 16)");
        writeln("  -h, --help              show this help");
        writeln();
        writeln("Loop markers: MIDI markers named loopStart / loopEnd, or controller 111 (loop start).");
        return help ? 0 : 1;
    }

    opt.input = args[1];
    if (opt.output.length == 0) opt.output = setExtension(opt.input, ".seq");
    if (opt.mapOut.length == 0) opt.mapOut = setExtension(opt.output, ".map");
    if (opt.tones < 1 || opt.tones > 16)
    {
        stderr.writeln("Error: --tones must be between 1 and 16");
        return 1;
    }
    if (opt.drumChannel < 0 || opt.drumChannel > 16)
    {
        stderr.writeln("Error: --drum-channel must be between 0 and 16");
        return 1;
    }

    try
        return convert(opt);
    catch (Exception e)
    {
        stderr.writeln("Error: ", e.msg);
        return 1;
    }
}

int convert(Options opt)
{
    auto midi = parseMidi(cast(const(ubyte)[])read(opt.input));
    int drumCh = opt.drumChannel - 1; // -1: none

    // Pass 1: find out which instruments the song uses
    int[16] bank, gm;
    bool[16] used;
    int[2][] melodicUse;       // (bank, gm) in order of first use
    int[2][int] melodicKeys;   // (bank << 8 | gm) -> lowest and highest key
    bool[int] melodicSeen;
    bool[int][int] kitKeys;    // kit -> set of keys
    int[] kitOrder;

    foreach (e; midi.events)
    {
        if (e.status == 0xFF)
            continue;
        int ch = e.status & 0x0F;
        int kind = e.status & 0xF0;
        if (kind == 0xB0 && e.d1 == 0)
            bank[ch] = e.d2;
        else if (kind == 0xC0)
            gm[ch] = e.d1;
        else if (kind == 0x90 && e.d2 > 0)
        {
            used[ch] = true;
            if (ch == drumCh)
            {
                int kit = gm[ch];
                if (kit !in kitKeys)
                {
                    kitKeys[kit] = null;
                    kitOrder ~= kit;
                }
                kitKeys[kit][e.d1] = true;
            }
            else
            {
                int key = (bank[ch] << 8) | gm[ch];
                if (key !in melodicSeen)
                {
                    melodicSeen[key] = true;
                    melodicUse ~= [bank[ch], gm[ch]];
                    melodicKeys[key] = [e.d1, e.d1];
                }
                else
                {
                    melodicKeys[key][0] = min(melodicKeys[key][0], cast(int)e.d1);
                    melodicKeys[key][1] = max(melodicKeys[key][1], cast(int)e.d1);
                }
            }
        }
    }

    ProgMap pm;
    if (opt.mapIn.length)
    {
        pm = readMap(opt.mapIn);
    }
    else
    {
        int next = 0;
        foreach (u; melodicUse)
        {
            enforce(next < 128, "the song needs more than 128 programs");
            ProgEntry e;
            e.vabProg = next++;
            e.bank = u[0];
            e.gm = u[1];
            auto range = melodicKeys[(u[0] << 8) | u[1]];
            e.keyLo = range[0];
            e.keyHi = range[1];
            pm.add(e);
        }
        foreach (kit; kitOrder)
        {
            int[] keys = kitKeys[kit].keys.dup;
            keys.sort();
            for (size_t i = 0; i < keys.length; i += opt.tones)
            {
                enforce(next < 128, "the song needs more than 128 programs");
                ProgEntry e;
                e.vabProg = next++;
                e.drums = true;
                e.bank = kit;
                e.keys = keys[i .. min(i + opt.tones, keys.length)];
                pm.add(e);
            }
        }
    }

    // Loop points
    bool haveLoopStart, haveLoopEnd;
    ulong loopStartTick, loopEndTick;
    foreach (e; midi.events)
    {
        bool isStart, isEnd;
        if (e.status == 0xFF && e.metaType >= 1 && e.metaType <= 7)
        {
            string t = normalizeText(e.data);
            isStart = t == "loopstart";
            isEnd = t == "loopend";
        }
        else if (e.status != 0xFF && (e.status & 0xF0) == 0xB0 && e.d1 == 111)
            isStart = true;
        if (isStart && !haveLoopStart)
        {
            haveLoopStart = true;
            loopStartTick = e.tick;
        }
        if (isEnd && haveLoopStart && !haveLoopEnd && e.tick > loopStartTick)
        {
            haveLoopEnd = true;
            loopEndTick = e.tick;
        }
    }
    bool looping = haveLoopStart;
    if (!looping && opt.loop)
    {
        looping = true;
        haveLoopStart = true;
        loopStartTick = 0;
    }
    if (looping && !haveLoopEnd)
    {
        haveLoopEnd = true;
        loopEndTick = midi.endTick;
    }

    // Pass 2: emit
    uint srcPpqn = midi.ppqn;
    uint outPpqn = opt.ppqn ? opt.ppqn : srcPpqn;
    enforce(outPpqn > 0 && outPpqn < 0x8000, "the resolution must be 1..32767");
    ulong scale(ulong t) { return outPpqn == srcPpqn ? t : (t * outPpqn + srcPpqn / 2) / srcPpqn; }

    OutEv[] outEvs;
    int[16] curBank, curGm;
    int[16] emittedProg = -1;
    int[16] vol = 127, expr = 127, pan = 64, bend = 0x2000, pedal = 0;
    int[128][16] active; // notes sounding per channel and key, for matching note-offs
    uint curTempo = 500000;
    bool haveTempo;
    int tsNum = 4, tsDen = 2;
    int[string] dropped;
    bool loopStartDone, loopEndDone;
    bool rpnWarned;

    void emitChan(ulong tick, ubyte[] bytes) { outEvs ~= OutEv(scale(tick), bytes, false); }
    void emitTempo(ulong tick, uint us)
        { outEvs ~= OutEv(scale(tick), [cast(ubyte)0xFF, 0x51, cast(ubyte)(us >> 16), cast(ubyte)(us >> 8), cast(ubyte)us], true); }

    void startLoop(ulong tick)
    {
        loopStartDone = true;
        emitChan(tick, [cast(ubyte)0xB0, 99, 20]);
        emitChan(tick, [cast(ubyte)0xB0, 6, 127]);
        // State is restored on every pass of the loop
        emittedProg[] = -1;
        emitTempo(tick, curTempo);
        foreach (ch; 0 .. 16)
        {
            if (!used[ch])
                continue;
            emitChan(tick, [cast(ubyte)(0xB0 | ch), 7, cast(ubyte)vol[ch]]);
            emitChan(tick, [cast(ubyte)(0xB0 | ch), 10, cast(ubyte)pan[ch]]);
            emitChan(tick, [cast(ubyte)(0xB0 | ch), 11, cast(ubyte)expr[ch]]);
            emitChan(tick, [cast(ubyte)(0xB0 | ch), 64, cast(ubyte)(pedal[ch] ? 127 : 0)]);
            emitChan(tick, [cast(ubyte)(0xE0 | ch), cast(ubyte)(bend[ch] & 0x7F), cast(ubyte)(bend[ch] >> 7)]);
        }
    }

    void endLoop(ulong tick)
    {
        loopEndDone = true;
        emitChan(tick, [cast(ubyte)0xB0, 99, 30]);
    }

    bool startedAtZero;
    foreach (e; midi.events)
    {
        if (looping && !loopStartDone && haveLoopStart && e.tick >= loopStartTick && loopStartTick == 0 && !startedAtZero)
        {
            // loop starts at the very beginning: put the marker before everything
            startedAtZero = true;
            startLoop(0);
        }
        // Note-offs at the loop end belong to the loop body, everything else at that time follows the loop
        if (looping && !loopEndDone && loopStartDone && loopEndTick < midi.endTick
            && (e.tick > loopEndTick || (e.tick == loopEndTick && e.prio != prioNoteOff)))
            endLoop(loopEndTick);

        if (e.status == 0xFF)
        {
            if (e.metaType == 0x51 && e.data.length == 3)
            {
                curTempo = (e.data[0] << 16) | (e.data[1] << 8) | e.data[2];
                if (curTempo == 0) curTempo = 500000;
                if (!haveTempo && e.tick == 0)
                    haveTempo = true;
                emitTempo(e.tick, curTempo);
            }
            else if (e.metaType == 0x58 && e.data.length >= 2 && e.tick == 0)
            {
                tsNum = e.data[0];
                tsDen = e.data[1];
            }
            else if (e.metaType >= 1 && e.metaType <= 7 && !loopStartDone && haveLoopStart
                     && e.tick == loopStartTick && normalizeText(e.data) == "loopstart")
            {
                startLoop(e.tick);
            }
            continue;
        }

        int ch = e.status & 0x0F;
        int kind = e.status & 0xF0;
        switch (kind)
        {
            case 0x90:
            case 0x80:
            {
                bool on = kind == 0x90 && e.d2 > 0;
                int key = e.d1 & 0x7F;
                if (on)
                {
                    int prog = ch == drumCh ? pm.lookupDrum(curGm[ch], key)
                                            : pm.lookupMelodic(curBank[ch], curGm[ch]);
                    if (prog < 0)
                    {
                        dropped["notes without an instrument"]++;
                        break;
                    }
                    if (emittedProg[ch] != prog)
                    {
                        emitChan(e.tick, [cast(ubyte)(0xC0 | ch), cast(ubyte)prog]);
                        emittedProg[ch] = prog;
                    }
                    emitChan(e.tick, [cast(ubyte)(0x90 | ch), cast(ubyte)key, e.d2]);
                    active[ch][key]++;
                }
                else if (active[ch][key] > 0)
                {
                    active[ch][key]--;
                    emitChan(e.tick, [cast(ubyte)(0x90 | ch), cast(ubyte)key, 0]);
                }
                break;
            }
            case 0xC0:
                curGm[ch] = e.d1;
                break;
            case 0xE0:
                bend[ch] = e.d1 | (e.d2 << 7);
                emitChan(e.tick, [cast(ubyte)(0xE0 | ch), e.d1, e.d2]);
                break;
            case 0xB0:
                switch (e.d1)
                {
                    case 0:
                        curBank[ch] = e.d2;
                        break;
                    case 7:
                        vol[ch] = e.d2;
                        emitChan(e.tick, [cast(ubyte)(0xB0 | ch), 7, e.d2]);
                        break;
                    case 10:
                        pan[ch] = e.d2;
                        emitChan(e.tick, [cast(ubyte)(0xB0 | ch), 10, e.d2]);
                        break;
                    case 11:
                        expr[ch] = e.d2;
                        emitChan(e.tick, [cast(ubyte)(0xB0 | ch), 11, e.d2]);
                        break;
                    case 64:
                        pedal[ch] = e.d2 >= 64;
                        emitChan(e.tick, [cast(ubyte)(0xB0 | ch), 64, e.d2]);
                        break;
                    case 120:
                    case 123:
                        active[ch][] = 0;
                        emitChan(e.tick, [cast(ubyte)(0xB0 | ch), 123, 0]);
                        break;
                    case 111:
                        if (!loopStartDone && haveLoopStart && e.tick == loopStartTick)
                            startLoop(e.tick);
                        break;
                    case 101:
                    case 100:
                    case 6:
                    case 38:
                        if (!rpnWarned && (e.d1 == 101 || e.d1 == 100))
                        {
                            rpnWarned = true;
                            dropped["RPN / pitch bend range changes (bend range is fixed per tone)"]++;
                        }
                        break;
                    default:
                        dropped[format("controller %d", e.d1)]++;
                        break;
                }
                break;
            default:
                dropped["aftertouch"]++;
                break;
        }
    }

    ulong endTick = midi.endTick;
    if (looping && !loopEndDone)
        endLoop(loopEndTick);
    // the end of the track must not be before the last event
    if (outEvs.length)
        endTick = max(scale(endTick), outEvs[$ - 1].tick);
    else
        endTick = scale(endTick);

    // Serialize
    ubyte[] body;
    ulong last = 0;
    int status = -1;
    foreach (e; outEvs)
    {
        vlq(body, e.tick - last);
        last = e.tick;
        if (e.meta)
        {
            body ~= e.bytes;
            status = -1; // a data byte after a meta event would be read as a meta type
        }
        else
        {
            if (status == e.bytes[0])
                body ~= e.bytes[1..$];
            else
                body ~= e.bytes;
            status = e.bytes[0];
        }
    }
    vlq(body, endTick - last);
    body ~= [0xFF, 0x2F, 0x00];

    uint headTempo = 500000;
    foreach (e; outEvs)
        if (e.meta && e.tick == 0)
        {
            headTempo = (e.bytes[2] << 16) | (e.bytes[3] << 8) | e.bytes[4];
            break;
        }

    ubyte[] file;
    file ~= cast(ubyte[])"pQES";
    file ~= [0, 0, 0, 1];
    file ~= [cast(ubyte)(outPpqn >> 8), cast(ubyte)outPpqn];
    file ~= [cast(ubyte)(headTempo >> 16), cast(ubyte)(headTempo >> 8), cast(ubyte)headTempo];
    file ~= [cast(ubyte)tsNum, cast(ubyte)tsDen];
    file ~= body;
    write(opt.output, file);

    if (opt.mapIn.length == 0)
        writeMap(opt.mapOut, pm, baseName(opt.input));

    // Report
    ulong notes;
    foreach (e; outEvs)
        if (!e.meta && (e.bytes[0] & 0xF0) == 0x90 && e.bytes.length == 3 && e.bytes[2] > 0)
            notes++;
    double seconds = 0;
    {
        // duration, taking tempo changes into account
        ulong prevTick = 0;
        uint tempo = headTempo;
        double us = 0;
        foreach (e; outEvs)
        {
            us += cast(double)(e.tick - prevTick) * tempo / outPpqn;
            prevTick = e.tick;
            if (e.meta)
                tempo = (e.bytes[2] << 16) | (e.bytes[3] << 8) | e.bytes[4];
        }
        us += cast(double)(endTick - prevTick) * tempo / outPpqn;
        seconds = us / 1e6;
    }
    writefln("%s -> %s  (%d tracks, %d ticks/beat, %d notes, %.1f s, %d bytes%s)",
        opt.input, opt.output, midi.trackCount, outPpqn, notes, seconds, file.length,
        looping ? ", looped" : "");
    foreach (e; pm.entries)
    {
        if (e.drums)
            writefln("  program %3d: drum kit %d, keys %s", e.vabProg, e.bank, e.keys);
        else
            writefln("  program %3d: GM %d%s, keys %d..%d", e.vabProg, e.gm, e.bank ? format(" (bank %d)", e.bank) : "", e.keyLo, e.keyHi);
    }
    foreach (k, v; dropped)
        writefln("  dropped: %s (%d)", k, v);
    if (opt.mapIn.length == 0)
        writefln("  program map: %s", opt.mapOut);
    return 0;
}
